    ['Small lawn equipment', 'Strong fit', 'Confirm the building and double-door dimensions fit your equipment.'],
    ['Residential exterior', 'Strong fit', 'Vinyl or LP SmartSide lap siding coordinates with a house or garage.'],
    ['Substantial loft storage', 'Compare models', 'The low 3/12 roof is meant for a streamlined profile, not upper storage.'],
    ['Large equipment access', 'Compare models', 'Large equipment may call for a larger model and a different door.'],
    ['Finished office or studio', 'Plan carefully', 'Consider interior height, electrical, insulation and windows before choosing a model.'],
