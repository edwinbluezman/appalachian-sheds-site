erit;font-style:italic;font-size:1rem;border:1px solid #bbb8ad;border-radius:3px;background:#fff;padding:14px}.quote{background:#eff1eb;border-left:5px solid #a68149;margin-top:24px;padding:22px}.price{font-size:clamp(2rem,4vw,3.5rem);font-weight:800;font-style:normal;line-height:1.2}.footnote{font-size:.78rem;color:#5c615e}.chipgroup{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}.size-chip{background:#f1eee7;border:1px solid #c8c6bf;font:600 italic .88rem Montserrat,Arial;padding:8px 14px;border-radius:30px;cursor:pointer}.size-chip:hover{background:#e7dfd0}.table-wrap{overflow:auto;border:1px solid #dedad3;border-radius:4px}table{width:100%;border-collapse:collapse;font-size:.81rem;min-width:900px;font-style:normal}thead th{background:#252d2d;color:white;padding:15px 12px;text-align:right;white-space:nowrap}thead th:first-child{text-align:left}thead th:nth-child(2){background:#44594f}thead th:nth-child(3){background:#5f7062}thead th:nth-child(4){background:#77715e}thead th:nth-child(5){background:#746b5b}thead th:nth-child(6){background:#675846}tbody tr:nth-child(odd){background:#fff}tbody tr:nth-child(even){background:#eeeae3}tbody th,tbody td{border-bottom:1px solid #e1ded7;padding:12px;text-align:right;white-space:nowrap}tbody th{text-align:left;font-weight:800}tbody td:nth-child(2){font-weight:800}details{margin-top:30px}summary{font-weight:800;cursor:pointer;padding:16px;background:#dedad2}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:25px}.feature{padding:24px;border:1px solid #d6d2ca;background:#fff}.feature strong{display:block;margin-bottom:8px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.step{border-top:3px solid #ceb180;padding-top:17px}.photo-block{width:min(100%,1000px);margin:auto}.photo-block img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover}.faq details{border-bottom:1px solid #bab9b3;margin:0}.faq summary{background:none;padding:18px 0}.faq p{margin:0 0 18px}.fine{font-size:.8rem}footer{background:#202525;color:#dedfda;padding:35px 0}@media(max-width:800px){.hero-layout{grid-template-columns:1fr}.controls,.features,.steps{grid-template-columns:1fr}.section{padding:52px 0}}

/* Appalachian Barn price controls: one independent, high-contrast system */
.barn-price-section{background:#F8F7F4;color:#25302d}
.barn-featured-wrap{margin:26px 0 20px}.barn-featured-label{font-weight:800;margin-bottom:9px}
.barn-featured-list{display:flex;flex-wrap:wrap;gap:9px}
.barn-featured{font:700 italic .92rem Montserrat,Arial,sans-serif;border:1px solid #b4b6ac;border-radius:24px;background:#fff;color:#26332f;padding:9px 15px;cursor:pointer}
.barn-featured:hover,.barn-featured[aria-pressed="true"]{background:#294c40;border-color:#294c40;color:#fff}
.barn-calc-grid{display:grid;grid-template-columns:1.12fr 1fr;gap:22px;align-items:stretch}
.barn-calc-controls{background:#fff;border:1px solid #d9d9d3;border-radius:5px;padding:28px;color:#25302d}
.barn-calc-controls label{display:block;color:#27312e;font-weight:800;font-size:.93rem;margin:0 0 8px}
.barn-calc-controls select{display:block;width:100%;background:#fff!important;color:#2B3030!important;-webkit-text-fill-color:#2B3030!important;border:1px solid #a0a8a2;border-radius:4px;padding:13px 16px;margin:0 0 24px;font:500 italic 1rem Montserrat,Arial,sans-serif;opacity:1!important}
.barn-calc-controls option{background:#fff!important;color:#2B3030!important}
.barn-calc-controls select:focus-visible,.barn-featured:focus-visible,.barn-result-action:focus-visible,.barn-all-prices summary:focus-visible{outline:3px solid #c29b61;outline-offset:3px}
.barn-notice{background:#f1eee7;border-left:4px solid #bda276;padding:15px;color:#3c4540!important;font-size:.86rem;margin:4px 0 0}
.barn-calc-result{border-radius:5px;background:#29312f;color:#fff;padding:35px;display:flex;flex-direction:column;justify-content:center;min-height:315px}
.barn-result-eyebrow{font-size:.77rem;letter-spacing:.12em;color:#e4e6de!important}
.barn-result-price{font-size:clamp(2.8rem,5vw,4.5rem);font-weight:800;line-height:1.15;color:#fff!important;margin:15px 0}
.barn-result-selection{color:#f0f2ed!important;font-size:.94rem;line-height:1.5;margin:0 0 22px}
.barn-result-action,.barn-calc-result a.barn-result-action{display:inline-block;align-self:flex-start;border-radius:4px;background:#e0ba8b!important;color:#202c27!important;-webkit-text-fill-color:#202c27!important;text-decoration:none;font:800 italic .92rem Montserrat,Arial,sans-serif;padding:14px 20px}
.barn-result-action:hover{background:#f2d2a4!important;color:#17221e!important}
.barn-all-prices{margin-top:32px}.barn-all-prices summary{background:#e4e5df;color:#202b26;font-weight:800;padding:17px;cursor:pointer}
.barn-table-wrap{overflow-x:auto;border:1px solid #d8d9d2}.barn-all-prices table{min-width:880px;width:100%;border-collapse:collapse;font-size:.85rem}
.barn-all-prices thead th{background:#2e3e39;color:white;padding:15px 10px;text-align:right;white-space:normal}
.barn-all-prices thead th:first-child,.barn-all-prices tbody th{text-align:left}
.barn-all-prices tbody tr:nth-child(odd){background:#fff}.barn-all-prices tbody tr:nth-child(even){background:#ebeeea}
.barn-all-prices tbody td,.barn-all-prices tbody th{padding:12px 10px;border-bottom:1px solid #ddd;text-align:right;white-space:nowrap;color:#26312b}
.barn-all-prices tbody th{text-align:left}
@media(max-width:800px){.barn-calc-grid{grid-template-columns:1fr}.barn-calc-controls,.barn-calc-result{padding:23px}.barn-price-section{padding:52px 0}}

