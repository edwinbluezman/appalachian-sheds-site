import Base from '../../layouts/Base.astro';
const pageTitle = "The Pine Ridge Pricing | Appalachian Sheds Inc.";
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is The Pine Ridge built on my property?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Every Appalachian Sheds building is constructed on site. Every building is constructed on site."}}, {"@type": "Question", "name": "Is the interior finished at the listed price?", "acceptedAnswer": {"@type": "Answer", "text": "No. The standard price covers a weather-tight exterior shell, not a finished interior. Interior improvements can be discussed and quoted separately."}}, {"@type": "Question", "name": "Do I need to paint or stain my Pine Ridge?", "acceptedAnswer": {"@type": "Answer", "text": "Required exterior caulking/sealing and painting or staining must be completed within 30 days after construction, as applicable to the chosen siding and trim. Our complete exterior painting service is available as an option."}}, {"@type": "Question", "name": "Can I request a size that isn't featured above?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Our full price comparison includes 21 sizes, and we can discuss other dimensions and configuration needs for your property."}}, {"@type": "Question", "name": "Will my final project price match the guide?", "acceptedAnswer": {"@type": "Answer", "text": "The guide helps you plan. Your written proposal reflects your selected building, actual site conditions, access, required approvals and any optional upgrades or services."}}]};

---
<Base title={pageTitle}>
<Fragment set:html={"\n<header class=\"sitebar\"><div class=\"wrap\"><div class=\"brand\">APPALACHIAN SHEDS INC.</div><div class=\"nav-note\">Veteran &amp; Family-Owned \u2022 Built on Site in Greater Cincinnati &amp; the Tri-State</div></div></header>\n<main><div class=\"hero\"><div class=\"wrap hero-grid asi-standard-hero-grid\"><div><div class=\"eyebrow\">Traditional Appalachian Craftsmanship</div><h1>The Pine Ridge Shed Pricing.</h1><p>A timeless 8/12 gable roof, purposeful timber detailing and a handsome backyard presence. Explore sizes and siding choices for a premium structure built on your property.</p><div class=\"actions\"><a class=\"button\" href=\"#calculator\">See Your Price</a><a class=\"button secondary\" href=\"#sizes\">Choose Your Size</a></div></div><div class=\"asi-standard-hero-media\"><img alt=\"Pine Ridge model with deep green vertical siding, natural cedar trim, gable roof and charcoal double doors in a wooded setting\" src=\"/models/pine-ridge-shed.jpg\"/></div></div></div>\n<section><div class=\"wrap intro\"><span class=\"eyebrow\" style=\"color:#496653\">Built on Your Property</span><h2>Designed for the way you live outdoors</h2><p>From everyday storage to a garden or workshop setting, The Pine Ridge combines the familiar lines of an Appalachian building with the durability of thoughtful on-site construction.</p><div class=\"notice\"><strong>What your price includes</strong>The standard Pine Ridge is a weather-tight exterior shell, built on site. Interior wall and ceiling finishes, insulation, electrical, HVAC and other interior improvements are not included unless expressly added to your written proposal. Required exterior caulking/sealing and painting or staining must be completed within 30 days after construction, as applicable to the selected materials. Ask about our optional complete exterior painting service.</div></div></section>\n<section id=\"sizes\" style=\"background:#E1DED8\"><div class=\"wrap\"><span class=\"eyebrow\" style=\"color:#496653\">Popular Configurations</span><h2>Choose Your Size</h2><p>These are six convenient starting points. More sizes are available; see the full schedule below or request a written proposal.</p><div class=\"six-grid\"><button class=\"size-card\" data-size=\"8x10\" type=\"button\"><strong>8 \u00d7 10 ft</strong><span>From $7,848</span><small>See Your Price \u2192</small></button><button class=\"size-card\" data-size=\"10x12\" type=\"button\"><strong>10 \u00d7 12 ft</strong><span>From $9,163</span><small>See Your Price \u2192</small></button><button class=\"size-card\" data-size=\"10x16\" type=\"button\"><strong>10 \u00d7 16 ft</strong><span>From $10,568</span><small>See Your Price \u2192</small></button><button class=\"size-card\" data-size=\"12x16\" type=\"button\"><strong>12 \u00d7 16 ft</strong><span>From $11,560</span><small>See Your Price \u2192</small></button><button class=\"size-card\" data-size=\"12x20\" type=\"button\"><strong>12 \u00d7 20 ft</strong><span>From $13,756</span><small>See Your Price \u2192</small></button><button class=\"size-card\" data-size=\"14x24\" type=\"button\"><strong>14 \u00d7 24 ft</strong><span>From $17,680</span><small>See Your Price \u2192</small></button></div></div></section>\n<section class=\"calculator\" id=\"calculator\"><div class=\"wrap\"><span class=\"eyebrow\">Plan With Confidence</span><h2>See Your Price</h2><div class=\"calc-grid\"><div><p>Select your preferred size and exterior siding. The guide price updates automatically to help you compare configurations.</p><div class=\"calc-fields\"><div class=\"field\"><label for=\"building-size\">Building Size</label><select id=\"building-size\"></select></div><div class=\"field\"><label for=\"siding-choice\">Exterior Siding</label><select id=\"siding-choice\"><option value=\"0\">Roseburg DuraTemp</option><option value=\"1\">LP SmartSide Vertical Textured Panel</option><option value=\"2\">LP SmartSide Board &amp; Batten</option><option value=\"3\">LP SmartSide Lap</option><option value=\"4\">GP Vinyl Lap</option></select></div></div><p class=\"small-note\">Published prices are planning guides for the specified exterior shell. Site conditions, access, terrain, permits, engineering requirements, customization and selected services may affect your written proposal. All buildings are constructed on site.</p></div><div aria-live=\"polite\" class=\"result\"><span>Estimated Base Building Price</span><div class=\"price\" id=\"estimated-price\">\u2014</div><strong id=\"selection-summary\"></strong><p class=\"help\">Exterior weather-tight shell \u2022 Built on site \u2022 Additional services quoted separately</p><a class=\"button\" href=\"#contact\" style=\"align-self:flex-start\">Request a Written Proposal</a></div></div></div></section>\n<section class=\"table-sec\"><div class=\"wrap\"><span class=\"eyebrow\" style=\"color:#496653\">All Available Sizes</span><h2>Complete Price Comparison</h2><p>DuraTemp is our included standard siding. Review four additional siding choices across the complete size range.</p><details><summary>View Full 21-Size Pricing Table</summary><div class=\"table-scroll\"><table class=\"price-table\"><thead><tr><th scope=\"col\">Size (ft)</th><th scope=\"col\">Roseburg<br/>DuraTemp<br/>Standard</th><th scope=\"col\">LP SmartSide<br/>Vertical Textured Panel</th><th scope=\"col\">LP SmartSide<br/>Board &amp; Batten</th><th scope=\"col\">LP SmartSide<br/>Lap</th><th scope=\"col\">GP Vinyl<br/>Lap</th></tr></thead><tbody><tr><th scope=\"row\">8 \u00d7 8</th><td>$7,290</td><td>$7,873</td><td>$8,092</td><td>$8,930</td><td>$9,040</td></tr><tr><th scope=\"row\">8 \u00d7 10</th><td>$7,848</td><td>$8,476</td><td>$8,711</td><td>$9,614</td><td>$9,731</td></tr><tr><th scope=\"row\">8 \u00d7 12</th><td>$8,267</td><td>$8,928</td><td>$9,176</td><td>$10,127</td><td>$10,251</td></tr><tr><th scope=\"row\">10 \u00d7 10</th><td>$8,674</td><td>$9,368</td><td>$9,629</td><td>$10,626</td><td>$10,756</td></tr><tr><th scope=\"row\">10 \u00d7 12</th><td>$9,163</td><td>$9,896</td><td>$10,171</td><td>$11,224</td><td>$11,362</td></tr><tr><th scope=\"row\">10 \u00d7 14</th><td>$9,875</td><td>$10,665</td><td>$10,961</td><td>$12,097</td><td>$12,245</td></tr><tr><th scope=\"row\">10 \u00d7 16</th><td>$10,568</td><td>$11,414</td><td>$11,731</td><td>$12,946</td><td>$13,105</td></tr><tr><th scope=\"row\">10 \u00d7 18</th><td>$11,470</td><td>$12,388</td><td>$12,732</td><td>$14,051</td><td>$14,223</td></tr><tr><th scope=\"row\">10 \u00d7 20</th><td>$12,239</td><td>$13,219</td><td>$13,586</td><td>$14,993</td><td>$15,177</td></tr><tr><th scope=\"row\">12 \u00d7 12</th><td>$10,155</td><td>$10,967</td><td>$11,272</td><td>$12,440</td><td>$12,592</td></tr><tr><th scope=\"row\">12 \u00d7 14</th><td>$10,894</td><td>$11,766</td><td>$12,093</td><td>$13,345</td><td>$13,509</td></tr><tr><th scope=\"row\">12 \u00d7 16</th><td>$11,560</td><td>$12,484</td><td>$12,831</td><td>$14,160</td><td>$14,334</td></tr><tr><th scope=\"row\">12 \u00d7 18</th><td>$12,974</td><td>$14,012</td><td>$14,401</td><td>$15,893</td><td>$16,088</td></tr><tr><th scope=\"row\">12 \u00d7 20</th><td>$13,756</td><td>$14,856</td><td>$15,269</td><td>$16,851</td><td>$17,057</td></tr><tr><th scope=\"row\">12 \u00d7 24</th><td>$15,642</td><td>$16,893</td><td>$17,363</td><td>$19,161</td><td>$19,396</td></tr><tr><th scope=\"row\">14 \u00d7 20</th><td>$15,893</td><td>$17,164</td><td>$17,641</td><td>$19,469</td><td>$19,707</td></tr><tr><th scope=\"row\">14 \u00d7 24</th><td>$17,680</td><td>$19,095</td><td>$19,625</td><td>$21,658</td><td>$21,924</td></tr><tr><th scope=\"row\">16 \u00d7 20</th><td>$17,223</td><td>$18,601</td><td>$19,118</td><td>$21,099</td><td>$21,357</td></tr><tr><th scope=\"row\">16 \u00d7 24</th><td>$19,308</td><td>$20,852</td><td>$21,432</td><td>$23,652</td><td>$23,942</td></tr><tr><th scope=\"row\">16 \u00d7 30</th><td>$22,684</td><td>$24,499</td><td>$25,180</td><td>$27,788</td><td>$28,129</td></tr><tr><th scope=\"row\">16 \u00d7 32</th><td>$23,594</td><td>$25,481</td><td>$26,189</td><td>$28,903</td><td>$29,256</td></tr></tbody></table></div><p>Prices shown in US dollars. All sizes are built on site. Final specifications and project pricing are confirmed in writing.</p></details></div></section>\n<section class=\"standards\"><div class=\"wrap\"><span class=\"eyebrow\" style=\"color:#496653\">What Sets Us Apart</span><h2>Superior Standard Features</h2><div class=\"spec-grid\"><div class=\"spec\"><strong>Solid Foundation System</strong><p>Pressure-treated 4\u00d76 support beams on 16\u00d716\u00d74-inch solid concrete pads; support spacing and anchorage designed for the building and site.</p></div><div class=\"spec\"><strong>Substantial Floor Structure</strong><p>2\u00d76 pressure-treated floor joists at 16 inches on center with \u00be-inch pressure-treated exterior-rated plywood decking.</p></div><div class=\"spec\"><strong>Built-to-Last Wall Framing</strong><p>2\u00d74 kiln-dried studs at 16 inches on center.</p></div><div class=\"spec\"><strong>Traditional 8/12 Roof</strong><p>Engineered roof trusses at 24 inches on center, \u00bd-inch CDX plywood sheathing and architectural asphalt shingles.</p></div><div class=\"spec\"><strong>Roof Ventilation</strong><p>Ridge vent ventilation, with manufacturer-compatible roof details.</p></div><div class=\"spec\"><strong>Craftsman-Style Details</strong><p>Natural cedar trim, two 24\u00d730-inch single-hung windows and site-built Craftsman double doors with black hardware.</p></div></div><h3>Approximate Overall Building Heights</h3><table class=\"height-table\"><tbody><tr><th>8-ft-wide buildings</th><td>10 ft 2 in</td></tr><tr><th>10-ft-wide buildings</th><td>10 ft 7 in</td></tr><tr><th>12-ft-wide buildings</th><td>11 ft 0 in</td></tr><tr><th>14-ft-wide buildings</th><td>11 ft 7 in</td></tr><tr><th>16-ft-wide buildings</th><td>12 ft 0 in</td></tr></tbody></table><p style=\"font-size:.84rem\">Heights are approximate and may vary by final design and site conditions.</p></div><figure class=\"asi-feature-showcase\" data-approved-model=\"pine-ridge-shed\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"Pine Ridge Shed \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/pine-ridge-shed.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"gallery\"><div class=\"wrap\"><span class=\"eyebrow\">Explore The Pine Ridge</span><h2>Exterior Gallery</h2><div class=\"gallery-grid\"><div><h3>Exterior Gallery</h3><img alt=\"Pine Ridge green board-and-batten exterior with timber trim\" src=\"/standard-features/pine-ridge-shed.png\"/></div></div></div></section>\n<section aria-labelledby=\"asi-construction-heading\" class=\"asi-construction-bridge\"><div class=\"asi-construction-bridge__inner\"><div><div class=\"asi-construction-bridge__eyebrow\">Our Craftsmanship</div><h2 id=\"asi-construction-heading\">Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. Our shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"asi-construction-bridge__button\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p class=\"asi-construction-bridge__note\">Standard buildings are weather-tight exterior shells; interior finishes are not included. Required exterior caulking and painting or staining must be completed within 30 days. Optional finishing services are available.</p></div><div class=\"asi-construction-bridge__features\"><div><strong>Foundation &amp; floor</strong><span>Pressure-treated framing and solid concrete support pads</span></div><div><strong>Walls &amp; roof</strong><span>Purpose-built structure suited to the model and site</span></div><div><strong>Weather protection</strong><span>Roofing, flashing, ventilation and exterior detailing</span></div></div></div></section><section class=\"faq\"><div class=\"wrap\"><span class=\"eyebrow\" style=\"color:#496653\">Good to Know</span><h2>Frequently Asked Questions</h2><details><summary>Is The Pine Ridge built on my property?</summary><p>Yes. Every Appalachian Sheds building is constructed on site. Every building is constructed on site.</p></details><details><summary>Is the interior finished at the listed price?</summary><p>No. The standard price covers a weather-tight exterior shell, not a finished interior. Interior improvements can be discussed and quoted separately.</p></details><details><summary>Do I need to paint or stain my Pine Ridge?</summary><p>Required exterior caulking/sealing and painting or staining must be completed within 30 days after construction, as applicable to the chosen siding and trim. Our complete exterior painting service is available as an option.</p></details><details><summary>Can I request a size that isn't featured above?</summary><p>Yes. Our full price comparison includes 21 sizes, and we can discuss other dimensions and configuration needs for your property.</p></details><details><summary>Will my final project price match the guide?</summary><p>The guide helps you plan. Your written proposal reflects your selected building, actual site conditions, access, required approvals and any optional upgrades or services.</p></details></div></section>\n<section class=\"final\" id=\"contact\"><div class=\"wrap\"><span class=\"eyebrow\">A Building Made for Your Property</span><h2>Ready to Plan Your Pine Ridge?</h2><p>Tell us what you have in mind and we'll review your building configuration, site requirements and next steps for a written proposal.</p><div class=\"actions\"><a class=\"button\" href=\"https://appalachiansheds.com/\">Request a Written Proposal</a><a class=\"button secondary\" href=\"https://appalachiansheds.com/\">Request a Property Walk-Through</a></div></div></section></main>\n<section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n\n\n"} />

