---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Nordic Retreat Pricing | Appalachian Sheds Inc.";
---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div>\n<header class=\"site-header\"><div class=\"shell head-inner\"><a class=\"brand\" href=\"../index.html\">Appalachian Sheds Inc.<small>VETERAN &amp; FAMILY OWNED \u00b7 CINCINNATI</small></a><nav aria-label=\"Page sections\" class=\"nav\"><a href=\"#pricing\">Pricing</a><a href=\"#features\">Standard Features</a><a href=\"#gallery\">Gallery</a><a href=\"#questions\">Questions</a><a class=\"btn btn-gold\" href=\"#proposal\">Request a Proposal</a></nav></div></header>\n<section class=\"hero\"><div class=\"shell hero-grid\"><div><div class=\"eyebrow\">Appalachian Sheds \u00b7 Nordic Collection \u00b7 Built on Site</div><h1>The Nordic Retreat Pricing.</h1><p class=\"intro\">Scandinavian-inspired architecture with a steep 10/12 roofline, generous corner glazing and a distinctive recessed entry.</p><p>Explore a thoughtfully designed exterior weather-tight shell, constructed on your property in the Greater Cincinnati Tri-State area.</p><div class=\"hero-price\">Starting at <span id=\"hero-start\">$24,629</span></div><p>10\u00d716 overall \u00b7 10\u00d712 enclosed \u00b7 DuraTemp siding included</p><div class=\"hero-actions\"><a class=\"btn btn-gold\" href=\"#pricing\">See Your Price</a><a class=\"btn btn-outline\" href=\"#features\">Explore Standard Features</a></div></div><figure class=\"hero-photo\"><img alt=\"The Nordic Retreat exterior, showing its characteristic roofline, corner windows and recessed entry\" loading=\"eager\" src=\"/models/nordic-retreat.jpg\"/></figure></div></section>\n<section class=\"section\" id=\"pricing\"><div class=\"shell\"><div class=\"eyebrow\">Choose your size &amp; siding</div><h2>See Your Price</h2><p class=\"lead\">Choose a popular size or select from our full range. Each option clearly identifies the overall building footprint and enclosed area.</p><div class=\"featured\" id=\"featured\"></div><div class=\"calculator\"><div class=\"calc-form\"><div class=\"field\"><label for=\"size\">Choose Your Size</label><select aria-label=\"Overall and enclosed building size\" id=\"size\"></select></div><div class=\"field\"><label for=\"siding\">Choose Your Siding</label><select id=\"siding\"><option value=\"0\">Roseburg DuraTemp \u2014 Standard</option><option value=\"1\">LP SmartSide Vertical Textured Panel</option><option value=\"2\">LP SmartSide Board &amp; Batten</option><option value=\"3\">LP SmartSide Lap</option><option value=\"4\">GP Vinyl Lap</option></select></div><div class=\"selection-note\">Your standard price includes a weather-tight exterior shell built on site. The recessed entry is included in the overall footprint; the enclosed dimensions identify the interior building envelope. Interior finishes and optional painting or staining are quoted separately.</div></div><div aria-live=\"polite\" class=\"price-card\"><div class=\"eyebrow\">Your Nordic Retreat Price</div><div class=\"price-number\" id=\"calc-price\">$24,629</div><div class=\"calc-details\" id=\"calc-details\">10\u00d716 overall \u00b7 10\u00d712 enclosed</div><div class=\"calc-details\" id=\"calc-siding\">Roseburg DuraTemp \u2014 Standard</div><button class=\"btn btn-light\" id=\"copy\" type=\"button\">Copy My Building Selections</button><span id=\"price-status\" role=\"status\"></span></div></div><div class=\"pricing-tools\"><button aria-controls=\"table-panel\" aria-expanded=\"false\" class=\"btn btn-green\" id=\"toggle-table\" type=\"button\">View All 32 Sizes &amp; Prices</button><span class=\"subtle\">Five exterior siding choices \u00b7 Complete pricing schedule available</span></div><div hidden=\"\" id=\"table-panel\"><div class=\"full-table\"><table class=\"price-table\"><thead><tr><th>Overall / Enclosed Size</th><th>DuraTemp<br/>Included</th><th>LP Vertical<br/>Textured Panel</th><th>LP Board<br/>&amp; Batten</th><th>LP Lap</th><th>GP Vinyl Lap</th></tr></thead><tbody id=\"price-rows\"></tbody></table></div><p class=\"subtle\" style=\"margin-top:14px;font-size:.87rem\">Prices are based on the listed building configuration and siding. Site-specific conditions, customization and optional services are addressed in a written proposal.</p></div></div></section>\n<section class=\"section section-soft\" id=\"features\"><div class=\"shell\"><div class=\"eyebrow\">Exceptional by design</div><h2>Superior Standard Features</h2><p class=\"lead\">Selected materials and purposeful construction methods create a dependable exterior shell. Specialty details vary with the Nordic Retreat's architectural design.</p><div class=\"features\"><div class=\"feature\"><h3>Foundation &amp; Floor</h3><p>4\u00d76 pressure-treated support beams and solid 16\u00d716\u00d74-inch concrete pads; 2\u00d76 pressure-treated joists at 16 inches on center and \u00be-inch pressure-treated plywood decking.</p></div><div class=\"feature\"><h3>Framing &amp; Roof</h3><p>2\u00d74 kiln-dried wall framing, a distinctive 10/12 roof profile, and roof structural design appropriate to the selected configuration.</p></div><div class=\"feature\"><h3>Windows &amp; Entry</h3><p>Distinctive corner glazing with two 60\u00d760-inch fixed picture windows and a full-glass door in the model's architectural arrangement.</p></div><div class=\"feature\"><h3>Exterior Siding</h3><p>Roseburg DuraTemp standard, with four alternative exterior siding selections available.</p></div><div class=\"feature\"><h3>Roof &amp; Weather Protection</h3><p>Architectural roofing, appropriately detailed underlayment, flashing and weather sealing for the roof and wall assemblies.</p></div><div class=\"feature\"><h3>Built on Site</h3><p>Constructed at your property, with property access, support layout, anchorage and site conditions reviewed for the written proposal.</p></div></div></div><figure class=\"asi-feature-showcase\" data-approved-model=\"nordic-retreat\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"Nordic Retreat \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/nordic-retreat.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"section\" id=\"gallery\"><div class=\"shell\"><div class=\"eyebrow\">Nordic-inspired architecture</div><h2>Exterior Gallery</h2><p class=\"lead\">Explore the building's steep roofline, dark cladding and signature corner-window design. Exterior color and material combinations are available by proposal.</p><div class=\"gallery\"><figure><img alt=\"Nordic Retreat exterior view with corner glazing\" loading=\"lazy\" src=\"/standard-features/nordic-retreat.png\"/><figcaption>Nordic Retreat \u2014 exterior architectural view. Photographs and representations may show optional treatments.</figcaption></figure></div></div></section>\n<section class=\"bridge\"><div class=\"shell bridge-grid\"><div><div class=\"eyebrow\">Our Craftsmanship</div><h2>Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. One shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"btn btn-green\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p style=\"margin-top:17px;font-size:.82rem\">Standard buildings are exterior weather-tight shells. Exterior caulking and painting or staining must be completed within 30 days; ASI finishing services are available separately.</p></div><div class=\"bridge-aside\"><div><strong>Foundation &amp; floor</strong><small>Pressure-treated framing and concrete support pads</small></div><div><strong>Walls &amp; roof</strong><small>Construction designed for the selected model and site</small></div><div><strong>Weather protection</strong><small>Flashing, roofing and exterior detailing</small></div></div></div></section>\n<section class=\"section faq\" id=\"questions\"><div class=\"shell\"><div class=\"eyebrow\">Helpful details</div><h2>Frequently Asked Questions</h2><details><summary>What is the difference between overall and enclosed size?</summary><p>Overall dimensions include the building's recessed entry area. Enclosed dimensions identify the enclosed portion of the structure. Both are shown alongside each price.</p></details><details><summary>How is my Nordic Retreat constructed?</summary><p>Appalachian Sheds constructs every building directly on your property, with site-specific access and foundation requirements addressed in the written proposal.</p></details><details><summary>Are interiors finished?</summary><p>No. Standard pricing is for an exterior weather-tight shell only. Interior wall, ceiling, electrical and other finish work is outside the standard scope and may be discussed separately.</p></details><details><summary>Does the quoted price include painting?</summary><p>Exterior finishing is not included in standard shell pricing. Required caulking and painting or staining must be completed within 30 days. Optional finishing services are available separately.</p></details><details><summary>How are site conditions handled?</summary><p>The final written proposal addresses property access, foundation support, leveling, anchorage, site conditions, upgrades and any necessary additional preparation.</p></details></div></section>\n<section class=\"section section-dark final\" id=\"proposal\"><div class=\"shell\"><div class=\"eyebrow\">Plan with confidence</div><h2>Ready to Plan Your Nordic Retreat?</h2><p>Choose your preferred configuration and siding, then request a written proposal or property walk-through. Our team will review site requirements, selected features and available options before finalizing project details.</p><button class=\"btn btn-light\" id=\"copy-bottom\" type=\"button\">Copy My Building Selections</button><p style=\"font-size:.83rem;color:#d7e2d9;margin-top:17px\">Use your copied selections when contacting Appalachian Sheds for a written proposal.</p></div></section>\n<section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n<footer class=\"footer\"><div class=\"shell footer-inner\"><span>Appalachian Sheds Inc. \u00b7 Veteran &amp; Family Owned \u00b7 Built on Site</span><a href=\"../index.html\">View Models &amp; Pricing</a></div></footer>\n\n"} />
</Base>

<style is:global>

:root{--dark:#2B3030;--ink:#2B3030;--deep:#2B3030;--cream:#F8F7F4;--paper:#fff;--sand:#E1DED8;--gold:#C9A06C;--border:#E1DED8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--cream);font-family:Montserrat,Arial,sans-serif;font-style:italic;line-height:1.6}h1{font-family:Merriweather,Georgia,serif;font-style:italic;font-size:clamp(2rem,3.5vw,3.6rem);line-height:1.17;margin:16px 0 22px}h2,h3{font-weight:800;line-height:1.3}h2{font-size:clamp(1.65rem,2.7vw,2.55rem);margin:12px 0 16px}h3{font-size:1.13rem}p{margin:0 0 16px}a{color:inherit}.shell{width:94%;max-width:1440px;margin:auto}.eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#ad8965}.subtle{color:#59625c}.site-header{background:#1f2d26;color:white;border-bottom:1px solid #506354}.head-inner{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.25;font-weight:500;text-decoration:none;white-space:nowrap}.brand small{display:block;font-size:.61rem;letter-spacing:.16em;color:#d2ac84;margin-top:7px}.nav{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.nav a{text-decoration:none;font-size:.85rem}.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;text-align:center;padding:14px 19px;font-size:.9rem;font-weight:800;line-height:1.3;text-decoration:none;border-radius:2px;border:2px solid transparent;cursor:pointer;font-family:inherit;font-style:inherit}.btn-gold{background:#c2a07c;color:#1e2925}.btn-green{background:#244b39;color:#fff}.btn-outline{border-color:#b8c5bc;background:transparent;color:inherit}.btn-light{background:#F8F7F4;color:#203129}.btn:hover{filter:brightness(.94)}a:focus-visible,button:focus-visible,select:focus-visible{outline:3px solid #c28e4f;outline-offset:3px}.hero{background:var(--dark);color:#f8f5ed;padding:clamp(36px,5vw,78px) 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(26px,4vw,65px);align-items:center}.hero p{max-width:62ch}.hero .intro{font-size:1.04rem}.hero-price{font-family:Merriweather,Georgia,serif;font-size:clamp(1.65rem,2.7vw,2.6rem);margin:16px 0 0;color:#e0c09e}.hero-photo{margin:0;max-width:100%;min-width:0}.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:#293831;border-radius:3px}.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:21px}.section{padding:clamp(55px,6.5vw,94px) 0}.section-dark{background:#2B3030;color:#fff}.section-soft{background:#eae8e2}.lead{font-size:1.04rem;max-width:78ch;color:#54615a}.section-dark .lead{color:#dde3de}.calculator{margin-top:28px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:24px;align-items:stretch}.calc-form{padding:clamp(23px,3vw,35px);background:#fff;border:1px solid var(--border);border-radius:4px}.field{margin-bottom:22px}.field label{display:block;font-weight:800;margin-bottom:9px;font-size:.92rem}.field select{appearance:auto;width:100%;min-height:54px;padding:13px 15px;border:1px solid #9ba89e;background:#fff!important;color:#1f3028!important;-webkit-text-fill-color:#1f3028!important;font:inherit;font-size:.98rem;border-radius:3px;opacity:1!important;color-scheme:light}.field select option{background:#fff!important;color:#1f3028!important}.selection-note{font-size:.87rem;color:#48544c;background:#f2f0ea;border-left:3px solid #b69a77;padding:16px;margin-top:5px}.price-card{padding:clamp(25px,3.2vw,40px);background:#28312e;color:#fff;border-radius:4px;display:flex;flex-direction:column;justify-content:center;min-height:295px}.price-card .eyebrow{color:#e2c5a8}.price-number{font-weight:800;font-size:clamp(2.6rem,5vw,4.5rem);line-height:1.2;margin:12px 0 16px;color:#fff}.price-card .calc-details{color:#f2f3ef;font-weight:600}.price-card .btn{align-self:flex-start;margin-top:15px}.featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:25px 0 32px}.size-card{background:#fff;border:1px solid #E1DED8;color:#28342c;text-align:left;padding:20px;cursor:pointer;font:inherit;border-radius:3px;min-height:126px}.size-card:hover,.size-card.active{border-color:#37614b;box-shadow:inset 0 0 0 2px #37614b}.size-card strong{font-size:1.05rem;display:block}.size-card span{font-size:.85rem;color:#505c55;display:block}.size-card b{font-size:1.15rem;display:block;margin-top:8px}.full-table{overflow-x:auto;border-radius:4px;border:1px solid #d8d9d4;background:#fff}.price-table{border-collapse:collapse;min-width:840px;width:100%;color:#26332b;font-size:.85rem;font-variant-numeric:tabular-nums}.price-table th{padding:17px 12px;line-height:1.45;color:#fff;text-align:center;font-size:.77rem}.price-table th:first-child{background:#263332;text-align:left}.price-table th:nth-child(2){background:#315244}.price-table th:nth-child(3){background:#2f6272}.price-table th:nth-child(4){background:#79634c}.price-table th:nth-child(5){background:#655d7a}.price-table th:nth-child(6){background:#725948}.price-table td{padding:13px 11px;text-align:right;border-bottom:1px solid #e2e2db}.price-table td:first-child{text-align:left;font-weight:800}.price-table tr:nth-child(even){background:#e9ece8}.price-table tr:hover{background:#dce8df}.pricing-tools{margin:25px 0 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}.pricing-tools .btn{margin:0}.features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:25px}.feature{background:#fff;border:1px solid #e1dfd8;padding:26px}.feature h3{margin:0 0 10px}.feature p{margin:0;color:#56615a;font-size:.89rem}.gallery{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin-top:25px}.gallery figure{margin:0;background:#fff;padding:13px;border:1px solid var(--border);max-width:850px}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:contain;background:#dfded7}.gallery figcaption{margin-top:10px;color:#3d4a41;font-size:.82rem}.bridge{background:#ece9e3;padding:clamp(55px,6vw,85px) 0}.bridge-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}.bridge-aside{display:grid;gap:11px}.bridge-aside>div{background:#fafaf8;border-left:3px solid #a98d70;padding:15px 19px}.bridge-aside strong{display:block}.bridge-aside small{display:block;color:#536058}.faq details{border-bottom:1px solid #bec6bf;padding:19px 0}.faq summary{cursor:pointer;font-weight:800}.faq details p{margin:14px 0 3px;color:#536058}.final{text-align:center}.final p{max-width:70ch;margin:15px auto 24px}.footer{background:#1e2c25;color:#d7dcd6;padding:25px 0;font-size:.8rem}.footer a{color:#fff}.footer-inner{display:flex;gap:20px;justify-content:space-between;flex-wrap:wrap}#price-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:900px){.hero-grid,.calculator,.bridge-grid{grid-template-columns:1fr}.hero-photo{max-width:720px}.featured,.features{grid-template-columns:repeat(2,minmax(0,1fr))}.nav{gap:12px}}
@media(max-width:620px){.head-inner{align-items:flex-start;flex-direction:column;padding:15px 0}.nav{gap:12px}.hero-actions .btn{width:100%}.featured,.features{grid-template-columns:1fr}.price-card .btn{align-self:stretch}.section{padding:48px 0}.hero{padding:34px 0}.price-card{min-height:230px}.hero h1{font-size:2rem}}

</style>

<script is:inline>

const rows=[{"overall":"10×16","enclosed":"10×12","prices":[24629,26599,27338,30170,30540]},{"overall":"10×18","enclosed":"10×14","prices":[25704,27760,28531,31487,31873]},{"overall":"10×20","enclosed":"10×16","prices":[26757,28897,29700,32777,33178]},{"overall":"10×22","enclosed":"10×18","prices":[27989,30228,31068,34286,34706]},{"overall":"10×24","enclosed":"10×20","prices":[29131,31462,32336,35686,36123]},{"overall":"10×26","enclosed":"10×22","prices":[31517,34038,34984,38608,39081]},{"overall":"10×28","enclosed":"10×24","prices":[32794,35417,36401,40172,40664]},{"overall":"10×30","enclosed":"10×26","prices":[34070,36796,37818,41736,42247]},{"overall":"12×16","enclosed":"12×12","prices":[29557,31921,32808,36207,36650]},{"overall":"12×18","enclosed":"12×14","prices":[30845,33312,34238,37785,38248]},{"overall":"12×20","enclosed":"12×16","prices":[32099,34667,35630,39322,39803]},{"overall":"12×22","enclosed":"12×18","prices":[33578,36264,37271,41133,41636]},{"overall":"12×24","enclosed":"12×20","prices":[34955,37752,38800,42820,43344]},{"overall":"12×26","enclosed":"12×22","prices":[37822,40848,41983,46332,46900]},{"overall":"12×28","enclosed":"12×24","prices":[39357,42505,43686,48212,48802]},{"overall":"12×30","enclosed":"12×26","prices":[40880,44150,45377,50078,50691]},{"overall":"14×16","enclosed":"14×12","prices":[34485,37244,38278,42244,42761]},{"overall":"14×18","enclosed":"14×14","prices":[35986,38864,39944,44082,44622]},{"overall":"14×20","enclosed":"14×16","prices":[37453,40449,41573,45880,46441]},{"overall":"14×22","enclosed":"14×18","prices":[39178,42312,43487,47993,48580]},{"overall":"14×24","enclosed":"14×20","prices":[40779,44042,45265,49955,50566]},{"overall":"14×26","enclosed":"14×22","prices":[44128,47658,48982,54057,54719]},{"overall":"14×28","enclosed":"14×24","prices":[45920,49594,50971,56252,56941]},{"overall":"14×30","enclosed":"14×26","prices":[47690,51505,52935,58420,59135]},{"overall":"16×16","enclosed":"16×12","prices":[39405,42557,43740,48271,48862]},{"overall":"16×18","enclosed":"16×14","prices":[41121,44410,45644,50373,50990]},{"overall":"16×20","enclosed":"16×16","prices":[42803,46227,47511,52434,53076]},{"overall":"16×22","enclosed":"16×18","prices":[44776,48359,49702,54851,55523]},{"overall":"16×24","enclosed":"16×20","prices":[46604,50333,51731,57090,57789]},{"overall":"16×26","enclosed":"16×22","prices":[50426,54460,55973,61772,62528]},{"overall":"16×28","enclosed":"16×24","prices":[52478,56676,58250,64285,65072]},{"overall":"16×30","enclosed":"16×26","prices":[54507,58868,60503,66771,67589]}];
const names=['Roseburg DuraTemp — Standard','LP SmartSide Vertical Textured Panel','LP SmartSide Board & Batten','LP SmartSide Lap','GP Vinyl Lap'];
const featuredSizes=['10×16','10×20','12×16','12×20','14×16','16×16'];
const format=n=>'$'+n.toLocaleString('en-US');
const size=document.getElementById('size'),siding=document.getElementById('siding');
rows.forEach((r,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=`${r.overall} overall · ${r.enclosed} enclosed`;size.appendChild(o)});
function update(){const r=rows[Number(size.value)||0];const type=Number(siding.value)||0;document.getElementById('calc-price').textContent=format(r.prices[type]);document.getElementById('calc-details').textContent=`${r.overall} overall · ${r.enclosed} enclosed`;document.getElementById('calc-siding').textContent=names[type];document.querySelectorAll('.size-card').forEach(b=>{b.classList.toggle('active',b.dataset.size===r.overall)});}
size.addEventListener('change',update);siding.addEventListener('change',update);
const featured=document.getElementById('featured');featuredSizes.forEach(v=>{const i=rows.findIndex(r=>r.overall===v);if(i<0)return;const r=rows[i];const b=document.createElement('button');b.type='button';b.className='size-card';b.dataset.size=r.overall;b.innerHTML=`<strong>${r.overall} overall</strong><span>${r.enclosed} enclosed</span><b>From ${format(r.prices[0])}</b>`;b.addEventListener('click',()=>{size.value=String(i);update();document.getElementById('calc-price').scrollIntoView({behavior:'smooth',block:'center'});});featured.appendChild(b)});
const body=document.getElementById('price-rows');rows.forEach(r=>{const tr=document.createElement('tr');tr.innerHTML=`<td><strong>${r.overall}</strong> overall<br><small>${r.enclosed} enclosed</small></td>`+r.prices.map(p=>`<td>${format(p)}</td>`).join('');body.appendChild(tr)});
document.getElementById('toggle-table').addEventListener('click',()=>{const area=document.getElementById('table-panel'),b=document.getElementById('toggle-table');area.hidden=!area.hidden;b.setAttribute('aria-expanded',String(!area.hidden));b.textContent=area.hidden?'View All 32 Sizes & Prices':'Hide Full Price Comparison'});
async function copySelection(){const r=rows[Number(size.value)||0],v=Number(siding.value)||0;const message=`Appalachian Sheds — Nordic Retreat\nOverall size: ${r.overall}\nEnclosed size: ${r.enclosed}\nSiding: ${names[v]}\nListed exterior-shell price: ${format(r.prices[v])}\nBuilt on site; optional services and site requirements quoted separately.`;let ok=false;try{await navigator.clipboard.writeText(message);ok=true}catch(e){const input=document.createElement('textarea');input.value=message;document.body.appendChild(input);input.select();ok=document.execCommand('copy');input.remove()}document.getElementById('copy').textContent=ok?'Selections Copied':'Copy Not Available';document.getElementById('price-status').textContent=ok?'Your selected Nordic Retreat details have been copied.':'Please copy your selected size, siding and price manually.';setTimeout(()=>document.getElementById('copy').textContent='Copy My Building Selections',2200)}
document.getElementById('copy').addEventListener('click',copySelection);document.getElementById('copy-bottom').addEventListener('click',copySelection);update();

</script>
