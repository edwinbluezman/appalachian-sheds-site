      ],
    },
    {
      type: 'cards', id: 'questions', title: 'Questions That Keep the Value Decision Grounded', nav: 'Questions Before You Invest',
      items: [
        { title: 'About use', list: ['What problem will this building solve for us?', 'Will the purpose still make sense in 5 or 10 years?', 'Could a future buyer quickly understand the space?', 'Do the doors, windows and layout fit the function?', 'Is the size proportional to the need?'] },
