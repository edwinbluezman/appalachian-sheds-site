---
import ModelPage from '../../components/ModelPage.astro';
import photo from '../../assets/appalachian-classic-shed.webp';
import prices from '../../data/classic-prices.csv?raw';
import { classicSeriesSpecs, commonFaqs } from '../../data/models.js';

const name = 'Appalachian Classic Shed';

const model = {
  path: '/buildings/appalachian-classic/',
  name,
  shortName: 'Appalachian Classic',
  series: 'Classic Series',
  prices,
  effective: 'August 2026',
  title: 'Appalachian Classic Shed | Sizes, Siding & Pricing | Appalachian Sheds',
  description: 'Appalachian Classic Shed: {count} sizes from {range}, five siding choices, built on site in Cincinnati and the Tri-State. Standard build prices from {low}.',
  schemaDescription: 'A classic low-profile backyard storage shed built on site, offered in {count} sizes from {range} and five siding systems.',
  answer: 'The Appalachian Classic is a low-profile backyard storage shed built on site at your property in Cincinnati and the Tri-State. It comes in {count} sizes from {range}, five siding choices, and the Appalachian Sheds 30-Year Structural Warranty. Standard build prices start at {low}.',
  photo,
  photoAlt: 'Appalachian Classic Shed in ivory board-and-batten siding with a charcoal shingle roof, a small entry overhang over French doors, and window boxes, set in a landscaped yard',
  photoCaption: 'Shown with upgraded LP SmartSide Board & Batten siding and optional French doors, entry overhang and window boxes. The standard Appalachian Classic includes LP SmartSide Vertical Panel siding and a 6-panel fiberglass entry door.',
  specs: classicSeriesSpecs('Classic low-profile roof', '26 sizes, from 6′ × 8′ to 14′ × 24′'),
  sidingLead: 'The structure underneath stays the same. Your siding choice sets the exterior character, from a practical painted panel to a residential lap or a farmhouse board and batten.',
  fitLead: 'The Classic is the straightforward foundation of the lineup: dependable storage, practical access and a clean low-profile building. Adding one useful option, such as a larger window, a ramp or shelving, is not a reason to change models.',
  fit: [
    ['Everyday storage', 'Strong fit', 'One of the clearest uses for the Appalachian Classic.'],
    ['Lawn & garden equipment', 'Strong fit', 'Match the size and door arrangement to the equipment you will store.'],
    ['Straightforward backyard utility', 'Strong fit', 'Practical storage without unnecessary complexity.'],
    ['Residential exterior', 'Strong fit', 'Vinyl or LP SmartSide lap siding coordinates with a house or garage.'],
    ['Farmhouse exterior', 'Strong fit', 'LP SmartSide Board & Batten adds a farmhouse look on the same structure.'],
    ['More overhead or loft volume', 'Compare models', 'If upper interior volume is a priority, compare roof forms first.'],
    ['Very large specialty access', 'Compare models', 'Large openings may call for a different building configuration.'],
    ['Porch-centered architecture', 'Compare models', 'Another model may better fit the role you want the building to play.'],
    ['Finished office or studio', 'Plan carefully', 'Plan electrical, insulation, interior finish and windows as one project.'],
  ],
  faqs: [
    ...commonFaqs(name).slice(0, 3),
    { q: 'How is the Appalachian Classic floor supported?', a: 'The standard floor system uses 6×6 ground-contact pressure-treated foundation beams, 2×6 pressure-treated floor joists at 16 inches on center, and 3/4-inch 7-ply pressure-treated plywood flooring.' },
    ...commonFaqs(name).slice(3, 5),
    { q: 'When should I compare another shed model?', a: 'Compare another model when the project needs a different roof form, substantially more upper interior volume, specialty access, porch-centered architecture or a different overall building character. Do not change models just to add one useful upgrade.' },
    ...commonFaqs(name).slice(5),
  ],
};
---
<ModelPage model={model} />
