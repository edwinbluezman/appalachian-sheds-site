<script is:inline>

(()=>{'use strict';
const sizes=["8\u00d78", "8\u00d710", "8\u00d712", "10\u00d710", "10\u00d712", "10\u00d714", "10\u00d716", "10\u00d718", "10\u00d720", "12\u00d712", "12\u00d714", "12\u00d716", "12\u00d718", "12\u00d720", "12\u00d724", "14\u00d720", "14\u00d724", "16\u00d720", "16\u00d724", "16\u00d730", "16\u00d732"], prices=[[6451,6967,7161,7903,7999],[6886,7437,7643,8435,8538],[7288,7871,8090,8928,9037],[7627,8237,8466,9343,9458],[8172,8825,9070,10010,10133],[8691,9386,9647,10647,10777],[9397,10149,10430,11511,11652],[10204,11021,11327,12500,12653],[10674,11527,11848,13075,13235],[9013,9734,10004,11040,11176],[9724,10502,10793,11912,12058],[10324,11150,11460,12647,12802],[11303,12207,12546,13846,14016],[12411,13404,13776,15203,15389],[14161,15294,15719,17348,17560],[13934,15049,15467,17069,17278],[16157,17450,17934,19792,20035],[15935,17210,17688,19521,19760],[17643,19055,19584,21613,21878],[20470,22108,22722,25076,25383],[21426,23140,23782,26246,26568]], sidings=["Roseburg DuraTemp wood siding", "LP SmartSide Vertical Textured Panel siding", "LP SmartSide Board & Batten siding", "LP SmartSide Textured Lap siding", "GP Forest Ridge Vinyl Lap siding"];
const sizeSelect=document.querySelector('#buildingSize'), sidingSelect=document.querySelector('#sidingChoice'), chosen=document.querySelector('#selectedName'), money=document.querySelector('#selectedPrice'), tbody=document.querySelector('#comparisonRows');
const fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const pretty=s=>s.split('×').map(x=>x+'′').join(' × ');
sizes.forEach((s,i)=>{let op=document.createElement('option');op.value=i;op.textContent=pretty(s);sizeSelect.append(op)});
sidings.forEach((s,i)=>{let op=document.createElement('option');op.value=i;op.textContent=s+(i===0?' · Included standard':'');sidingSelect.append(op)});
sizeSelect.value='5';sidingSelect.value='0';
function refresh(){const i=Number(sizeSelect.value),j=Number(sidingSelect.value);chosen.textContent=pretty(sizes[i])+' · '+sidings[j];money.textContent=fmt(prices[i][j]);document.querySelectorAll('#comparisonRows tr').forEach((tr,k)=>tr.classList.toggle('active-row',k===i));}
sizes.forEach((s,i)=>{let tr=document.createElement('tr');let th=document.createElement('td');th.textContent=pretty(s);tr.append(th);prices[i].forEach((p,j)=>{let td=document.createElement('td');td.textContent=fmt(p);if(j===0)td.classList.add('base-col');tr.append(td)});tbody.append(tr)});
sizeSelect.addEventListener('change',refresh);sidingSelect.addEventListener('change',refresh);refresh();
const toggle=document.getElementById('tableToggle'),comp=document.getElementById('fullComparison');toggle.addEventListener('click',()=>{const open=comp.hidden;comp.hidden=!open;toggle.setAttribute('aria-expanded',String(open));toggle.textContent=open?'− Hide full comparison table':'+ View all sizes and siding prices';});
let request='';const output=document.getElementById('requestOutput'),copy=document.getElementById('copyRequest'),save=document.getElementById('downloadRequest');
document.getElementById('prepareRequest').addEventListener('click',()=>{const get=id=>document.getElementById(id).value.trim();request=[get('requestType'),'Appalachian Sheds Inc. — The Carriage Lane','Size: '+pretty(sizes[Number(sizeSelect.value)]),'Siding: '+sidings[Number(sidingSelect.value)],'Published model price: '+fmt(prices[Number(sizeSelect.value)][Number(sidingSelect.value)]),'Standard roof: 5/12','Name: '+(get('customerName')||'Not provided'),'Contact: '+(get('customerContact')||'Not provided'),'Project city / ZIP: '+(get('customerCity')||'Not provided'),'Project notes: '+(get('customerNote')||'None provided'),'Please confirm site conditions, upgrades, final scope and applicable taxes in the written proposal.'].join('\n');output.hidden=false;output.textContent=request;copy.disabled=false;save.disabled=false;output.scrollIntoView({block:'nearest',behavior:'smooth'});});
copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(request);copy.textContent='Copied';setTimeout(()=>copy.textContent='Copy Summary',2200)}catch(err){const sel=window.getSelection(),r=document.createRange();r.selectNodeContents(output);sel.removeAllRanges();sel.addRange(r);copy.textContent='Select text and copy';}});
save.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([request],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='Carriage-Lane-Request-Summary.txt';document.body.append(a);a.click();a.remove();URL.revokeObjectURL(url)});
})();

</script>
