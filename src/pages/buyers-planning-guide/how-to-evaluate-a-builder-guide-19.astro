      ],
    },
    {
      type: 'cards', id: 'questions', title: 'Questions a Serious Builder Should Be Ready to Answer', nav: 'Questions to Ask',
      items: [
        { title: 'About the company and construction', list: ['What construction background supports your work?', 'Who will build and supervise my building?', 'What are your floor, wall, roof, siding and moisture standards?', 'Can you provide proof of insurance?', 'Can I see recent work like mine?', 'Who is my point of contact during construction?'] },
        { title: 'About the agreement', list: ['What exactly is included and excluded?', 'What site conditions could change the price?', 'Who handles permits, HOA, setbacks and utilities?', 'What does the deposit reserve, and when are payments due?', 'How are changes approved and priced?', 'What does the warranty cover, exclude and require of me?'] },
      ],
      note: 'Ask every builder you are considering the same questions. That is the easiest way to compare companies fairly.',
    },
