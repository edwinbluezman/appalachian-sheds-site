---
import OptionPage from '../../components/OptionPage.astro';
import prices from '../../data/option-prices.json';

const page = {
  path: '/options/ramps-steps-access/',
  name: 'Ramps, Steps & Access',
  title: 'Shed Ramps, Steps & Landings: Options & Prices | Appalachian Sheds',
  description: 'Appalachian Sheds site-built ramps from $450, mower and equipment ramps, entry steps and landings from $650, composite access and concrete approaches. Planning prices for Cincinnati and the Tri-State.',
  h1: 'Ramps, Steps & Landings',
  answer: 'Most Appalachian Sheds access systems run $450 to $1,700 or more: a garden-cart ramp from $450, a riding-mower ramp from $650, a zero-turn or ATV ramp from $850, and entry steps from $650. Longer mobility-oriented ramps and permanent concrete approaches can cost several thousand dollars. Every ramp is site-built to the actual floor height, door width and equipment.',
  familyLabel: 'Access Option',
  stepsTitle: 'The Entry Should Fit What Moves Through the Door',
  stepsLead: 'Door width, floor height, pad elevation, site grade, equipment weight, drainage and traction decide whether the entry feels easy or awkward every time you use it.',
  steps: [
    ['Measure the load', 'Wheelbarrow, mower, zero-turn, ATV, carts or daily foot traffic.'],
    ['Measure the rise', 'The finished floor height above the approach.'],
    ['Choose the run', 'A longer ramp is gentler; a shorter one saves space but is steeper.'],
    ['Finish the approach', 'Stable base, traction, landing, drainage and lighting.'],
  ],
  families: [
    {
      id: 'equipment-ramps',
      name: 'Equipment Ramps',
      intro: [
        'Pressure-treated wood is the practical standard for mower, garden-cart and equipment access. Each ramp is framed as a structural part of the entry, attached at the building and set on a stable base at the bottom.',
