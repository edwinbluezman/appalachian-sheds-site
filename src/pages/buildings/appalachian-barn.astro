<script is:inline>

(function(){
const rows=[{"size": "8×8", "values": [6700, 7250, 7450, 8200, 8300]}, {"size": "8×10", "values": [7250, 7800, 8000, 8850, 8950]}, {"size": "8×12", "values": [7800, 8400, 8650, 9550, 9650]}, {"size": "10×10", "values": [8200, 8850, 9100, 10050, 10150]}, {"size": "10×12", "values": [8750, 9450, 9700, 10700, 10850]}, {"size": "10×14", "values": [9350, 10100, 10400, 11450, 11600]}, {"size": "10×16", "values": [9850, 10650, 10950, 12100, 12250]}, {"size": "10×18", "values": [10950, 11850, 12200, 13450, 13600]}, {"size": "10×20", "values": [11450, 12400, 12750, 14050, 14200]}, {"size": "12×12", "values": [9550, 10300, 10600, 11700, 11850]}, {"size": "12×14", "values": [10500, 11350, 11700, 12900, 13050]}, {"size": "12×16", "values": [11000, 11900, 12250, 13500, 13650]}, {"size": "12×18", "values": [12400, 13400, 13750, 15200, 15400]}, {"size": "12×20", "values": [13250, 14300, 14700, 16200, 16400]}, {"size": "12×24", "values": [14800, 15950, 16400, 18100, 18300]}, {"size": "14×20", "values": [15550, 16800, 17250, 19050, 19300]}, {"size": "14×24", "values": [17600, 19000, 19550, 21550, 21800]}, {"size": "16×20", "values": [16900, 18250, 18750, 20650, 20950]}, {"size": "16×24", "values": [19100, 20600, 21200, 23350, 23650]}, {"size": "16×30", "values": [22750, 24600, 25250, 27900, 28200]}, {"size": "16×32", "values": [24050, 26000, 26700, 29450, 29800]}];
const names=["Roseburg DuraTemp — Included", "LP SmartSide Vertical Textured Panel", "LP SmartSide Board & Batten", "LP SmartSide Lap", "GP Vinyl Lap"];
const size=document.getElementById('barn-size'),siding=document.getElementById('barn-siding');
const price=document.getElementById('barn-price'),sel=document.getElementById('barn-selection');
const money=v=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
for(const r of rows){const o=document.createElement('option');o.value=r.size;o.textContent=r.size;size.appendChild(o)}
function draw(){const r=rows.find(x=>x.size===size.value)||rows[0];const i=Number(siding.value);price.textContent=money(r.values[i]);sel.textContent=r.size+' · '+names[i]+' · Exterior weather-tight shell';document.querySelectorAll('[data-barn-size]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.barnSize===r.size)))}
document.querySelectorAll('[data-barn-size]').forEach(b=>b.addEventListener('click',()=>{size.value=b.dataset.barnSize;draw();document.getElementById('barn-size').focus({preventScroll:true})}));
size.value='10×12';size.addEventListener('change',draw);siding.addEventListener('change',draw);draw();
})();

</script>
