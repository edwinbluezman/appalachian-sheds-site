---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Country Cottage with Shed Dormer Pricing | Appalachian Sheds Inc.";
---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div>\n<header class=\"nav\"><div class=\"shell nav-inner\"><a class=\"logo\" href=\"#top\">Appalachian Sheds Inc.<span>Veteran &amp; Family Owned \u00b7 Cincinnati</span></a><nav aria-label=\"Page navigation\" class=\"nav-links\"><a href=\"#pricing\">Pricing</a><a href=\"#features\">Standard Features</a><a href=\"#gallery\">Gallery</a><a href=\"#questions\">Questions</a><a class=\"btn\" href=\"#proposal\">Request a Proposal</a></nav></div></header>\n<main id=\"top\">\n<section class=\"hero\"><div class=\"shell hero-grid asi-standard-hero-grid\"><div class=\"hero-copy\"><div class=\"eyebrow\">Appalachian Sheds \u00b7 Cottage Collection \u00b7 Model 02 of 12</div><h1>The Country Cottage with Shed Dormer Pricing.</h1><p class=\"intro\">Cottage character. An expressive roofline. Built with care on your property.</p><p>The Country Cottage with Shed Dormer combines a traditional 9/12 main gable roof with a distinctive shed dormer for timeless Appalachian-inspired architecture and practical backyard versatility.</p><div class=\"hero-price\">Starting at $8,303<small>8\u2032 \u00d7 8\u2032 \u00b7 Roseburg DuraTemp siding included</small></div><div class=\"buttons\" style=\"margin-top:24px\"><a class=\"btn\" href=\"#pricing\">See Your Price</a><a class=\"btn alt\" href=\"#features\">Explore Standard Features</a></div></div><div class=\"asi-hero-media-group\"><div class=\"hero-photo asi-standard-hero-media\"><img alt=\"Country Cottage with Shed Dormer in an autumn residential backyard \u2014 architectural exterior reference\" src=\"/models/country-cottage-with-shed-dormer.jpg\"/></div><div class=\"asi-hero-caption\">Country Cottage with Shed Dormer \u00b7 Architectural exterior view</div></div></div></section>\n<div class=\"statbar\"><div class=\"shell stats\"><div class=\"stat\"><b>Built on your site</b><span>By a qualified construction crew</span></div><div class=\"stat\"><b>9/12 main gable roof</b><span>Classic Country Cottage with Shed Dormer profile</span></div><div class=\"stat\"><b>DuraTemp included</b><span>Four optional siding selections</span></div><div class=\"stat\"><b>Written proposal</b><span>Clear scope and site considerations</span></div></div></div>\n<section class=\"section white\" id=\"pricing\"><div class=\"shell\"><div class=\"headrow\"><div><div class=\"eyebrow\">01 \u00b7 Plan your building</div><h2>Choose Your Size. See Your Price.</h2><p class=\"muted\">Choose the right Country Cottage with Shed Dormer size for your property. Start with our standard Roseburg DuraTemp wood siding, or compare four other exterior siding selections.</p></div></div>\n<div class=\"calculator\"><div class=\"config\"><span class=\"number\">Step 1 \u00b7 Select your building size</span><div class=\"field\"><label for=\"buildingSize\">Building size</label><select id=\"buildingSize\"></select><small>Twenty-one published sizes, from 8\u2032 \u00d7 8\u2032 to 16\u2032 \u00d7 32\u2032.</small></div><div class=\"field\"><span class=\"number\">Step 2 \u00b7 Choose your siding</span><label for=\"sidingChoice\" style=\"margin-top:8px\">Exterior siding</label><select id=\"sidingChoice\"></select><small>Roseburg DuraTemp wood siding is included at the standard model price.</small></div><div class=\"pills\"><span class=\"pill\">Built on site</span><span class=\"pill\">9/12 main standard roof</span><span class=\"pill\">Craftsman double doors</span><span class=\"pill\">Concrete pad supports</span></div><div class=\"rule\"></div><p class=\"muted mini\">Your selection is priced using the published Country Cottage with Shed Dormer schedule. Site grading beyond the standard allowance, optional features and applicable taxes are evaluated separately in your written proposal.</p><button aria-controls=\"fullComparison\" aria-expanded=\"false\" class=\"comparison-toggle\" id=\"tableToggle\" type=\"button\">+ View all sizes and siding prices</button></div><div aria-live=\"polite\" class=\"pricepanel\"><div class=\"eyebrow\">Your selected Country Cottage with Shed Dormer</div><div class=\"selected\" id=\"selectedName\">10\u2032 \u00d7 14\u2032 \u00b7 DuraTemp wood siding</div><div class=\"price\" id=\"selectedPrice\">Calculating\u2026</div><div class=\"mini\">Standard model price</div><ul><li>Roseburg DuraTemp wood siding or selected alternative</li><li>Standard 9/12 main gable roof</li><li>Double Craftsman-style entry doors</li><li>Two 24\u2033 \u00d7 30\u2033 windows</li><li>Standard pressure-treated floor and foundation system</li></ul><a class=\"btn\" href=\"#proposal\" id=\"proposalPriceCTA\">Request a Written Proposal</a><div class=\"disclaimer\">Standard support pads included for suitable sites with no more than 6\u2033 of grade variation across the building footprint. Additional site work and upgrades are quoted separately.</div></div></div>\n<div class=\"comparison\" hidden=\"\" id=\"fullComparison\"><table><thead><tr><th scope=\"col\">Size</th><th scope=\"col\">Roseburg DuraTemp (included)</th><th scope=\"col\">LP SmartSide Vertical Textured Panel</th><th scope=\"col\">LP SmartSide Board &amp; Batten</th><th scope=\"col\">LP SmartSide Textured Lap</th><th scope=\"col\">GP Vinyl Lap</th></tr></thead><tbody id=\"comparisonRows\"></tbody></table></div><div class=\"table-note\">Pricing reflects the current Country Cottage with Shed Dormer schedule provided by Appalachian Sheds Inc. Final project scope, site-specific conditions and any additional selections are documented in writing.</div></div></section>\n<section class=\"section dark\" id=\"features\"><div class=\"shell\"><div class=\"eyebrow\">02 \u00b7 Built for everyday usefulness</div><h2>Superior Standard Features</h2><p class=\"feat-intro\">A strong building starts beneath the siding. Explore foundation supports, pressure-treated floor construction, solid wall framing and roof-weather protection. Specifications below describe the construction package; photograph illustrates the model exterior.</p><p class=\"mini\" style=\"margin-top:20px;color:#d8d7d0\">The illustration highlights selected features; the written specifications below define the standard Country Cottage with Shed Dormer construction package.</p></div><figure class=\"asi-feature-showcase\" data-approved-model=\"country-cottage-with-shed-dormer\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"The Country Cottage with Shed Dormer \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/country-cottage-with-shed-dormer.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"section soft\" id=\"specifications\"><div class=\"shell\"><div class=\"eyebrow\">03 \u00b7 Materials and construction</div><h2>What's Included in Your Country Cottage with Shed Dormer</h2><p class=\"muted\" style=\"max-width:850px\">A practical construction package designed around weather protection, utility, and everyday use. Final framing and supports vary as required by building dimensions and site conditions.</p><div class=\"specgrid\"><div class=\"spec\"><h3>Foundation Supports</h3><p>4\u00d76 pressure-treated foundation beams supported on 16\u2033 \u00d7 16\u2033 \u00d7 4\u2033 solid concrete pads on qualifying sites.</p></div><div class=\"spec\"><h3>Floor Construction</h3><p>2\u00d76 pressure-treated floor joists at 16\u2033 on center with \u00be\u2033 exterior-grade plywood decking, subject to size-specific structural requirements.</p></div><div class=\"spec\"><h3>Roof Structure</h3><p>Main gable roof designed with a 9/12 pitch and a distinctive shed dormer. Roof framing and dormer connections are engineered for the selected dimensions; \u00bd\u2033 CDX roof sheathing where specified.</p></div><div class=\"spec\"><h3>Roof Finish</h3><p>Architectural roof shingles with a selection of available colors. Specific material warranties are provided by the manufacturer.</p></div><div class=\"spec\"><h3>Windows &amp; Doors</h3><p>Two 24\u2033 \u00d7 30\u2033 aluminum-framed windows with screens and locks, plus a 5\u2032 \u00d7 80\u2033 Craftsman-style double-door unit with keyed hardware.</p></div><div class=\"spec\"><h3>Exterior &amp; Details</h3><p>Standard Roseburg DuraTemp wood siding, cedar trim and decorative shutters, with screened louver ventilation.</p></div></div></div></section>\n<section class=\"section white\" id=\"design\"><div class=\"shell twocol\"><div><div class=\"eyebrow\">04 \u00b7 A timeless utility shed</div><h2>A Cottage Roofline with Lasting Character.</h2><p>The Country Cottage with Shed Dormer celebrates the straightforward usefulness of a cottage with a prominent main gable and shed dormer. Its welcoming entry, generous windows, and wood-textured exterior make it a natural fit for garden tools, seasonal storage, and hobby supplies.</p><div class=\"feature-list\"><div><b>Cottage roofline</b>9/12 main gable pitch</div><div><b>Welcoming entry</b>Craftsman double doors</div><div><b>Natural light</b>Two 24\u2033 \u00d7 30\u2033 windows</div><div><b>Exterior character</b>Traditional cottage detailing</div></div><a class=\"btn pine\" href=\"#gallery\">View Exterior Gallery</a></div><div><img alt=\"Country Cottage with Shed Dormer in an autumn residential backyard \u2014 architectural exterior reference\" src=\"/standard-features/country-cottage-with-shed-dormer.png\" style=\"width:100%;aspect-ratio:4/3;object-fit:cover\"/></div></div></section>\n<section class=\"section soft\" id=\"gallery\"><div class=\"shell\"><div class=\"eyebrow\">05 \u00b7 Exterior gallery</div><h2>Exterior Gallery</h2><p class=\"muted\" style=\"max-width:810px\">A closer look at the Country Cottage with Shed Dormer. Additional exterior photographs and finish examples will be added as they become available; siding and colors are confirmed in your written proposal.</p><div class=\"gallery\"><figure><img alt=\"Country Cottage with Shed Dormer in an autumn residential backyard \u2014 architectural exterior reference\" loading=\"lazy\" src=\"/gallery/model-photos/country-cottage-with-shed-dormer/01-full-exterior-view.jpg\"/><figcaption>Country Cottage with Shed Dormer \u2014 autumn exterior architectural view</figcaption></figure></div></div></section>\n<section class=\"section white\" id=\"construction-showcase\"><div class=\"shell\">\n<div class=\"eyebrow\">06 \u00b7 Our craftsmanship</div>\n<h2>Built Better \u2014 From the Inside Out</h2>\n<p class=\"muted\" style=\"max-width:870px\">The beauty of a Country Cottage with Shed Dormer begins long before the exterior is complete. Explore the foundation, floor framing, wall construction, roof structure, and weather protection that make every detail count.</p>\n<div class=\"asi-construction-feature\">\n<div class=\"asi-construction-copy\"><span class=\"asi-construction-kicker\">A closer look at our construction</span><h3>One standard of craftsmanship. Every Appalachian Sheds model.</h3><p>Discover how thoughtful planning, pressure-treated floor framing, dependable roof construction, and careful weather protection contribute to the quality of our buildings.</p><a class=\"btn pine\" href=\"/craft/\">Explore Our Superior Construction \u2192</a></div>\n<div class=\"asi-construction-highlights\"><div><strong>Foundation &amp; floor</strong><span>Pressure-treated framing and solid concrete support pads</span></div><div><strong>Walls &amp; roof</strong><span>Purpose-built structure suited to the model and site</span></div><div><strong>Weather protection</strong><span>Roofing, flashing, ventilation, and exterior detailing</span></div></div>\n</div>\n<div class=\"asi-shell-disclosure\"><strong>Exterior weather-tight shell.</strong> Standard pricing covers an on-site-built exterior weather-tight shell only, not finished interior walls or ceilings. Exterior caulking and painting or staining are required within 30 days of completion. Ask about our optional exterior finishing service and separately quoted interior improvements.</div>\n</div></section>\n<section class=\"section soft\" id=\"options\"><div class=\"shell\"><div class=\"eyebrow\">07 \u00b7 Make it yours</div><h2>Options &amp; Site Planning</h2><p class=\"muted\" style=\"max-width:850px\">Your price starts with the standard 9/12 main roof, DuraTemp wood siding and the included construction package. Customization is handled through a clear written proposal.</p><div class=\"small-cards\"><article class=\"small-card\"><span class=\"tag\">Exterior selections</span><h3>Five Siding Choices</h3><p>Choose the included DuraTemp wood finish or compare four alternative siding selections in the calculator.</p></article><article class=\"small-card\"><span class=\"tag\">Architectural choices</span><h3>Roof &amp; Design Options</h3><p>The classic 9/12 main roof is standard. Ask about available roof and architectural changes for your chosen dimensions.</p></article><article class=\"small-card\"><span class=\"tag\">Property conditions</span><h3>Site &amp; Pad Preparation</h3><p>Standard support pads are included for qualifying sites. Additional grading, clearing and pad preparation can be considered in your proposal.</p></article></div></div></section>\n<section class=\"section white\" id=\"heights\"><div class=\"shell\"><div class=\"eyebrow\">08 \u00b7 Plan for your property</div><h2>Building Heights &amp; Site Planning</h2><p>Overall building height varies with building width, the 9/12 main gable roof, shed dormer configuration, and final site conditions. We will confirm the exact height in your written proposal and site plan before construction.</p><p>Local zoning, setbacks, and other site requirements are considered during property review.</p><p><a class=\"btn\" href=\"#proposal\">Request a Property Walk-Through</a></p></div></section>\n<section class=\"section soft\" id=\"questions\"><div class=\"shell\"><div class=\"eyebrow\">09 \u00b7 Good questions, clear answers</div><h2>Frequently Asked Questions</h2><div style=\"max-width:970px\"><details class=\"details\"><summary>Is Roseburg DuraTemp included in the displayed starting price?</summary><p>Yes. DuraTemp wood siding is the standard siding selection and is preselected in the calculator. Four additional siding selections are available for comparison.</p></details><details class=\"details\"><summary>Will my Country Cottage with Shed Dormer be built at my property?</summary><p>Yes. Appalachian Sheds constructs the Country Cottage with Shed Dormer on site with a qualified crew. The final scope and schedule are confirmed in writing.</p></details><details class=\"details\"><summary>What is included in the foundation price?</summary><p>The standard construction package includes 4\u00d76 pressure-treated foundation beams on 16\u2033 \u00d7 16\u2033 \u00d7 4\u2033 solid concrete support pads for qualifying sites. The existing grade should not exceed a 6\u2033 variation across the building footprint for standard leveling. Additional work is quoted separately.</p></details><details class=\"details\"><summary>Are the two windows and double doors included?</summary><p>Yes. The standard Country Cottage with Shed Dormer configuration includes two 24\u2033 \u00d7 30\u2033 windows and a 5\u2032 Craftsman-style double-door unit, as described in the specifications.</p></details><details class=\"details\"><summary>Can I choose a steeper roof pitch?</summary><p>The listed prices are for the standard 9/12 main roof. Other roof configurations may be reviewed through a custom written proposal, subject to design feasibility and confirmed pricing.</p></details><details class=\"details\"><summary>How do warranties work?</summary><p>Appalachian Sheds provides a written warranty covering the applicable work and terms. Individual material manufacturers may provide separate warranties. Review the written warranty and relevant manufacturer documentation with your proposal.</p></details><details class=\"details\"><summary>Will I know about site preparation costs before building begins?</summary><p>We recommend a property walk-through to review access, grade, support conditions and any preparation needed. Additional site work and the agreed project scope are identified in writing.</p></details></div></div></section>\n<section class=\"section proposal\" id=\"proposal\"><div class=\"shell proposal-grid\"><div><div class=\"eyebrow\">10 \u00b7 The next step</div><h2>Let's Talk About Your Country Cottage with Shed Dormer.</h2><p>A helpful conversation about your property, the building size and your plans is the best way to establish a clear project scope.</p><p>Choose a written proposal or request a property walk-through. Your current calculator selections can be included in your request.</p><div class=\"rule\" style=\"background:#ffffff38\"></div><p class=\"mini\">Veteran &amp; family-owned \u00b7 Serving Greater Cincinnati and the surrounding Tri-State area.</p></div><div class=\"request-card\"><h3>Prepare Your Request</h3><div class=\"field\"><label for=\"requestType\">I'd like to</label><select id=\"requestType\"><option value=\"Request a Written Proposal\">Request a Written Proposal</option><option value=\"Request a Property Walk-Through\">Request a Property Walk-Through</option></select></div><div class=\"pickgrid\"><div class=\"field\"><label for=\"customerName\">Name</label><input autocomplete=\"name\" id=\"customerName\" placeholder=\"Your name\"/></div><div class=\"field\"><label for=\"customerContact\">Email or phone</label><input autocomplete=\"email\" id=\"customerContact\" placeholder=\"Best way to reach you\"/></div></div><div class=\"field\"><label for=\"customerCity\">Project city or ZIP</label><input id=\"customerCity\" placeholder=\"Property location\"/></div><div class=\"field\"><label for=\"customerNote\">What should we know about your project?</label><textarea id=\"customerNote\" placeholder=\"Intended use, site access, grade, additional features, or questions\"></textarea></div><div class=\"request-actions\"><button class=\"btn pine\" id=\"prepareRequest\" type=\"button\">Prepare Request Summary</button><button class=\"btn alt\" disabled=\"\" id=\"copyRequest\" style=\"color:#294432\" type=\"button\">Copy Summary</button><button class=\"btn alt\" disabled=\"\" id=\"downloadRequest\" style=\"color:#294432\" type=\"button\">Save Summary</button></div><div class=\"output\" hidden=\"\" id=\"requestOutput\" role=\"status\"></div><p class=\"privacy\">This preview prepares your request locally in your browser; it does not send personal information or submit an inquiry. Save or copy your summary to share with Appalachian Sheds.</p></div></div></section>\n</main><section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n<footer class=\"footer\"><div class=\"shell footer-inner\"><div><strong>Appalachian Sheds Inc.</strong><br/>Premium Appalachian-inspired backyard buildings \u00b7 Cincinnati, Ohio</div><div><a href=\"#top\">Back to top \u2191</a> \u00a0 \u00b7 \u00a0 <a href=\"#pricing\">Model pricing</a> \u00a0 \u00b7 \u00a0 <a href=\"#features\">Standard features</a></div></div></footer>\n\n"} />
</Base>

