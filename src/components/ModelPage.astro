---
// One template for every model page. Each model supplies its own words, photo and price file.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { business, link } from '../data/site.js';
import { sidings, readPrices, money, sizeLabel, notIncluded } from '../data/models.js';

const { model } = Astro.props;
const p = readPrices(model.prices);
const url = 'https://appalachiansheds.com' + model.path;
const widths = [...new Set(p.sizes.map((s) => s.width))];
const priceNote = p.approved
  ? `Standard build prices effective ${model.effective}, subject to change.`
  : `Standard build prices effective ${model.effective} and currently being confirmed; they may change.`;
const fill = (s) => s.replaceAll('{low}', money(p.low)).replaceAll('{count}', String(p.sizes.length)).replaceAll('{range}', p.sizeRange);

const schema = [
  {
    '@type': 'ProductModel',
    '@id': url + '#model',
    name: model.name,
    url,
    description: fill(model.schemaDescription),
    brand: { '@id': business.id },
    manufacturer: { '@id': business.id },
    ...(model.photo && { image: new URL(model.photo.src, Astro.site).href }),
    isRelatedTo: { '@type': 'Service', name: 'Appalachian Sheds 30-Year Structural Warranty', provider: { '@id': business.id } },
    // Price range is published only once Edwin has approved the price list.
    ...(p.approved && {
      offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: p.low, highPrice: p.high, offerCount: p.count, seller: { '@id': business.id } },
    }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://appalachiansheds.com/' },
      { '@type': 'ListItem', position: 2, name: 'Buildings & Pricing', item: 'https://appalachiansheds.com/buildings/' },
      { '@type': 'ListItem', position: 3, name: model.name, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: model.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const calcData = { model: model.name, sizes: p.sizes, sidings: sidings.map(({ code, slug, name }) => ({ code, slug, name })), phone: business.phoneLink };
---
<Base title={model.title} description={fill(model.description)} path={model.path} schema={schema}>
  <!-- 01 HERO -->
  <section class="band band--dark cl-hero" aria-labelledby="cl-title">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={link('/')}>Home</a> <span aria-hidden="true">/</span> <a href={link('/buildings/')}>Buildings</a> <span aria-hidden="true">/</span> <span aria-current="page">{model.shortName}</span></nav>
      <div class={model.photo ? 'cl-hero__grid' : 'cl-hero__single'}>
        <div>
          <p class="eyebrow">Appalachian Sheds · {model.series}</p>
          <h1 id="cl-title">{model.name}</h1>
          <p class="cl-hero__answer">{fill(model.answer)}</p>
        </div>
        {model.photo && (
          <figure class="cl-hero__media">
            <Image src={model.photo} alt={model.photoAlt} widths={[480, 800, 1080]} sizes="(max-width: 900px) 94vw, 46vw" format="webp" quality={82} loading="eager" fetchpriority="high" />
            {model.photoCaption && <figcaption>{model.photoCaption}</figcaption>}
          </figure>
        )}
      </div>
      <ul class="cl-facts">
        <li><strong>{p.sizes.length}</strong><span>sizes</span></li>
        <li><strong>5</strong><span>siding choices</span></li>
        <li><strong>{money(p.low)}</strong><span>starting price</span></li>
        <li><strong>30-Year</strong><span>structural warranty</span></li>
      </ul>
      <div class="cl-ctas">
        <a class="btn btn--primary" href="#price">See Your Price</a>
        <a class="btn btn--secondary" href={`tel:${business.phoneLink}`}>Call Edwin · {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- 02 CALCULATOR -->
  <section class="band band--light" id="price" aria-labelledby="calc-title">
    <div class="wrap">
      <p class="eyebrow">Standard Build Pricing · All Five Sidings</p>
      <h2 id="calc-title" class="sec-title">See Your {model.shortName} Price</h2>
      <p class="sec-lead">Pick a width, then a length. All five siding prices appear at once for that exact building. No form and no waiting on a quote.</p>
      <div class="calc" data-calc>
        <div class="calc__step">
          <h3 class="calc__label"><span>1</span> Choose your width</h3>
          <div class="calc__options" role="group" aria-label="Width in feet" data-widths>
            {widths.map((w) => <button type="button" class="opt" data-width={w} aria-pressed="false">{w}′ wide</button>)}
          </div>
        </div>
        <div class="calc__step">
          <h3 class="calc__label"><span>2</span> Choose your length</h3>
          <div class="calc__options" role="group" aria-label="Length in feet" data-lengths>
            <p class="calc__hint">Choose a width first. Only the lengths built at that width will appear.</p>
          </div>
        </div>
        <div class="calc__step">
          <h3 class="calc__label"><span>3</span> Compare and choose a siding</h3>
          <div class="calc__sidings" role="group" aria-label="Siding" data-sidings>
            {sidings.map((s) => (
              <button type="button" class="siding" data-code={s.code} aria-pressed="false" disabled>
                <span class="siding__name">{s.name}</span>
                <span class="siding__price" data-price-for={s.code}>—</span>
              </button>
            ))}
          </div>
        </div>
        <div class="calc__result" aria-live="polite" data-result>
          <p class="calc__result-empty">Your selected building and price will appear here.</p>
        </div>
        <div class="calc__actions">
          <a class="btn btn--primary" href={`sms:${business.phoneLink}`} data-send>Text Edwin Your Selection</a>
          <a class="btn btn--secondary" href={`tel:${business.phoneLink}`}>Call Edwin</a>
          <button type="button" class="btn btn--secondary" data-reset>Start over</button>
        </div>
        <p class="calc__note">{priceNote} Prices are standard build estimates for the exterior structure. Your final written price is confirmed after site access, placement, finish selections and any requested upgrades are reviewed.</p>
      </div>
    </div>
  </section>

  <!-- 03 FULL PRICE SHEET -->
  <section class="band band--cash" aria-labelledby="sheet-title">
    <div class="wrap">
      <p class="eyebrow">Complete Price Sheet</p>
      <h2 id="sheet-title" class="sec-title">Every Size, Every Siding, on One Page</h2>
      <details class="sheet">
        <summary>Open the complete {model.shortName} price sheet: {p.sizes.length} sizes × 5 sidings</summary>
        <div class="sheet__scroll">
          <table>
            <caption>{model.name} standard build prices by size and siding</caption>
            <thead><tr><th scope="col">Size</th>{sidings.map((s) => <th scope="col">{s.short}</th>)}</tr></thead>
            <tbody>
              {p.sizes.map((z) => <tr><th scope="row">{sizeLabel(z.width, z.length)}</th>{sidings.map((s) => <td>{money(z.prices[s.code])}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
        <p class="sheet__note">{priceNote} Options, site conditions, access and custom requirements are reviewed before a final written price.</p>
      </details>
    </div>
  </section>

  <!-- 04 WHAT'S INCLUDED -->
  <section class="band band--dark" aria-labelledby="inc-title">
    <div class="wrap">
      <p class="eyebrow">Standard Construction · What the Price Covers</p>
      <h2 id="inc-title" class="sec-title">What Every {model.shortName} Includes</h2>
      <p class="sec-lead sec-lead--dark">Everything below is part of the standard building, not an upgrade added later to make the starting price look lower.</p>
      <div class="inc">
        <table class="inc__table">
          <caption class="sr">Standard construction and features of the {model.name}</caption>
          <tbody>{model.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
        <div class="inc__not">
          <h3>Not included in the standard price</h3>
          <p>{notIncluded}</p>
          {model.optionalNote && <><h3>Optional, not standard</h3><p>{model.optionalNote}</p></>}
          <h3>Compare the building, not just the price</h3>
          <ul>
            <li>Foundation beam size and material</li>
            <li>Floor joist size and spacing</li>
            <li>Floor decking material</li>
            <li>Wall stud size and spacing</li>
            <li>Wall sheathing and roof-to-wall connections</li>
            <li>Roof framing and sheathing</li>
            <li>What is standard versus what costs extra</li>
            <li>Structural warranty coverage</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 SIDING -->
  <section class="band band--light" aria-labelledby="sid-title">
    <div class="wrap">
      <p class="eyebrow">Exterior Appearance · Five Siding Choices</p>
      <h2 id="sid-title" class="sec-title">Choose the Siding That Fits Your Property</h2>
      <p class="sec-lead">{model.sidingLead}</p>
      <div class="cards">
        {sidings.map((s) => (
          <article class="card">
            <p class="card__kicker">{s.label}</p>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <p class="card__fit"><strong>Best fit:</strong> {s.fit}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 IS IT THE RIGHT BUILDING -->
  <section class="band band--cash" aria-labelledby="fit-title">
    <div class="wrap">
      <p class="eyebrow">Best Fit</p>
      <h2 id="fit-title" class="sec-title">Is the {model.shortName} the Right Building?</h2>
      <p class="sec-lead">{model.fitLead}</p>
      <div class="fit__scroll">
        <table class="fit">
          <thead><tr><th scope="col">Project goal</th><th scope="col">{model.shortName} fit</th><th scope="col">What to consider</th></tr></thead>
          <tbody>
            {model.fit.map(([g, f, c]) => <tr><th scope="row">{g}</th><td class={'fit__tag fit__tag--' + f.split(' ')[0].toLowerCase()}>{f}</td><td>{c}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="band band--light" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="eyebrow">{model.shortName} FAQ</p>
      <h2 id="faq-title" class="sec-title">The Questions That Usually Come Up</h2>
      <div class="faq">
        {model.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <!-- 08 BYLINE + CTA -->
  <section class="band band--dark cl-cta" aria-labelledby="cta-title">
    <div class="wrap">
      <p class="eyebrow">Next Step</p>
      <h2 id="cta-title" class="sec-title">Talk Through Your {model.shortName} With Edwin</h2>
      <p class="sec-lead sec-lead--dark">If you have a size and siding in mind, the most useful next conversation is about your property: where the building will sit, how the crew will reach it, what you will store, and which options are worth adding.</p>
      <div class="cl-ctas">
        <a class="btn btn--primary" href={`tel:${business.phoneLink}`}>Call Edwin · {business.phoneDisplay}</a>
        <a class="btn btn--secondary" href={`sms:${business.phoneLink}`}>Text Edwin</a>
      </div>
      <p class="byline">Specifications reviewed by {business.founder.name}, U.S. Army veteran and founder of Appalachian Sheds Inc. {business.experience}. Veteran-owned and family-operated, building on site across {business.serviceArea}.</p>
    </div>
  </section>

  <script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)} />
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('calc-data').textContent);
      var root = document.querySelector('[data-calc]');
      var lengthsBox = root.querySelector('[data-lengths]');
      var result = root.querySelector('[data-result]');
      var send = root.querySelector('[data-send]');
      var state = { w: null, l: null, s: null };
      var fmt = function (n) { return '$' + n.toLocaleString('en-US'); };
      var bySlug = {}; data.sidings.forEach(function (s) { bySlug[s.slug] = s; });
      var size = function () { return data.sizes.find(function (z) { return z.width === state.w && z.length === state.l; }); };

      function press(group, attr, value) {
        group.querySelectorAll('button').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute(attr) === String(value))); });
      }
      function renderLengths() {
        if (state.w === null) { lengthsBox.innerHTML = '<p class="calc__hint">Choose a width first. Only the lengths built at that width will appear.</p>'; return; }
        lengthsBox.innerHTML = '';
        data.sizes.filter(function (z) { return z.width === state.w; }).forEach(function (z) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'opt'; b.setAttribute('data-length', z.length);
          b.setAttribute('aria-pressed', String(z.length === state.l));
          b.textContent = z.length + '′ long';
          b.addEventListener('click', function () { state.l = z.length; state.s = state.s; render(); });
          lengthsBox.appendChild(b);
        });
      }
      function render() {
        press(root.querySelector('[data-widths]'), 'data-width', state.w);
        renderLengths();
        var z = state.w !== null && state.l !== null ? size() : null;
        root.querySelectorAll('[data-sidings] button').forEach(function (b) {
          var code = b.getAttribute('data-code');
          b.disabled = !z;
          b.setAttribute('aria-pressed', String(z && state.s === code));
          b.querySelector('[data-price-for]').textContent = z ? fmt(z.prices[code]) : '—';
        });
        var params = new URLSearchParams();
        if (z && state.s) {
          var sd = data.sidings.find(function (s) { return s.code === state.s; });
          var label = state.w + '′ × ' + state.l + '′';
          var price = fmt(z.prices[state.s]);
          result.innerHTML = '<p class="calc__result-size">' + data.model + ' · ' + label + '</p><p class="calc__result-price">' + price + '</p><p class="calc__result-siding">with ' + sd.name + '</p>';
          var msg = 'Hi Edwin, I am interested in the ' + data.model + ', ' + state.w + 'x' + state.l + ' with ' + sd.name + ' (' + price + ' standard build price).';
          send.href = 'sms:' + data.phone + '?&body=' + encodeURIComponent(msg);
          params.set('w', state.w); params.set('l', state.l); params.set('s', sd.slug);
        } else {
          result.innerHTML = z
            ? '<p class="calc__result-empty">' + state.w + '′ × ' + state.l + '′ selected. Choose a siding to see your price.</p>'
            : '<p class="calc__result-empty">Your selected building and price will appear here.</p>';
          send.href = 'sms:' + data.phone;
          if (state.w !== null) params.set('w', state.w);
          if (z) params.set('l', state.l);
        }
        var q = params.toString();
        history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
      }
      root.querySelectorAll('[data-widths] button').forEach(function (b) {
        b.addEventListener('click', function () {
          var w = Number(b.getAttribute('data-width'));
          if (w !== state.w) { state.w = w; state.l = null; state.s = null; }
          render();
        });
      });
      root.querySelectorAll('[data-sidings] button').forEach(function (b) {
        b.addEventListener('click', function () { state.s = b.getAttribute('data-code'); render(); });
      });
      root.querySelector('[data-reset]').addEventListener('click', function () { state = { w: null, l: null, s: null }; render(); });

      // Restore a shared link such as ?w=10&l=12&s=roseburg-duratemp; invalid values are ignored.
      var p = new URLSearchParams(location.search);
      var w = Number(p.get('w')), l = Number(p.get('l')), s = bySlug[p.get('s')];
      if (data.sizes.some(function (z) { return z.width === w; })) {
        state.w = w;
        if (data.sizes.some(function (z) { return z.width === w && z.length === l; })) {
          state.l = l;
          if (s) state.s = s.code;
        }
      }
      render();
    })();
  </script>
</Base>

<!-- Global so the calculator buttons and results created by the script are styled too. -->
<style is:global>
  .crumbs { font-size: 0.85rem; color: var(--stone); margin-bottom: 26px; }
  .crumbs a { color: var(--cashmere); text-decoration: none; }
  .crumbs a:hover { color: var(--bronze); }
  .cl-hero { border-top: 0; padding-top: 40px; }
  .cl-hero h1 { margin: 0 0 20px; font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.1; }
  .cl-hero__single { max-width: 900px; }
  .cl-hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 8px; }
  .cl-hero__media { margin: 0 0 32px; }
  .cl-hero__media img { display: block; width: 100%; height: auto; border: 2px solid var(--bronze); }
  .cl-hero__media figcaption { margin-top: 10px; font-size: 0.85rem; color: var(--stone); font-weight: 700; }
  @media (max-width: 900px) { .cl-hero__grid { grid-template-columns: 1fr; gap: 0; } .cl-hero__media { order: -1; } }
  .cl-hero__answer { max-width: 70ch; margin: 0 0 30px; font-size: 1.08rem; line-height: 1.75; color: var(--cashmere); font-weight: 600; }
  .cl-facts { list-style: none; margin: 0 0 32px; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border: 1px solid rgba(166, 138, 106, 0.5); }
  .cl-facts li { padding: 18px 20px; border-right: 1px solid rgba(166, 138, 106, 0.5); }
  .cl-facts li:last-child { border-right: 0; }
  .cl-facts strong { display: block; font-size: 1.6rem; font-weight: 900; color: var(--ivory); }
  .cl-facts span { font-size: 0.85rem; color: var(--stone); font-weight: 800; }
  .cl-ctas { display: flex; flex-wrap: wrap; gap: 14px; }

  .sec-title { margin: 0 0 14px; font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .sec-lead { max-width: 72ch; margin: 0 0 34px; font-size: 1.04rem; font-weight: 700; }
  .sec-lead--dark { color: var(--cashmere); font-weight: 600; }

  .calc { background: #fff; border: 1px solid var(--stone); border-top: 4px solid var(--bronze); padding: 32px; }
  .calc__step { margin-bottom: 28px; }
  .calc__label { margin: 0 0 12px; font-size: 1.05rem; display: flex; align-items: center; gap: 10px; }
  .calc__label span { display: inline-grid; place-items: center; width: 30px; height: 30px; background: var(--steel); color: var(--ivory); font-size: 0.9rem; }
  .calc__options { display: flex; flex-wrap: wrap; gap: 10px; }
  .calc__hint { margin: 0; color: #5a554e; font-weight: 700; }
  .opt { font: inherit; font-weight: 900; padding: 12px 18px; background: var(--ivory); color: var(--steel); border: 2px solid var(--stone); cursor: pointer; }
  .opt:hover { border-color: var(--bronze); }
  .opt[aria-pressed='true'] { background: var(--steel); color: var(--ivory); border-color: var(--steel); }
  .calc__sidings { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .siding { font: inherit; text-align: left; padding: 16px; background: var(--ivory); color: var(--steel); border: 2px solid var(--stone); cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; min-height: 118px; }
  .siding:disabled { cursor: not-allowed; opacity: 0.6; }
  .siding:not(:disabled):hover { border-color: var(--bronze); }
  .siding[aria-pressed='true'] { background: var(--steel); color: var(--ivory); border-color: var(--bronze); }
  .siding__name { font-weight: 800; font-size: 0.88rem; line-height: 1.35; }
  .siding__price { font-weight: 900; font-size: 1.35rem; }
  .calc__result { background: var(--steel); color: var(--ivory); padding: 22px 26px; margin-bottom: 18px; border-left: 4px solid var(--bronze); min-height: 92px; }
  .calc__result p { margin: 0; }
  .calc__result-empty { color: var(--cashmere); font-weight: 700; }
  .calc__result-size { font-weight: 800; color: var(--cashmere); }
  .calc__result-price { font-size: 2.2rem; font-weight: 900; color: var(--ivory); line-height: 1.2; }
  .calc__result-siding { font-weight: 700; color: var(--stone); }
  .calc__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  .calc__actions .btn--secondary { color: var(--steel); }
  .calc__note { margin: 0; font-size: 0.9rem; color: #4a463f; font-weight: 700; }

  .sheet { background: #fff; border: 1px solid var(--stone); }
  .sheet summary { cursor: pointer; padding: 18px 22px; font-weight: 900; list-style-position: inside; }
  .sheet__scroll, .fit__scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  .sheet table { min-width: 760px; font-size: 0.92rem; }
  .sheet caption { text-align: left; padding: 0 22px 10px; font-weight: 800; color: #4a463f; }
  .sheet th, .sheet td { padding: 10px 14px; border-top: 1px solid var(--cashmere); text-align: right; font-weight: 800; }
  .sheet thead th { background: var(--steel); color: var(--ivory); font-weight: 900; text-align: right; font-size: 0.82rem; }
  .sheet th[scope='row'], .sheet thead th:first-child { text-align: left; }
  .sheet tbody tr:nth-child(even) { background: var(--ivory); }
  .sheet__note { margin: 0; padding: 14px 22px 20px; font-size: 0.88rem; color: #4a463f; font-weight: 700; }

  .inc { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start; }
  .inc__table { background: var(--ivory); color: var(--steel); border-top: 4px solid var(--bronze); }
  .inc__table th, .inc__table td { padding: 12px 18px; border-bottom: 1px solid var(--cashmere); text-align: left; vertical-align: top; font-size: 0.95rem; }
  .inc__table th { width: 36%; font-weight: 900; }
  .inc__table td { font-weight: 700; }
  .inc__not { border: 1px solid rgba(166, 138, 106, 0.55); padding: 26px; }
  .inc__not h3 { margin: 0 0 10px; font-size: 1.05rem; color: var(--ivory); }
  .inc__not p { margin: 0 0 24px; color: var(--cashmere); font-weight: 600; }
  .inc__not ul { margin: 0; padding-left: 20px; color: var(--cashmere); font-weight: 600; }
  .inc__not li { margin-bottom: 6px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .card { background: #fff; border: 1px solid var(--stone); border-top: 4px solid var(--bronze); padding: 22px; }
  .card__kicker { margin: 0 0 8px; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bronze-dark); font-weight: 900; }
  .card h3 { margin: 0 0 10px; font-size: 1.08rem; }
  .card p { margin: 0 0 12px; font-size: 0.95rem; }
  .card__fit { margin-bottom: 0 !important; padding-top: 12px; border-top: 1px solid var(--cashmere); }

  .fit { background: #fff; min-width: 640px; }
