:root{--dark:#2B3030;--dark2:#202827;--cream:#F8F7F4;--paper:#FFFFFF;--bronze:#C9A06C;--wood:#4b3427;--ink:#242b26;--muted:#59635a;--line:#E1DED8;--pine:#2E473A;--pale:#E1DED8;--font:Montserrat,Arial,Helvetica,sans-serif;--serif:Merriweather,Georgia,'Times New Roman',serif}
