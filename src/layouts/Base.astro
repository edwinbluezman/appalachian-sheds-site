---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Appalachian Sheds Inc. — veteran-owned, family-operated backyard buildings built on site in the Greater Cincinnati Tri-State area." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@1,400;1,700&family=Montserrat:ital,wght@1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="asi-global-header" role="banner">
    <div class="asi-nav-shell">
      <a href="/" class="asi-brand" aria-label="Appalachian Sheds home">
        <strong>APPALACHIAN SHEDS INC.</strong>
        <span>VETERAN &amp; FAMILY-OWNED &middot; BUILT ON SITE</span>
      </a>
      <button type="button" class="asi-menu-toggle" aria-controls="asi-nav-primary" aria-expanded="false">&#9776; Menu</button>
      <nav class="asi-nav-links" id="asi-nav-primary" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/buildings/">Buildings &amp; Pricing</a>
        <a href="/planning-guides/">Building Guides</a>
        <a href="/options-upgrades/">Options &amp; Upgrades</a>
        <a href="/craft/">Built Better</a>
        <a href="/buildings/#the-collection" class="asi-nav-cta">See Your Price</a>
      </nav>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="asi-footer-inner">
      <p class="asi-footer-brand">Appalachian Sheds Inc.</p>
      <p>Veteran-Owned &middot; Family-Operated &middot; Serving Greater Cincinnati and the Ohio, Kentucky &amp; Indiana Tri-State</p>
      <p><a href="tel:+15133792421">(513) 379-2421</a> &middot; <a href="mailto:edwin@appalachiansheds.com">edwin@appalachiansheds.com</a></p>
      <p class="asi-footer-copy">&copy; 2026 Appalachian Sheds Inc. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      function boot() {
        var header = document.querySelector('.asi-global-header');
        var toggle = document.querySelector('.asi-menu-toggle');
        var links = document.querySelector('.asi-nav-links');
        if (toggle && links) {
          toggle.addEventListener('click', function () {
            var open = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.setAttribute('aria-expanded', String(open));
            links.classList.toggle('asi-open', open);
          });
          links.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () {
              links.classList.remove('asi-open');
              toggle.setAttribute('aria-expanded', 'false');
            });
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              links.classList.remove('asi-open');
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
        }
        var button = document.createElement('button');
        button.className = 'asi-back-to-top';
        button.type = 'button';
        button.setAttribute('aria-label', 'Back to top');
        button.textContent = '↑';
        document.body.appendChild(button);
        function update() {
          var y = Math.max(window.scrollY || 0, document.documentElement.scrollTop || 0);
          button.classList.toggle('asi-show', y > 480);
          if (header) header.classList.toggle('asi-is-scrolled', y > 36);
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
        button.addEventListener('click', function () {
          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'instant' : 'smooth' });
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
      else boot();
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --asi-ink: #2B3030;
    --asi-ink-dark: #202827;
    --asi-cream: #F8F7F4;
    --asi-paper: #FFFFFF;
    --asi-sand: #E1DED8;
    --asi-gold: #C9A06C;
    --asi-pine: #2E473A;
    font-family: 'Montserrat', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--asi-cream); color: var(--asi-ink); -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }

  /* Shared site header — this is the ASI "site-controls.css" stylesheet found
     alongside the options/guides pages (the later, finished iteration of this
     build); the homepage/model pages referenced this same nav markup but had
     no stylesheet for it. Using the real one here, site-wide. */
  .asi-global-header { display:block!important; padding:0!important; margin:0!important; flex-wrap:nowrap!important; position:sticky!important; top:0!important; z-index:2147481000!important; background:var(--asi-ink); color:var(--asi-cream); box-shadow:0 2px 12px rgba(0,0,0,.18); width:100%; font:italic 500 13px/1.45 'Montserrat',Arial,sans-serif; transition:box-shadow .18s ease; }
  .asi-global-header * { box-sizing:border-box; }
  .asi-global-header a { color:#F8F7F4; text-decoration:none; }
  .asi-global-header .asi-nav-shell { width:94%; max-width:1440px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:22px; min-height:78px; padding:12px 0; transition:min-height .18s ease,padding .18s ease; }
  .asi-global-header.asi-is-scrolled .asi-nav-shell { min-height:57px; padding:7px 0; }
  .asi-brand { display:flex; flex-direction:column; gap:3px; line-height:1.2; white-space:nowrap; }
  .asi-brand strong { font-size:16px; letter-spacing:.03em; font-weight:700; }
  .asi-brand span { font-size:9px; letter-spacing:.10em; color:#E3C6A1; }
  .asi-nav-links { display:flex; align-items:center; justify-content:flex-end; gap:clamp(12px,2vw,27px); }
  .asi-nav-links a { padding:10px 1px; font-size:12px; font-weight:600; }
  .asi-nav-links a:hover, .asi-nav-links a[aria-current="page"] { color:#E8C99E; }
  .asi-nav-links .asi-nav-cta { background:#D8BB93; color:#24302B; padding:11px 17px; border-radius:4px; font-weight:700; text-align:center; }
  .asi-nav-links .asi-nav-cta:hover { background:#F0D2AA; color:#24302B; }
  .asi-global-header a:focus-visible, .asi-global-header button:focus-visible, .asi-back-to-top:focus-visible { outline:3px solid #F1BC76; outline-offset:3px; }
  .asi-menu-toggle { display:none; appearance:none; border:1px solid #8F9691; border-radius:4px; padding:9px 13px; background:transparent; color:white; font:inherit; cursor:pointer; }
  .asi-back-to-top { position:fixed; bottom:24px; right:24px; width:50px; height:50px; border:1px solid #C7AC8D; border-radius:50%; background:#29312F; color:#FFFFFF; box-shadow:0 4px 16px rgba(0,0,0,.3); z-index:2147483000; display:flex; align-items:center; justify-content:center; font:700 24px/1 Arial,sans-serif; cursor:pointer; opacity:0; visibility:hidden; transform:translateY(10px); transition:opacity .15s ease,transform .15s ease,visibility .15s; }
  .asi-back-to-top.asi-show { opacity:1; visibility:visible; transform:translateY(0); }
  .asi-back-to-top:hover { background:#43534A; }
  @media (max-width:780px) {
    .asi-global-header .asi-nav-shell { min-height:62px; padding:9px 0; flex-wrap:wrap; }
    .asi-brand strong { font-size:13px; }
    .asi-brand span { font-size:8px; }
    .asi-menu-toggle { display:block; margin-left:auto; }
    .asi-nav-links { display:none; flex-direction:column; align-items:stretch; gap:0; width:100%; padding:7px 0 13px; border-top:1px solid #58615B; }
    .asi-nav-links.asi-open { display:flex; }
    .asi-nav-links a { padding:11px 10px; }
    .asi-back-to-top { right:14px; bottom:15px; width:44px; height:44px; }
  }
  @media (prefers-reduced-motion:reduce) { .asi-global-header .asi-nav-shell, .asi-back-to-top { transition:none!important; } }
  html { scroll-padding-top:85px; }

  .footer { background:#1e2624; color:#ecede9; padding:48px 0; font-size:13px; margin-top: 60px; }
  .footer a { color:#e2bd8d; }
  .asi-footer-inner { width: 94%; max-width: 1440px; margin: 0 auto; line-height: 1.8; }
  .asi-footer-brand { font-weight: 700; font-size: 15px; letter-spacing: .03em; margin: 0 0 8px; color: #fff; }
  .asi-footer-copy { opacity: .6; margin-top: 14px; }
</style>
