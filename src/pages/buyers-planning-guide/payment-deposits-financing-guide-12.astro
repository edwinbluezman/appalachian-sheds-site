        { title: 'Building scope', list: ['Model and size confirmed', 'Standard features confirmed', 'Upgrades documented', 'Exclusions documented', 'Future-finish assumptions identified'] },
        { title: 'Site & responsibility', list: ['Access reviewed', 'Grade and drainage discussed', 'Foundation assumptions confirmed', 'Utility marking responsibility clear', 'Permit and HOA responsibility clear'] },
        { title: 'Money & documentation', list: ['Deposit purpose understood', 'Payment milestones documented', 'Financing terms reviewed', 'Change-order process understood', 'Final payment and walkthrough documented'] },
      ],
    },
