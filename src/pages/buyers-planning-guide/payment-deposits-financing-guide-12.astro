        { title: 'Document Changes & Completion', text: 'Changes in writing, a final walkthrough, then final payment as the agreement states.' },
      ],
    },
    {
      type: 'cards', id: 'categories', title: 'Separate the Structure, Site and Optional Work', nav: 'Budget Categories',
      items: [
        { title: 'Standard structure', text: 'The base model, size, shell, floor, walls, roof, standard siding, doors, windows and trim. Compare specifications, not just starting prices.' },
        { title: 'Optional upgrades', text: 'Doors, windows, roofing, porches, trim, lofts, shelving and accents, each with quantity, location and price confirmed before ordering.' },
        { title: 'Site preparation', text: 'Access, clearing, grading, drainage, gravel, concrete and leveling. Do not assume all site work is included.' },
        { title: 'Foundation & base', text: 'Beam system, gravel or concrete path, moisture separation and level assumptions.' },
        { title: 'Permits, HOA & utility marking', text: 'Who coordinates setbacks, neighborhood rules, local requirements and 811 before the date is set.' },
