@import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@1,400;1,700&family=Montserrat:ital,wght@1,400;1,500;1,600;1,700&display=swap');
:root{--ink:#2B3030;--deep:#202827;--paper:#F8F7F4;--mist:#E1DED8;--cream:#fff;--muted:#64706b;--bronze:#C9A06C;--line:#E1DED8;--borderdark:#ffffff24}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:italic 15px/1.7 'Montserrat',Arial,sans-serif}button,select,input,textarea{font:inherit}a{color:inherit}img{max-width:100%}h1{font:italic 700 clamp(33px,4.5vw,64px)/1.18 'Merriweather',Georgia,serif;letter-spacing:-.02em;margin:12px 0 20px}h2,h3,h4{font-family:'Montserrat',Arial,sans-serif;font-style:italic;line-height:1.3}h2{font-size:clamp(26px,3.1vw,39px);letter-spacing:-.035em;margin:7px 0 18px}h3{font-size:clamp(19px,2vw,25px);margin:6px 0 10px}p{margin:0 0 17px}.shell{width:94%;max-width:1440px;margin:auto}.bar{background:#1d2524;color:#faf7ee;padding:17px 0;letter-spacing:.13em;font-size:11px;font-weight:700}.bar-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.wordmark{font-size:13px;letter-spacing:.09em}.minor-link{font-size:11px;text-decoration:none;border-bottom:1px solid #ffffff66}.eyebrow{font-weight:700;letter-spacing:.18em;text-transform:uppercase;font-size:11px;color:#866e45}.dark .eyebrow{color:var(--bronze)}.subtle{color:var(--muted)}section{padding:76px 0}.dark{background:var(--ink);color:#fff}.dark p{color:#e0e3df}.soft{background:var(--mist)}.intro{max-width:780px;margin-bottom:34px}.hero{display:grid;grid-template-columns:.82fr 1.18fr;gap:46px;align-items:center;padding:55px 0 65px}.hero p{font-size:16px}.hero-visual{position:relative}.photo{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;border-radius:4px}.hero-photo{box-shadow:0 24px 55px #0002}.photo-label{position:absolute;bottom:17px;left:17px;max-width:70%;background:#202827ed;color:white;padding:10px 15px;border:1px solid #ffffff35;border-radius:3px;font-size:12px}.buttons{display:flex;flex-wrap:wrap;gap:11px;margin-top:25px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--ink);color:white;padding:13px 19px;border:1px solid var(--ink);border-radius:3px;font-size:12px;font-weight:700;text-decorati