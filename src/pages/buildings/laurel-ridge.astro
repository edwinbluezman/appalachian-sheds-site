eight-table td{padding:12px 16px;border-bottom:1px solid #d8dbd4;text-align:left}.height-table tr:nth-child(even){background:#f0eee8}.gallery{background:var(--night);color:#fff}.gallery-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}.gallery-placeholder{aspect-ratio:4/3;min-height:220px;border:1px dashed #939f96;background:#36403b;color:#e5e9e4;display:grid;place-items:center;text-align:center;padding:25px;font-size:.94rem}.gallery-note{color:#dfe4dd;font-size:.83rem}.faq details{border-bottom:1px solid #d3d5cd}.faq details p{margin-top:0;font-size:.92rem}.final{background:var(--green);color:#fff;text-align:center}.final p{margin:0 auto 20px}.final .actions{justify-content:center}.footer{background:#1b2520;color:#d5ded5;padding:29px 0;font-size:.78rem}.hidden{display:none!important}.copymsg{font-size:.8rem;color:#2c6140;min-height:20px}.contacthelp{font-size:.8rem;color:#d6e4da}button:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #daaa62;outline-offset:3px}@media(max-width:850px){.hero-grid,.calc-grid,.gallery-grid{grid-template-columns:1fr}.hero-grid{gap:25px}.config-grid{grid-template-columns:1fr}.spec-grid{grid-template-columns:repeat(2,1fr)}.size-grid{grid-template-columns:repeat(2,1fr)}section{padding:48px 0}}@media(max-width:580px){.size-grid,.spec-grid{grid-template-columns:1fr}.sitebar .wrap{display:block}.tagline{text-align:left;margin-top:5px}.result{padding:23px}}

/* ASI 2026-11-22: light calculator result surfaces MUST use dark legible text.
   Fixes specificity conflict from .calculator p { color: #e1e4df }.
   Scoped to light-surface panels only; no calculator data or scripts modified. */
.calculator .result, .calculator .result p, .calculator .result small,
.calculator .result .subtle, .calculator .result .selection,
.calculator .result .proposal-label, .calculator .result .price,
.calculator .result .copymsg, .calculator .result a:not(.btn),
.calculator .result label, .calculator .result strong,
.calculator .result em, .calculator .result span {
  color:#27362d !important;
  -webkit-text-fill-color:#27362d !important;
  opacity:1 !important;
  text-shadow:none !important;
}
.calculator .result .subtle {color:#48584d !important;-webkit-text-fill-color:#48584d !important;}
.calculator .result .btn, .calculator .result button.btn {
  background:#e4c399 !important;color:#202e27 !important;
  -webkit-text-fill-color:#202e27 !important;border-color:#a78354 !important;
}
.calculator .result .btn:is(:hover,:focus-visible),
.calculator .result button.btn:is(:hover,:focus-visible) {
  background:#f2d5aa !important;color:#15251e !important;
  -webkit-text-fill-color:#15251e !important;
}

