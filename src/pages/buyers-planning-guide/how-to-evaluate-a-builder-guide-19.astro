        { title: 'Verify Insurance and Responsibilities', text: 'Ask for proof of insurance and who handles permits, zoning, setbacks, HOA, utilities and placement questions.' },
        { title: 'Review Relevant Completed Work', text: 'Recent comparable projects, and reviews that speak to communication, follow-through, quality, site care and how problems were handled.' },
        { title: 'Read the Warranty Before the Sale', text: 'Builder vs. manufacturer coverage, exclusions, maintenance duties and the claim process.' },
        { title: 'Clarify Deposits, Payments and Changes', text: 'What the deposit reserves, when payments are due, and how changes to price, schedule or materials are documented.' },
        { title: 'Know Who Will Be on Your Property', text: 'Who builds, who supervises, who communicates schedule changes and who can resolve questions in the field.' },
      ],
    },
    {
      type: 'cards', id: 'trust', title: 'A Strong Builder Makes the Project Easy to Verify', nav: 'Foundations of Trust',
      items: [
        { title: 'Clear construction standards', text: 'An explanation of what is under the finished look: support, floor, framing, roof, siding and moisture details.' },
        { title: 'Clear written expectations', text: 'Proposal, selections, exclusions, payments, owner responsibilities and the change process are understandable before signing.' },
        { title: 'Clear accountability', text: 'You know who handles communication, site decisions, supervision and warranty questions.' },
      ],
    },
    {
      type: 'cards', id: 'red-flags', title: 'Warning Signs That Should Slow the Decision Down', nav: 'Red Flags',
      lead: 'One concern may have an innocent explanation. A pattern of vague answers, pressure or shifting terms deserves a closer look.',
      items: [
        { title: 'Vague “premium quality” claims', text: 'Quality language without stated framing, floor, siding, roof or moisture standards.' },
        { title: 'Low price with unclear exclusions', text: 'Site work, assembly, options, permits or access conditions not addressed.' },
        { title: 'Pressure to pay quickly', text: 'A deposit pushed before the scope, payments and warranty are understood.' },
        { title: '“We’ll figure it out later”', text: 'Changes expected to proceed without written approval.' },
        { title: 'Casual treatment of permits or HOA', text: 'Approval questions dismissed without clarifying responsibility.' },
        { title: 'Unknown installation crew', text: 'No one can explain who will build or supervise on your property.' },
        { title: 'A warranty number without terms', text: 'A long warranty promoted without coverage, exclusions or a claim path.' },
        { title: 'Defensive answers', text: 'Normal questions about insurance, materials or references treated as a problem.' },
      ],
    },
    {
