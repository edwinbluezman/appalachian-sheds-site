@import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@1,400;1,700&family=Montserrat:ital,wght@1,400;1,500;1,600;1,700;1,800&display=swap');
:root{--night:#2B3030;--night2:#202827;--cream:#F8F7F4;--sand:#E1DED8;--green:#2E473A;--gold:#C9A06C;--ink:#2B3030;--rule:#E1DED8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Montserrat,Arial,sans-serif;font-style:italic;line-height:1.6}button,select{font-family:inherit;font-style:italic}a{color:inherit}.wrap{width:94%;max-width:1440px;margin:auto}h1{font:italic 700 clamp(2.35rem,4.9vw,4.9rem)/1.14 Merriweather,Georgia,serif;letter-spacing:-.035em;margin:.15em 0 .4em}h2{font-size:clamp(1.7rem,3vw,2.8rem);line-height:1.22;margin:.2em 0 .55em}h3{font-size:1.15rem;margin:.3em 0 .6em}p{max-width:78ch}.eyebrow{display:inline-block;font-size:.75rem;letter-spacing:.17em;text-transform:uppercase;font-weight:800;color:var(--gold)}.eyebrow.dark{color:#496450}.sitebar{background:#1b2422;color:#fff;padding:17px 0;border-bottom:1px solid #425149}.sitebar .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{font-size:1.03rem;letter-spacing:.075em;font-weight:800}.tagline{font-size:.73rem;color:#e1e5df;text-align:right}.hero{background:var(--night);color:#fff}.hero-grid{display:grid;grid-template-columns:.93fr 1.07fr;gap:4%;align-items:center;padding:43px 0 49px}.hero img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover;border-radius:3px;box-shadow:0 10px 40px #0004}.hero p{font-size:1.07rem;color:#e8ebe7}.hero-points{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0}.hero-points span{border:1px solid #717d75;padding:7px 11px;font-size:.76rem;color:#f0f2ed}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.btn{border:1px solid var(--gold);background:var(--gold);color:#243029;display:inline-flex;align-items:center;justify-content:center;padding:13px 19px;min-height:47px;border-radius:3px;text-decoration:none;font-weight:800;font-size:.87rem;cursor:pointer}.btn.outline{background:transparent;color:inherit;border-color:#abb5ae}.btn:hover{filter:brightness(.9