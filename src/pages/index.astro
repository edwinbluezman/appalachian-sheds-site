---
import Base from '../layouts/Base.astro';
const pageTitle = "Appalachian Sheds Inc. | Backyard Buildings Built On Site | Cincinnati Tri-State";
---
<Base title={pageTitle}>
<Fragment set:html={"\n<main><section aria-labelledby=\"home-hero-title\" class=\"hero\">\n<div class=\"hero__inner shell\">\n<div class=\"hero__copy\">\n<p class=\"hero__eyebrow\"><span aria-hidden=\"true\"></span> VETERAN &amp; FAMILY-OWNED \u00b7 GREATER CINCINNATI</p>\n<h1 id=\"home-hero-title\">Appalachian Craftsmanship.<br/><em>A More Beautiful Backyard.</em></h1>\n<p class=\"hero__description\">Distinctive sheds and backyard buildings inspired by Appalachian architecture, thoughtfully planned and built on your property.</p>\n<div class=\"hero__actions\">\n<a class=\"btn btn--solid\" href=\"/buildings/\">View Buildings &amp; Pricing <span aria-hidden=\"true\">\u2197</span></a>\n<a class=\"btn btn--outline\" href=\"/buildings/\">Explore Custom Buildings <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n<div aria-label=\"Our approach\" class=\"hero__notes\"><span>Built on Site</span><span aria-hidden=\"true\" class=\"separator\"></span><span>Founder-Led Experience</span><span aria-hidden=\"true\" class=\"separator\"></span><span>Appalachian Heritage</span></div>\n</div>\n<figure class=\"hero__image\">\n<img alt=\"Grandpa Holt\u2019s Legacy Workshop with cedar siding, a covered porch, dark green roof and mature oak trees in autumn\" decoding=\"async\" fetchpriority=\"high\" height=\"1152\" src=\"/models/appalachian-barn.jpg\" width=\"928\"/>\n<figcaption>Grandpa Holt\u2019s Legacy Workshop \u00b7 Concept image</figcaption>\n</figure>\n</div>\n<div class=\"hero__footer shell\"><span>ARCHITECTURAL CHARACTER \u00b7 STRAIGHTFORWARD PLANNING \u00b7 ON-SITE CONSTRUCTION</span><span aria-hidden=\"true\" class=\"hero__rule\"></span><span>01 / THE INTRODUCTION</span></div>\n</section>\n<section aria-labelledby=\"founder-title\" class=\"founder\" id=\"founder-heritage\">\n<div class=\"founder__inner shell\">\n<div class=\"founder__copy\">\n<p class=\"founder__eyebrow\">THE FOUNDER &amp; THE HERITAGE</p>\n<h2 id=\"founder-title\">A Builder\u2019s Experience.<br/><em>An Appalachian Beginning.</em></h2>\n<p class=\"founder__lead\">A new family business shaped by three decades of construction leadership and a lifetime rooted in Eastern Kentucky.</p>\n<p>I'm Edwin R. Shackelford. My career has taken me across the country leading commercial construction projects. My roots have always remained in the mountains of Eastern Kentucky, where practical buildings and distinctive rooflines are part of the landscape.</p>\n<p>Today, I'm bringing that professional experience and Appalachian influence to a family-operated company dedicated to thoughtfully designed backyard buildings.</p>\n<a class=\"founder__link\" href=\"/our-story/founders-letter/\">Read Our Founder's Letter <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n<aside aria-label=\"Founder's background\" class=\"founder__aside\">\n<img alt=\"Edwin R. Shackelford outdoors near a rustic barn\" class=\"founder__visual\" decoding=\"async\" height=\"1152\" loading=\"lazy\" src=\"/our-story/founders-letter/edwin-r-shackelford-founder-portrait.jpg\" width=\"928\"/>\n<div class=\"founder__credentials\">\n<p class=\"founder__small\">EDWIN R. SHACKELFORD <span>FOUNDER &amp; OWNER</span></p>\n<div class=\"founder__facts\">\n<div><strong>30 years</strong><span>Commercial construction leadership</span></div>\n<div><strong>U.S. Army</strong><span>Veteran</span></div>\n<div><strong>Eastern Kentucky</strong><span>Appalachian roots</span></div>\n<div><strong>Family-operated</strong><span>With sons Randall &amp; Travis</span></div>\n</div>\n</div>\n</aside>\n</div>\n</section>\n<section aria-labelledby=\"collections-title\" class=\"collections\" id=\"our-buildings\">\n<div class=\"shell collections__inner\">\n<div class=\"collections__topline\"><span>03 / THE BUILDINGS</span><span>APPALACHIAN SHEDS INC.</span></div>\n<header class=\"collections__intro\">\n<div>\n<p class=\"collections__eyebrow\">EXPLORE OUR BUILDINGS</p>\n<h2 id=\"collections-title\">Distinctive by Design.<br/><em>Built for Your Property.</em></h2>\n</div>\n<p>Explore our 12 distinct building models, find practical answers in 24 planning guides, and discover 25 categories of options and upgrades to make the building your own.</p>\n</header>\n<div class=\"collections__grid\">\n<article class=\"collection-card collection-card--classic\">\n<div class=\"collection-card__illustration\">\n<img alt=\"Carriage Lane shed shown as an example of ASI building models.\" class=\"asi-section3-photo\" decoding=\"async\" loading=\"lazy\" src=\"/models/carriage-lane.jpg\"/>\n</div>\n<div class=\"collection-card__body\">\n<span class=\"collection-card__number\">01 / 12 BUILDING MODELS</span>\n<h3>Explore All 12 Models</h3>\n<p>Compare our complete collection of 12 distinct backyard building designs, view their architectural details, and explore model-specific pricing.</p>\n<a aria-label=\"Browse All 12 Models\" href=\"/buildings/\">Browse All 12 Models <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</article>\n<article class=\"collection-card collection-card--signature\">\n<div class=\"collection-card__illustration\">\n<img alt=\"Country Cottage with Shed Dormer pictured as an example of an ASI building.\" class=\"asi-section3-photo\" decoding=\"async\" loading=\"lazy\" src=\"/models/country-cottage-with-shed-dormer.jpg\"/>\n</div>\n<div class=\"collection-card__body\">\n<span class=\"collection-card__number\">02 / 24 BUILDING GUIDES</span>\n<h3>Plan With Confidence</h3>\n<p>Explore 24 practical homeowner guides covering site planning, building sizes, foundations, materials, permits, and the on-site building process.</p>\n<a aria-label=\"Explore Building Guides\" href=\"/planning-guides/\">Explore Building Guides <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</article>\n<article class=\"collection-card collection-card--custom\">\n<div class=\"collection-card__illustration\">\n<img alt=\"Urban Studio pictured as an example of an ASI building.\" class=\"asi-section3-photo\" decoding=\"async\" loading=\"lazy\" src=\"/models/urban-studio.jpg\"/>\n</div>\n<div class=\"collection-card__body\">\n<span class=\"collection-card__number\">03 / 25 OPTIONS &amp; UPGRADES</span>\n<h3>Make It Your Own</h3>\n<p>Review 25 option categories, compare available features and historical planning-price references, and discover what fits your building and intended use.</p>\n<a aria-label=\"Explore Options &amp; Upgrades\" href=\"/options-upgrades/\">Explore Options &amp; Upgrades <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</article>\n</div>\n<div class=\"collections__outro\"><div><strong>Find the building that fits.</strong><span>Explore all 12 models, compare design details, and review pricing in one place.</span></div><a href=\"/buildings/\">View Buildings &amp; Pricing <span aria-hidden=\"true\">\u2197</span></a></div>\n</div>\n<style>\n/* ASI Homepage Section 3 \u2014 Premium architectural card refinement */\n#our-buildings {padding-bottom:clamp(70px,6.5vw,100px)}\n#our-buildings .collections__intro {margin:38px 0 45px}\n#our-buildings .collections__grid {gap:24px;align-items:stretch}\n#our-buildings .collection-card {background:#F4F0E9;border:1px solid rgba(189,160,123,.4);box-shadow:0 18px 35px rgba(12,23,18,.12);transition:transform .18s ease,box-shadow .18s ease}\n#our-buildings .collection-card:hover {transform:translateY(-3px);box-shadow:0 25px 45px rgba(12,23,18,.17)}\n#our-buildings .collection-card--signature {background:#F4F0E9}\n#our-buildings .collection-card--custom {background:#F1F1EC}\n#our-buildings .collection-card__illustration, #our-buildings .collection-card:last-child .collection-card__illustration {\n  height:auto;min-height:0;display:block;align-items:initial;justify-content:initial;\n  padding:22px 22px 0;overflow:visible;background:transparent;\n}\n#our-buildings .collection-card__illustration .asi-section3-photo {\n  display:block;width:100%;height:auto;aspect-ratio:4 / 3;max-width:100%;object-fit:cover;object-position:center;\n  border:1px solid rgba(75,67,55,.15);background:#E7E3DB;\n  box-shadow:0 8px 20px rgba(26,35,28,.10);\n}\n#our-buildings .collection-card__body {padding:27px 32px 32px;display:flex;flex-direction:column;flex:1}\n#our-buildings .collection-card__number {font-family:'Montserrat',Arial,sans-serif;font-style:italic;font-weight:700;margin-bottom:16px}\n#our-buildings .collection-card h3 {font-family:'Montserrat',Arial,sans-serif;font-style:italic;font-weight:700;font-size:clamp(21px,2vw,27px);line-height:1.33;text-transform:capitalize;margin:0 0 18px}\n#our-buildings .collection-card__body p {min-height:105px;line-height:1.75;margin:0 0 28px}\n#our-buildings .collection-card__body a {margin-top:auto;align-self:flex-start;padding-bottom:7px;border-bottom:1px solid rgba(159,123,87,.68)}\n#our-buildings .collections__outro {margin-top:32px;padding-top:27px}\n@media(max-width:1100px){#our-buildings .collections__grid {gap:16px}#our-buildings .collection-card__illustration,#our-buildings .collection-card:last-child .collection-card__illustration{padding:18px 18px 0}#our-buildings .collection-card__body{padding:24px 23px 28px}}\n@media(max-width:1000px){#our-buildings .collection-card__body p{min-height:0}}\n@media(max-width:690px){#our-buildings .collections__grid{gap:20px}#our-buildings .collection-card__illustration,#our-buildings .collection-card:last-child .collection-card__illustration{padding:18px 18px 0}#our-buildings .collection-card__body{padding:22px 24px 28px}}\n@media(prefers-reduced-motion:reduce){#our-buildings .collection-card{transition:none}#our-buildings .collection-card:hover{transform:none}}\n</style></section>\n<section aria-labelledby=\"quality-heading\" class=\"build-quality\" id=\"construction-standards\">\n<div class=\"shell quality-shell\">\n<header class=\"quality-header\">\n<div>\n<p class=\"quality-kicker\">04 / CONSTRUCTION &amp; MATERIALS</p>\n<h2 id=\"quality-heading\">Good Buildings Begin <em>Below the Surface.</em></h2>\n</div>\n<p class=\"quality-summary\">A building's character is visible in its roofline and siding. Its lasting value begins with the decisions beneath them: the site, foundation, framing and materials.</p>\n</header>\n<div class=\"quality-feature\">\n<div aria-label=\"Simplified illustrated section showing gravel preparation beneath a pressure-treated wood beam and raised floor framing; not an engineered construction drawing\" class=\"quality-graphic\" role=\"img\">\n<div class=\"quality-graphic__label\">FROM THE GROUND UP</div>\n<img alt=\"\" class=\"asi-refined-diagram\" loading=\"lazy\" src=\"/models/appalachian-farmhouse.jpg\"/>\n<p class=\"quality-graphic__caption\">Illustrative floor assembly \u00b7 Diagram not to scale</p>\n</div>\n<div class=\"quality-feature__copy\">\n<p class=\"quality-number\">01 / THE FOUNDATION</p>\n<h3>Start with the Site.</h3>\n<p>For a typical 10\u2032 \u00d7 12\u2032 building, our reference pad measures 14\u2032 \u00d7 16\u2032\u2014allowing two feet of preparation beyond the structure on every side. The approach begins with subgrade preparation, geotextile separation, a compacted stone base and appropriate moisture management.</p>\n<p>Pressure-treated structural beams support a framed floor above the prepared base. The final foundation arrangement is planned around the building and conditions at your property.</p>\n<a href=\"/craft/\">Explore Our Construction Approach <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</div>\n<div aria-label=\"Construction features\" class=\"quality-details\">\n<article><span>02 / FLOOR</span><h3>Solid Underfoot.</h3><p>Our standard floor assembly specifies 6\u00d76 pressure-treated support beams, 2\u00d76 pressure-treated joists at 16 inches on center and \u00be-inch pressure-treated plywood. Larger buildings may require different framing.</p></article>\n<article><span>03 / EXTERIOR</span><h3>Materials You Can Choose.</h3><p>Exterior choices include vinyl, DuraTemp, LP board-and-batten, cedar lap and cedar shake. Available options vary by model and are identified on the individual pricing pages.</p></article>\n<article><span>04 / CONSTRUCTION</span><h3>Built on Your Property.</h3><p>Our buildings are constructed on-site. We review access, preparation requirements and the building's specifications before establishing the written project scope.</p></article>\n<article><span>05 / COMMITMENT</span><h3>Warranty in Writing.</h3><p>Appalachian Sheds offers a 30-year structural warranty. The written warranty defines its coverage, limitations and maintenance requirements.</p></article>\n</div>\n<div class=\"quality-foot\"><p>Know the structure behind the style.</p><a href=\"/craft/\">View Construction Details <span aria-hidden=\"true\">\u2197</span></a></div>\n</div>\n</section>\n<section aria-labelledby=\"inspiration-title\" class=\"asi-inspiration\" id=\"design-inspiration\">\n<div class=\"shell inspiration-wrap\">\n<div class=\"inspiration-intro\">\n<div>\n<p class=\"inspiration-kicker\">05 / DESIGN &amp; INSPIRATION</p>\n<h2 id=\"inspiration-title\">Architecture That Belongs.<br/><em>Space That Works.</em></h2>\n</div>\n<p class=\"inspiration-lead\">A backyard building should feel at home on the property and serve a real purpose. Appalachian rooflines, considered proportions and natural materials create the starting point. How you use the space is up to you.</p>\n</div>\n<div class=\"inspiration-feature\">\n<div aria-label=\"Architectural concept line drawing of an Appalachian-inspired gable building with a porch and simple planting\" class=\"inspiration-art\" role=\"img\">\n<div class=\"inspiration-art__label\">APPALACHIAN FORMS \u00b7 ARCHITECTURAL STUDY</div>\n<img alt=\"\" class=\"asi-refined-diagram\" loading=\"lazy\" src=\"/models/appalachian-farmhouse.jpg\"/>\n<p class=\"inspiration-art__note\">Architectural illustration \u00b7 Not a photograph of a completed building</p>\n</div>\n<div class=\"inspiration-feature__copy\">\n<p class=\"inspiration-micro\">THE IDEA BEHIND THE DESIGN</p>\n<h3>Rooted in the Mountains.<br/>Designed for Today's Backyard.</h3>\n<p>Steep gables, saltbox slopes, lean-to forms and generous overhangs come from a practical building tradition. We take their character seriously, then consider the shape, scale and function that best suit your property.</p>\n<a href=\"/buildings/\">Explore Building Designs <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</div>\n<div aria-label=\"Possible building uses\" class=\"inspiration-uses\">\n<article><span>01 / STORE</span><h3>Garden &amp; Everyday Storage</h3><p>Well-organized space for tools, gardening equipment and the things you want close at hand.</p></article>\n<article><span>02 / MAKE</span><h3>Workshops &amp; Hobbies</h3><p>Room for woodworking, personal projects and the equipment that supports them.</p></article>\n<article><span>03 / CREATE</span><h3>Studios &amp; Flexible Spaces</h3><p>A dedicated backyard structure to shape around creative work or other planned uses, subject to local requirements.</p></article>\n</div>\n<div class=\"inspiration-outro\">\n<p>The right starting point is what you want the building to do.</p>\n<a href=\"/approved-pages/homepage-v12.html#contact\">Explore Custom Buildings <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</div>\n</section><section aria-labelledby=\"process-title\" class=\"asi-process\" id=\"building-process\">\n<div class=\"shell process-shell\">\n<header class=\"process-header\">\n<div>\n<p class=\"process-kicker\">06 / OUR BUILDING PROCESS</p>\n<h2 id=\"process-title\">From Your First Idea.<br/><em>To a Building on Your Property.</em></h2>\n</div>\n<p class=\"process-lead\">A new backyard building should begin with a clear conversation and an understandable plan. Here is how we approach decisions about the design, the site, the written scope and the construction itself.</p>\n</header>\n<div class=\"process-feature\">\n<div class=\"process-feature__message\">\n<p class=\"process-mini\">THE APPROACH</p>\n<h3>Plan the work.<br/><em>Know what is included.</em></h3>\n<p>We discuss the purpose of your building, the conditions of your property, and the materials and options that matter to you before moving ahead with the work.</p>\n<div class=\"process-emphasis\"><span aria-hidden=\"true\">\u2014</span> The right details, understood before construction.</div>\n</div>\n<div aria-hidden=\"true\" class=\"process-art\">\n<img alt=\"\" class=\"asi-refined-diagram\" loading=\"lazy\" src=\"/models/appalachian-farmhouse.jpg\"/>\n<p>Illustrative design study \u00b7 Not a construction drawing</p>\n</div>\n</div>\n<div aria-label=\"Four stages of the building process\" class=\"process-steps\">\n<article class=\"process-step\">\n<span class=\"process-step__number\">01</span>\n<div><h3>Explore Your Building</h3><p>Review our designs, choose a size and consider the siding, doors, windows and features suited to your plans.</p></div>\n</article>\n<article class=\"process-step\">\n<span class=\"process-step__number\">02</span>\n<div><h3>Review the Property</h3><p>Discuss access, grading, foundation preparation, placement and local requirements that may affect the project.</p></div>\n</article>\n<article class=\"process-step\">\n<span class=\"process-step__number\">03</span>\n<div><h3>Confirm the Written Proposal</h3><p>Review the building specifications, included work, selected options and pricing before authorizing construction.</p></div>\n</article>\n<article class=\"process-step\">\n<span class=\"process-step__number\">04</span>\n<div><h3>Build on Your Property</h3><p>With the site and project scope confirmed, construction takes place on-site, followed by a review of the completed work.</p></div>\n</article>\n</div>\n<div class=\"process-bottom\">\n<div><p class=\"process-mini\">BEGIN WITH THE DESIGN</p><p>See the building styles, sizes and pricing information available for your project.</p></div>\n<a href=\"/buildings/\">View Buildings &amp; Pricing <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</div>\n</section><section aria-labelledby=\"invitation-title\" class=\"asi-invitation\" id=\"contact\">\n<div class=\"shell invitation-wrap\">\n<div class=\"invitation-copy\">\n<p class=\"invitation-eyebrow\">07 / A PERSONAL INVITATION</p>\n<h2 id=\"invitation-title\">Let's Talk About <em>Your Building.</em></h2>\n<p class=\"invitation-lead\">If you're considering a backyard building, begin with a conversation. Tell us what you have in mind, where it will stand and how you hope to use it.</p>\n<p>We'll help you explore the designs, discuss the practical details and understand what belongs in a written proposal. No pressure. Just a straightforward starting point.</p>\n<div aria-label=\"Contact Appalachian Sheds\" class=\"invitation-actions\">\n<a class=\"invitation-primary\" href=\"tel:+15133792421\">Call Edwin <span aria-hidden=\"true\">\u2197</span></a>\n<a class=\"invitation-secondary\" href=\"sms:+15133792421\">Text Edwin <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n<p class=\"invitation-phone\">Or call directly: <a href=\"tel:+15133792421\">(513) 379-2421</a></p>\n</div>\n<aside aria-label=\"About contacting Appalachian Sheds\" class=\"invitation-aside\">\n<div aria-hidden=\"true\" class=\"invitation-rule\"></div>\n<p class=\"invitation-aside-label\">A CONVERSATION WITH THE OWNER</p>\n<h3>Edwin R. Shackelford</h3>\n<p class=\"invitation-role\">Founder &amp; Owner \u00b7 Appalachian Sheds Inc.</p>\n<p class=\"invitation-detail\">A veteran-owned, family-operated company serving Greater Cincinnati and the Ohio, Kentucky and Indiana Tri-State.</p>\n<div class=\"invitation-aside-bottom\">\n<p>Prefer to explore first?</p>\n<a href=\"/buildings/\">View Buildings &amp; Pricing <span aria-hidden=\"true\">\u2197</span></a>\n</div>\n</aside>\n</div>\n<div class=\"invitation-footer shell\">\n<p>\u00a9 2026 Appalachian Sheds Inc.</p>\n<p>Veteran-Owned \u00b7 Family-Operated \u00b7 Cincinnati Tri-State</p>\n<a href=\"#site-header\">Back to top \u2191</a>\n</div>\n</section></main>"} />
</Base>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@1,400;1,700&family=Montserrat:ital,wght@1,400;1,500;1,600;1,700&display=swap');
:root{color-scheme:dark;--graphite:#2B3030;--deep-pine:#2E473A;--gable-white:#F6F2EA;--cream:#F8F7F4;--bronze:#C9A06C;--line:rgba(246,242,234,.17);--shell:1440px;font-family:'Montserrat',Arial,sans-serif;font-style:italic;font-synthesis:none}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--graphite);color:var(--gable-white);-webkit-font-smoothing:antialiased}img{max-width:100%;display:block}a{color:inherit}button,input{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible{outline:3px solid #E8C79B;outline-offset:4px}h1,h2,h3,p{margin-top:0}.shell{width:94%;max-width:var(--shell);margin-inline:auto}.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}


.header{position:relative;z-index:50;background:#252c2b;border-bottom:1px solid var(--line)}.header__inside{min-height:104px;display:flex;align-items:center;justify-content:space-between;gap:30px}.brand{text-decoration:none;display:flex;align-items:center;gap:12px;min-width:max-content}.brand__logo{display:block;width:clamp(128px,13vw,176px);height:auto;max-height:86px;object-fit:contain;object-position:left center}.nav{display:flex;align-items:center;gap:clamp(14px,1.55vw,30px)}.nav a{font-size:11px;font-weight:600;text-decoration:none;white-space:nowrap;transition:color .2s}.nav a:hover{color:#E6C59D}.nav .nav__cta{border:1px solid var(--bronze);padding:14px 16px;color:#F6F2EA}.nav__cta span{color:var(--bronze)}.menu-button{display:none;border:1px solid var(--line);background:transparent;padding:13px;min-height:44px;min-width:44px}.menu-button span{display:block;background:var(--gable-white);height:2px;width:20px;margin:4px 0}@media(max-width:1120px){.menu-button{display:block}.nav{display:none;position:absolute;top:100%;left:0;right:0;background:#252c2b;box-shadow:0 18px 24px #0005;padding:22px 5% 30px;flex-direction:column;align-items:stretch;gap:0}.nav.is-open{display:flex}.nav a{padding:16px 6px;border-bottom:1px solid var(--line);font-size:14px}.nav .nav__cta{margin-top:16px;text-align:center}}@media(max-width:560px){.header__inside{min-height:84px}.brand__logo{width:127px;max-height:70px}}


.hero{background:var(--graphite);padding:clamp(42px,5vw,80px) 0 27px;overflow:hidden}.hero__inner{display:grid;grid-template-columns:minmax(0,.91fr) minmax(0,1.09fr);align-items:center;gap:clamp(24px,4vw,74px)}.hero__copy{padding:8px 0 14px}.hero__eyebrow{font-size:11px;line-height:1.7;color:#D6B58D;font-weight:700;letter-spacing:.16em;margin-bottom:25px}.hero__eyebrow span{display:inline-block;width:30px;height:1px;background:#D6B58D;vertical-align:middle;margin-right:10px}.hero h1{font-family:'Merriweather',Georgia,serif;font-style:italic;font-size:clamp(38px,3.1vw,58px);font-weight:400;line-height:1.25;letter-spacing:-.036em;color:var(--gable-white);margin-bottom:24px}.hero h1 em{font-style:italic;color:#DCC9AD}.hero__description{max-width:570px;color:#E2DDD5;font-size:clamp(15px,1.06vw,17px);line-height:1.9;font-weight:400;margin-bottom:32px}.hero__actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:43px}.btn{min-height:54px;display:inline-flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 20px;text-decoration:none;text-align:left;text-transform:none;font-size:12px;font-weight:700;letter-spacing:.015em;transition:background .18s,color .18s,transform .18s}.btn:hover{transform:translateY(-2px)}.btn--solid{background:#B79A76;color:#201D19}.btn--solid:hover{background:#D9B88C}.btn--outline{color:#F6F2EA;border:1px solid #B79A76;background:transparent}.btn--outline:hover{background:#3E4442}.hero__notes{display:flex;align-items:center;flex-wrap:wrap;gap:12px;color:#D9CCB7;font-size:10px;font-weight:600;letter-spacing:.04em;line-height:1.8}.separator{width:4px;height:4px;background:#B79A76;transform:rotate(45deg)}.hero__image{position:relative;margin:0;box-shadow:0 24px 58px #10181833;border:1px solid #6B6B6329}.hero__image img{width:100%;height:clamp(390px,36vw,560px);object-fit:cover;object-position:50% 50%}.hero__image figcaption{position:absolute;right:0;bottom:0;padding:10px 14px;background:#1F2625E6;color:#F0ECE4;font-size:10px;let