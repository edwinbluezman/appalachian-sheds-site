---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Grand Depot Pricing | Appalachian Sheds Inc.";
---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div>\n<header class=\"site-header\"><div class=\"shell head-inner\"><a class=\"brand\" href=\"../index.html\">Appalachian Sheds Inc.<small>VETERAN &amp; FAMILY OWNED \u00b7 CINCINNATI</small></a><nav aria-label=\"Page sections\" class=\"nav\"><a href=\"#pricing\">Pricing</a><a href=\"#features\">Standard Features</a><a href=\"#gallery\">Gallery</a><a href=\"#questions\">Questions</a><a class=\"btn btn-gold\" href=\"#proposal\">Request a Proposal</a></nav></div></header>\n<section class=\"hero\"><div class=\"shell hero-grid\"><div><div class=\"eyebrow\">Appalachian Sheds \u00b7 Heritage Collection \u00b7 Built on Site</div><h1>The Grand Depot Pricing.</h1><p class=\"intro\">Traditional gable-roof character, distinctive Craftsman double doors, and a generous 9/12 roofline.</p><p>Compare sizes and five exterior siding selections for a thoughtfully built backyard structure constructed on your property.</p><div class=\"hero-price\">Starting at <span id=\"hero-start\">$9,444</span></div><p>8\u00d78 \u00b7 Roseburg DuraTemp siding included</p><div class=\"hero-actions\"><a class=\"btn btn-gold\" href=\"#pricing\">See Your Price</a><a class=\"btn btn-outline\" href=\"#features\">Explore Standard Features</a></div></div><figure class=\"hero-photo\"><img alt=\"The Grand Depot with cedar-colored lap siding, red Craftsman double doors, and a 9/12 gable roof in an autumn backyard\" loading=\"eager\" src=\"/models/grand-depot.jpg\"/></figure></div></section>\n<section class=\"section\" id=\"pricing\"><div class=\"shell\"><div class=\"eyebrow\">Grand Depot \u00b7 Sizes &amp; Siding</div><h2>See Your Grand Depot Price</h2><p class=\"lead\">Choose one of six popular building sizes and the exterior siding you prefer. View the full schedule below for all 21 available sizes.</p><div class=\"featured\" id=\"featured\"></div><div class=\"calculator\"><div class=\"calc-form\"><div class=\"field\"><label for=\"size\">Choose Your Size</label><select aria-label=\"Overall and enclosed building size\" id=\"size\"></select></div><div class=\"field\"><label for=\"siding\">Choose Your Siding</label><select id=\"siding\"><option value=\"0\">Roseburg DuraTemp \u2014 Standard</option><option value=\"1\">LP SmartSide Vertical Textured Panel</option><option value=\"2\">LP SmartSide Board &amp; Batten</option><option value=\"3\">LP SmartSide Lap</option><option value=\"4\">GP Vinyl Lap</option></select></div><div class=\"selection-note\">Prices represent standard exterior weather-tight shells built on your property. Required exterior caulking and painting or staining must be completed within 30 days. Optional finishing services may be quoted separately.</div></div><div aria-live=\"polite\" class=\"price-card\"><div class=\"eyebrow\">Your Standard Grand Depot Price</div><div class=\"price-number\" id=\"calc-price\">$24,629</div><div class=\"calc-details\" id=\"calc-details\">8\u00d78 \u00b7 64 sq ft</div><div class=\"calc-details\" id=\"calc-siding\">Roseburg DuraTemp \u2014 Standard</div><button class=\"btn btn-light\" id=\"copy\" type=\"button\">Copy My Building Selections</button><span id=\"price-status\" role=\"status\"></span></div></div><div class=\"pricing-tools\"><button aria-controls=\"table-panel\" aria-expanded=\"false\" class=\"btn btn-green\" id=\"toggle-table\" type=\"button\">View All 21 Sizes &amp; Prices</button><span class=\"subtle\">Five exterior siding choices \u00b7 Complete pricing schedule available</span></div><div hidden=\"\" id=\"table-panel\"><div class=\"full-table\"><table class=\"price-table\"><thead><tr><th>Building Size</th><th>DuraTemp<br/>Included</th><th>LP Vertical<br/>Textured Panel</th><th>LP Board<br/>&amp; Batten</th><th>LP Lap</th><th>GP Vinyl Lap</th></tr></thead><tbody id=\"price-rows\"></tbody></table></div><p class=\"subtle\" style=\"margin-top:14px;font-size:.87rem\">Prices are based on the listed building configuration and siding. Site-specific conditions, customization and optional services are addressed in a written proposal.</p></div></div></section>\n<section class=\"section section-soft\" id=\"features\"><div class=\"shell\"><div class=\"eyebrow\">Built on site \u00b7 Traditional craftsmanship</div><h2>Superior Standard Features</h2><p class=\"lead\">A distinctive 9/12 roofline paired with proven framing and weather-resistant exterior construction.</p><div class=\"features\"><div class=\"feature\"><h3>Foundation &amp; Floor</h3><p>4\u00d76 pressure-treated beams over 16\u00d716\u00d74-inch solid concrete support pads; 2\u00d76 pressure-treated floor joists at 16 inches on center, finished with \u00be-inch pressure-treated exterior-rated plywood decking.</p></div><div class=\"feature\"><h3>Framing &amp; Roof</h3><p>2\u00d74 kiln-dried wall studs at 16 inches on center, engineered 2\u00d74 trusses at 24 inches on center, and a 9/12 traditional gable-roof profile.</p></div><div class=\"feature\"><h3>Doors &amp; Windows</h3><p>Site-built 60\u00d780-inch Craftsman wood double doors with black hardware, keyed lock, and inactive-leaf bolts; two 24\u00d730-inch white aluminum single-hung windows with screens and locks.</p></div><div class=\"feature\"><h3>Exterior Siding</h3><p>Roseburg DuraTemp included; optional LP SmartSide Vertical Textured Panel, Board &amp; Batten, Lap, or GP Vinyl Lap siding.</p></div><div class=\"feature\"><h3>Roof &amp; Weather Protection</h3><p>\u00bd-inch CDX plywood roof sheathing, architectural asphalt shingles and synthetic underlayment, with roof ventilation and flashing detailed for the building design.</p></div><div class=\"feature\"><h3>Built on Site</h3><p>Constructed on your property using engineered pad layout and anchorage appropriate to site and building conditions. Site preparation beyond the included 6-inch leveling allowance is quoted separately.</p></div></div></div><figure class=\"asi-feature-showcase\" data-approved-model=\"grand-depot\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"Grand Depot \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/grand-depot.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"section\" id=\"gallery\"><div class=\"shell\"><div class=\"eyebrow\">Grand Depot exterior craftsmanship</div><h2>Exterior Gallery</h2><p class=\"lead\">Explore the Grand Depot\u2019s gable roof and Craftsman details. Colors, siding and other finishes shown may be optional.</p><div class=\"gallery\"><figure><img alt=\"The Grand Depot exterior with red double doors and prominent 9/12 roofline\" loading=\"lazy\" src=\"/standard-features/grand-depot.png\"/><figcaption>Grand Depot \u2014 exterior architectural view. Some colors and details may be optional.</figcaption></figure></div></div></section>\n<section class=\"bridge\"><div class=\"shell bridge-grid\"><div><div class=\"eyebrow\">Our Craftsmanship</div><h2>Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. One shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"btn btn-green\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p style=\"margin-top:17px;font-size:.82rem\">Standard buildings are exterior weather-tight shells. Exterior caulking and painting or staining must be completed within 30 days; ASI finishing services are available separately.</p></div><div class=\"bridge-aside\"><div><strong>Foundation &amp; floor</strong><small>Pressure-treated framing and concrete support pads</small></div><div><strong>Walls &amp; roof</strong><small>Construction designed for the selected model and site</small></div><div><strong>Weather protection</strong><small>Flashing, roofing and exterior detailing</small></div></div></div></section>\n<section class=\"section faq\" id=\"questions\"><div class=\"shell\"><div class=\"eyebrow\">Helpful details</div><h2>Frequently Asked Questions</h2><details><summary>Is The Grand Depot built on my property?</summary><p>Yes. Each Grand Depot is built on site, with access, placement, pad layout, and anchoring reviewed as part of your written proposal.</p></details><details><summary>Which exterior siding is included in the listed price?</summary><p>Roseburg DuraTemp is the standard siding. LP SmartSide Vertical Textured Panel, Board &amp; Batten, Lap, and GP Vinyl Lap are available as priced upgrades.</p></details><details><summary>Does the price include finished interior walls or ceilings?</summary><p>No. Standard prices cover an exterior weather-tight shell. Interior insulation, wall and ceiling finishes, electrical work, and other improvements are not included unless separately specified.</p></details><details><summary>When must the exterior be painted or stained?</summary><p>Required exterior caulking and painting or staining must be completed within 30 days after construction. Optional exterior finishing can be quoted separately.</p></details><details><summary>Are additional sizes and site options available?</summary><p>The full pricing table includes 21 sizes. Site conditions, access, customization and additional preparation are addressed in your written proposal.</p></details></div></section>\n<section class=\"section section-dark final\" id=\"proposal\"><div class=\"shell\"><div class=\"eyebrow\">Plan with confidence</div><h2>Ready to Plan Your Grand Depot?</h2><p>Choose your building size and preferred siding, then bring those selections to a property walk-through or written proposal. We review installation conditions and optional features before finalizing the scope.</p><button class=\"btn btn-light\" id=\"copy-bottom\" type=\"button\">Copy My Building Selections</button><p style=\"font-size:.83rem;color:#d7e2d9;margin-top:17px\">Use your copied selections when contacting Appalachian Sheds for a written proposal.</p></div></section>\n<footer class=\"footer\"><div class=\"shell footer-inner\"><span>Appalachian Sheds Inc. \u00b7 Veteran &amp; Family Owned \u00b7 Built on Site</span><a href=\"../index.html\">View Models &amp; Pricing</a></div></footer>\n\n"} />
</Base>

<style is:global>

:root{--dark:#2B3030;--ink:#2B3030;--deep:#2B3030;--cream:#F8F7F4;--paper:#fff;--sand:#E1DED8;--gold:#C9A06C;--border:#E1DED8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--cream);font-family:Montserrat,Arial,sans-serif;font-style:italic;line-height:1.6}h1{font-family:Merriweather,Georgia,serif;font-style:italic;font-size:clamp(2rem,3.5vw,3.6rem);line-height:1.17;margin:16px 0 22px}h2,h3{font-weight:800;line-height:1.3}h2{font-size:clamp(1.65rem,2.7vw,2.55rem);margin:12px 0 16px}h3{font-size:1.13rem}p{margin:0 0 16px}a{color:inherit}.shell{width:94%;max-width:1440px;margin:auto}.eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#ad8965}.subtle{color:#59625c}.site-header{background:#1f2d26;color:white;border-bottom:1px solid #506354}.head-inner{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.25;font-weight:500;text-decoration:none;white-space:nowrap}.brand small{display:block;font-size:.61rem;letter-spacing:.16em;color:#d2ac84;margin-top:7px}.nav{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.nav a{text-decoration:none;font-size:.85rem}.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;text-align:center;padding:14px 19px;font-size:.9rem;font-weight:800;line-height:1.3;text-decoration:none;border-radius:2px;border:2px solid transparent;cursor:pointer;font-family:inherit;font-style:inherit}.btn-gold{background:#c2a07c;color:#1e2925}.btn-green{background:#244b39;color:#fff}.btn-outline{border-color:#b8c5bc;background:transparent;color:inherit}.btn-light{background:#F8F7F4;color:#203129}.btn:hover{filter:brightness(.94)}a:focus-visible,button:focus-visible,select:focus-visible{outline:3px solid #c28e4f;outline-offset:3px}.hero{background:var(--dark);color:#f8f5ed;padding:clamp(36px,5vw,78px) 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(26px,4vw,65px);align-items:center}.hero p{max-width:62ch}.hero .intro{font-size:1.04rem}.hero-price{font-family:Merriweather,Georgia,serif;font-size:clamp(1.65rem,2.7vw,2.6rem);margin:16px 0 0;color:#e0c09e}.hero-photo{margin:0;max-width:100%;min-width:0}.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:#293831;border-radius:3px}.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:21px}.section{padding:clamp(55px,6.5vw,94px) 0}.section-dark{background:#2B3030;color:#fff}.section-soft{background:#eae8e2}.lead{font-size:1.04rem;max-width:78ch;color:#54615a}.section-dark .lead{color:#dde3de}.calculator{margin-top:28px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:24px;align-items:stretch}.calc-form{padding:clamp(23px,3vw,35px);background:#fff;border:1px solid var(--border);border-radius:4px}.field{margin-bottom:22px}.field label{display:block;font-weight:800;margin-bottom:9px;font-size:.92rem}.field select{appearance:auto;width:100%;min-height:54px;padding:13px 15px;border:1px solid #9ba89e;background:#fff!important;color:#1f3028!important;-webkit-text-fill-color:#1f3028!important;font:inherit;font-size:.98rem;border-radius:3px;opacity:1!important;color-scheme:light}.field select option{background:#fff!important;color:#1f3028!important}.selection-note{font-size:.87rem;color:#48544c;background:#f2f0ea;border-left:3px solid #b69a77;padding:16px;margin-top:5px}.price-card{padding:clamp(25px,3.2vw,40px);background:#28312e;color:#fff;border-radius:4px;display:flex;flex-direction:column;justify-content:center;min-height:295px}.price-card .eyebrow{color:#e2c5a8}.price-number{font-weight:800;font-size:clamp(2.6rem,5vw,4.5rem);line-height:1.2;margin:12px 0 16px;color:#fff}.price-card .calc-details{color:#f2f3ef;font-weight:600}.price-card .btn{align-self:flex-start;margin-top:15px}.featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:25px 0 32px}.size-card{background:#fff;border:1px solid #E1DED8;color:#28342c;text-align:left;padding:20px;cursor:pointer;font:inherit;border-radius:3px;min-height:126px}.size-card:hover,.size-card.active{border-color:#37614b;box-shadow:inset 0 0 0 2px #37614b}.size-card strong{font-size:1.05rem;display:block}.size-card span{font-size:.85rem;color:#505c55;display:block}.size-card b{font-size:1.15rem;display:block;margin-top:8px}.full-table{overflow-x:auto;border-radius:4px;border:1px solid #d8d9d4;background:#fff}.price-table{border-collapse:collapse;min-width:840px;width:100%;color:#26332b;font-size:.85rem;font-variant-numeric:tabular-nums}.price-table th{padding:17px 12px;line-height:1.45;color:#fff;text-align:center;font-size:.77rem}.price-table th:first-child{background:#263332;text-align:left}.price-table th:nth-child(2){background:#315244}.price-table th:nth-child(3){background:#2f6272}.price-table th:nth-child(4){background:#79634c}.price-table th:nth-child(5){background:#655d7a}.price-table th:nth-child(6){background:#725948}.price-table td{padding:13px 11px;text-align:right;border-bottom:1px solid #e2e2db}.price-table td:first-child{text-align:left;font-weight:800}.price-table tr:nth-child(even){background:#e9ece8}.price-table tr:hover{background:#dce8df}.pricing-tools{margin:25px 0 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}.pricing-tools .btn{margin:0}.features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:25px}.feature{background:#fff;border:1px solid #e1dfd8;padding:26px}.feature h3{margin:0 0 10px}.feature p{margin:0;color:#56615a;font-size:.89rem}.gallery{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin-top:25px}.gallery figure{margin:0;background:#fff;padding:13px;border:1px solid var(--border);max-width:850px}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:contain;background:#dfded7}.gallery figcaption{margin-top:10px;color:#3d4a41;font-size:.82rem}.bridge{background:#ece9e3;padding:clamp(55px,6vw,85px) 0}.bridge-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}.bridge-aside{display:grid;gap:11px}.bridge-aside>div{background:#fafaf8;border-left:3px solid #a98d70;padding:15px 19px}.bridge-aside strong{display:block}.bridge-aside small{display:block;color:#536058}.faq details{border-bottom:1px solid #bec6bf;padding:19px 0}.faq summary{cursor:pointer;font-weight:800}.faq details p{margin:14px 0 3px;color:#536058}.final{text-align:center}.final p{max-width:70ch;margin:15px auto 24px}.footer{background:#1e2c25;color:#d7dcd6;padding:25px 0;font-size:.8rem}.footer a{color:#fff}.footer-inner{display:flex;gap:20px;justify-content:space-between;flex-wrap:wrap}#price-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:900px){.hero-grid,.calculator,.bridge-grid{grid-template-columns:1fr}.hero-photo{max-width:720px}.featured,.features{grid-template-columns:repeat(2,minmax(0,1fr))}.nav{gap:12px}}
@media(max-width:620px){.head-inner{align-items:flex-start;flex-direction:column;padding:15px 0}.nav{gap:12px}.hero-actions .btn{width:100%}.featured,.features{grid-template-columns:1fr}.price-card .btn{align-self:stretch}.section{padding:48px 0}.hero{padding:34px 0}.price-card{min-height:230px}.hero h1{font-size:2rem}}

</style>

<script is:inline>

const rows=[{"size":"8×8","area":64,"prices":[9444,10199,10483,11569,11710]},{"size":"8×10","area":80,"prices":[9997,10797,11097,12246,12396]},{"size":"8×12","area":96,"prices":[10556,11400,11717,12931,13089]},{"size":"10×10","area":100,"prices":[10959,11836,12165,13425,13589]},{"size":"10×12","area":120,"prices":[11595,12523,12871,14204,14378]},{"size":"10×14","area":140,"prices":[12324,13310,13680,15097,15282]},{"size":"10×16","area":160,"prices":[13080,14127,14519,16024,16220]},{"size":"10×18","area":180,"prices":[14319,15465,15894,17541,17756]},{"size":"10×20","area":200,"prices":[15026,16228,16679,18407,18632]},{"size":"12×12","area":144,"prices":[12480,13479,13853,15288,15475]},{"size":"12×14","area":168,"prices":[13292,14356,14754,16283,16482]},{"size":"12×16","area":192,"prices":[14496,15656,16091,17758,17975]},{"size":"12×18","area":216,"prices":[15531,16774,17239,19026,19258]},{"size":"12×20","area":240,"prices":[16495,17815,18310,20207,20454]},{"size":"12×24","area":288,"prices":[19277,20820,21398,23615,23904]},{"size":"14×20","area":280,"prices":[19695,21271,21862,24127,24422]},{"size":"14×24","area":336,"prices":[22080,23846,24508,27048,27379]},{"size":"16×20","area":320,"prices":[21454,23170,23813,26281,26602]},{"size":"16×24","area":384,"prices":[25136,27147,27901,30792,31169]},{"size":"16×30","area":480,"prices":[29893,32284,33181,36619,37067]},{"size":"16×32","area":512,"prices":[31268,33770,34708,38303,38773]}];
const names=['Roseburg DuraTemp — Standard','LP SmartSide Vertical Textured Panel','LP SmartSide Board & Batten','LP SmartSide Lap','GP Vinyl Lap'];
const featuredSizes=["8×10", "10×12", "10×16", "12×16", "12×20", "14×20"];
const format=n=>'$'+n.toLocaleString('en-US');
const size=document.getElementById('size'),siding=document.getElementById('siding');
rows.forEach((r,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=`${r.size} · ${r.area} sq ft`;size.appendChild(o)});
function update(){const r=rows[Number(size.value)||0],type=Number(siding.value)||0;
document.getElementById('calc-price').textContent=format(r.prices[type]);
document.getElementById('calc-details').textContent=`${r.size} · ${r.area} sq ft`;
document.getElementById('calc-siding').textContent=names[type];
document.querySelectorAll('.size-card').forEach(b=>b.classList.toggle('active',b.dataset.size===r.size));}
size.addEventListener('change',update);siding.addEventListener('change',update);
const featured=document.getElementById('featured');featuredSizes.forEach(v=>{const i=rows.findIndex(r=>r.size===v);if(i<0)return;const r=rows[i];const b=document.createElement('button');b.type='button';b.className='size-card';b.dataset.size=r.size;b.innerHTML=`<strong>${r.size}</strong><span>${r.area} sq ft</span><b>From ${format(r.prices[0])}</b>`;b.addEventListener('click',()=>{size.value=String(i);update();document.getElementById('calc-price').scrollIntoView({behavior:'smooth',block:'center'});});featured.appendChild(b)});
const body=document.getElementById('price-rows');rows.forEach(r=>{const tr=document.createElement('tr');tr.innerHTML=`<td><strong>${r.size}</strong><br><small>${r.area} sq ft</small></td>`+r.prices.map(p=>`<td>${format(p)}</td>`).join('');body.appendChild(tr)});
document.getElementById('toggle-table').addEventListener('click',()=>{const area=document.getElementById('table-panel'),b=document.getElementById('toggle-table');area.hidden=!area.hidden;b.setAttribute('aria-expanded',String(!area.hidden));b.textContent=area.hidden?'View All 21 Sizes & Prices':'Hide Full Price Comparison'});
async function copySelection(){const r=rows[Number(size.value)||0],v=Number(siding.value)||0;const message=`Appalachian Sheds — Grand Depot\nBuilding size: ${r.size}\nSiding: ${names[v]}\nListed exterior-shell price: ${format(r.prices[v])}\nBuilt on site; optional services and site requirements quoted separately.`;let ok=false;try{await navigator.clipboard.writeText(message);ok=true}catch(e){const input=document.createElement('textarea');input.value=message;document.body.appendChild(input);input.select();ok=document.execCommand('copy');input.remove()}document.getElementById('copy').textContent=ok?'Selections Copied':'Copy Not Available';document.getElementById('price-status').textContent=ok?'Your selected Grand Depot details have been copied.':'Please copy your selected size, siding and price manually.';setTimeout(()=>document.getElementById('copy').textContent='Copy My Building Selections',2200)}
document.getElementById('copy').addEventListener('click',copySelection);document.getElementById('copy-bottom').addEventListener('click',copySelection);update();

</script>
