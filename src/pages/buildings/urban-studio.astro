<script is:inline>

'use strict';
const prices={"8\u00d710": [5850, 6350, 6500, 7150, 7250], "8\u00d712": [6700, 7250, 7450, 8200, 8300], "8\u00d716": [8250, 8900, 9150, 10100, 10200], "10\u00d712": [7550, 8150, 8350, 9200, 9350], "10\u00d716": [9650, 10400, 10700, 11800, 11950], "10\u00d720": [11350, 12250, 12550, 13850, 14050]};
const sidings=["Roseburg DuraTemp", "LP SmartSide Vertical Panel", "LP SmartSide Board & Batten", "LP SmartSide Lap", "GP Vinyl Lap"];
const sizeEl=document.getElementById('size');const sidingEl=document.getElementById('siding');
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
function update(){const size=sizeEl.value,idx=Number(sidingEl.value);const [a,b]=size.split('×').map(Number);document.getElementById('live-price').textContent=money(prices[size][idx]);document.getElementById('live-size').textContent=`${a} × ${b} · ${a*b} sq ft`;document.getElementById('live-siding').textContent=sidings[idx]+(idx===0?' · Standard included siding':' · Optional siding selection');}
sizeEl.addEventListener('change',update);sidingEl.addEventListener('change',update);update();

</script>
