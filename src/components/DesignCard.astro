---
// A custom design card: rendering, name, use, starting model and (once confirmed) its price range,
// with an open list of every line counted in the as-shown price.
import DesignFigure from './DesignFigure.astro';
import { link, shellScope } from '../data/site.js';
import { useLabels } from '../data/custom-designs.js';

const { d } = Astro.props;
const p = d.price;
const request = `${link('/start-your-project/')}?model=${encodeURIComponent('Custom building')}&size=${encodeURIComponent(p.size)}&design=${encodeURIComponent(d.name)}#project-form`;
---
<article class="dc" id={d.slug}>
  <DesignFigure imageKey={d.images[0].key} alt={d.images[0].alt} label="short" sizes="(max-width: 700px) 94vw, (max-width: 1100px) 46vw, 31vw" />
  <div class="dc__body">
    <p class="dc__use">{useLabels[d.use]} · Custom Design</p>
    <h3>{d.name}</h3>
    <p class="dc__sum">{d.summary}</p>
    {d.confirmed ? (
      <>
        <dl class="dc__price">
          <div><dt>Base building</dt><dd>{p.text.base}</dd></div>
          <div><dt>As shown, about</dt><dd>{p.text.asShown}</dd></div>
        </dl>
        <details class="dc__lines">
          <summary>What the as-shown price counts</summary>
          <ul>
            <li><span><a href={link(p.model.path)}>{p.model.name.replace('Appalachian ', '')}</a>, {p.size}, {p.siding}</span><strong>{p.text.base}</strong></li>
            {p.lines.map((l) => <li><span><a href={link(l.path)}>{l.label}</a></span><strong>{l.text}</strong></li>)}
          </ul>
          <p>Published installed planning prices, rounded to the nearest $500. Site work, paint or stain, and any interior work are not included.</p>
        </details>
      </>
    ) : (
      <p class="dc__ask">Ask Edwin for this design’s price</p>
    )}
    <p class="dc__from">Starts from the <a href={link(p.model.path)}>{p.model.name.replace('Appalachian ', '')}</a> · {p.size}</p>
    <p class="dc__scope">{shellScope.short}</p>
    <a class="btn btn--primary dc__btn" href={request}>Request This Design</a>
  </div>
</article>

<style is:global>
  .dc { background: #fff; border: 1px solid var(--stone); border-top: 4px solid var(--bronze); color: var(--steel); display: flex; flex-direction: column; }
  .dc .df figcaption { padding: 0 18px; }
  .dc__body { padding: 14px 18px 20px; display: flex; flex-direction: column; flex: 1; }
  .dc__use { margin: 0 0 6px; color: var(--bronze-dark); font-weight: 900; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .dc h3 { margin: 0 0 8px; font-size: 1.2rem; }
  .dc__sum { margin: 0 0 14px; font-weight: 700; font-size: 0.93rem; }
  .dc__price { margin: 0 0 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .dc__price div { background: var(--ivory); padding: 10px 12px; }
  .dc__price dt { font-size: 0.78rem; font-weight: 800; color: #6f6a62; }
  .dc__price dd { margin: 2px 0 0; font-weight: 900; font-size: 1.05rem; }
  .dc__lines { margin: 0 0 12px; font-size: 0.85rem; }
  .dc__lines summary { cursor: pointer; font-weight: 900; color: var(--bronze-dark); }
  .dc__lines ul { list-style: none; margin: 8px 0; padding: 0; }
  .dc__lines li { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--cashmere); font-weight: 700; }
  .dc__lines li a { color: var(--steel); }
  .dc__lines li strong { white-space: nowrap; }
  .dc__lines p { margin: 6px 0 0; font-weight: 600; color: #6f6a62; }
  .dc__ask { margin: 0 0 10px; font-weight: 900; color: var(--bronze-dark); }
  .dc__from { margin: 0 0 6px; font-size: 0.88rem; font-weight: 700; }
  .dc__from a { color: var(--bronze-dark); }
  .dc__scope { margin: 0 0 16px; font-size: 0.82rem; font-weight: 700; color: #6f6a62; }
  .dc__btn { margin-top: auto; text-align: center; }
</style>
