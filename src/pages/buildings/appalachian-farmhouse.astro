---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Appalachian Farmhouse Pricing | Appalachian Sheds Inc.";
---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div>\n<header class=\"hero\"><div class=\"wrap\"><div class=\"nav\"><div class=\"brand\">Appalachian Sheds Inc.</div><small>Veteran &amp; Family-Owned \u00b7 Built on Site \u00b7 Greater Cincinnati Tri-State</small></div><div class=\"hero-grid asi-standard-hero-grid\"><div><div class=\"eyebrow\">Distinctive Appalachian-inspired construction</div><h1>The Appalachian Farmhouse Pricing.</h1><p>A traditional farmhouse silhouette, a welcoming covered porch, and carefully crafted details\u2014built on site for your property. Explore 21 sizes and five exterior siding choices.</p><p class=\"small muted\">8/12 gable roof \u00b7 Covered front porch \u00b7 Cupola \u00b7 On-site construction</p><div class=\"actions\"><a class=\"btn\" href=\"#pricing\">See Your Price</a><a class=\"btn secondary\" href=\"#sizes\">Choose Your Size</a></div></div><div class=\"asi-standard-hero-media\"><img alt=\"The Appalachian Farmhouse in cream vertical siding with forest-green doors and shutters, a timber porch, and a roof cupola in an autumn backyard.\" class=\"hero-image\" src=\"/models/appalachian-farmhouse.jpg\"/></div></div></div></header>\n<section class=\"light\" id=\"pricing\"><div class=\"wrap\"><div class=\"eyebrow\">Explore your options</div><h2>See Your Price</h2><p class=\"intro\">Choose a size and exterior siding type to see the listed building price. Every Appalachian Farmhouse is constructed on your property by our crew.</p><div class=\"calculator\"><div class=\"panel\"><label class=\"field\" for=\"size\">Choose Your Size</label><select id=\"size\"></select><label class=\"field\" for=\"siding\">Choose Your Siding</label><select id=\"siding\"><option value=\"dura\">Roseburg DuraTemp \u2014 Standard</option><option value=\"smart\">LP SmartSide Vertical Textured Panel</option><option value=\"board\">LP SmartSide Board &amp; Batten</option><option value=\"lap\">LP SmartSide Lap</option><option value=\"vinyl\">GP Vinyl Lap</option></select><p class=\"small muted\">The displayed price reflects the selected building size and siding. Site conditions, requested upgrades, and applicable taxes or permit costs may affect the written proposal.</p></div><div class=\"price-panel\"><div class=\"eyebrow\">Your selected building price</div><div aria-live=\"polite\" class=\"price\" id=\"price\"></div><div><strong id=\"dimension\"></strong> \u00b7 Building height: <strong id=\"height\"></strong></div><div class=\"muted\" id=\"sidingName\"></div><div class=\"actions\"><a class=\"btn\" href=\"mailto:info@appalachiansheds.com?subject=Appalachian%20Farmhouse%20Written%20Proposal\">Request a Written Proposal</a></div></div></div><div class=\"disclosure\"><strong>Important: Exterior weather-tight shell only</strong>Standard pricing is for a weather-tight exterior building shell. Interior wall and ceiling finishes, insulation, electrical work, and other interior finish work are not included unless separately specified. Required exterior caulking/sealing and painting or staining must be completed within 30 days after construction, as applicable to the selected materials. Ask about our optional complete exterior painting service.</div></div></section>\n<section class=\"alt\" id=\"sizes\"><div class=\"wrap\"><div class=\"eyebrow\">Building options</div><h2>Popular Sizes &amp; Complete Pricing</h2><p class=\"intro\">Start with six practical sizes, or expand the complete schedule to compare all 21 building sizes and five siding selections.</p><div class=\"table-wrap\"><table><thead><tr><th>Building size</th><th>Roseburg DuraTemp<br/><small>Included standard</small></th><th>LP SmartSide<br/>Vertical Panel</th><th>LP SmartSide<br/>Board &amp; Batten</th><th>LP SmartSide<br/>Lap</th><th>GP Vinyl<br/>Lap</th></tr></thead><tbody id=\"featured-rows\"></tbody></table></div><details><summary>View the complete 21-size pricing schedule</summary><div class=\"table-wrap\"><table><thead><tr><th>Building size</th><th>Roseburg DuraTemp<br/><small>Included standard</small></th><th>LP SmartSide<br/>Vertical Panel</th><th>LP SmartSide<br/>Board &amp; Batten</th><th>LP SmartSide<br/>Lap</th><th>GP Vinyl<br/>Lap</th></tr></thead><tbody id=\"all-rows\"></tbody></table></div></details><h3>Approximate Building Heights by Width</h3><div class=\"height-list\"><div><b>8\u2032 wide</b>10\u2032 7\u2033 tall</div><div><b>10\u2032 wide</b>11\u2032 0\u2033 tall</div><div><b>12\u2032 wide</b>11\u2032 5\u2033 tall</div><div><b>14\u2032 wide</b>11\u2032 11\u2033 tall</div><div><b>16\u2032 wide</b>12\u2032 5\u2033 tall</div></div><p class=\"note\">Building heights are based on the published model schedule; confirm final dimensions and local requirements during site and proposal review.</p></div></section>\n<section class=\"dark\"><div class=\"wrap\"><div class=\"eyebrow\">Built with purpose</div><h2>Superior Standard Features</h2><p class=\"intro\">Premium materials and on-site workmanship are central to every Appalachian Farmhouse.</p><div class=\"feature-grid\"><div class=\"feature\"><strong>Pressure-Treated Foundation</strong>4\u00d76 pressure-treated beams supported on 16\u00d716\u00d74-inch solid concrete pads, with an engineered layout based on building size and loads.</div><div class=\"feature\"><strong>Strong Floor System</strong>2\u00d76 pressure-treated joists at 16\u2033 on center and \u00be\u2033 pressure-treated exterior-rated plywood decking.</div><div class=\"feature\"><strong>Precisely Framed Walls</strong>2\u00d74 kiln-dried studs at 16\u2033 on center.</div><div class=\"feature\"><strong>Classic 8/12 Roof</strong>Engineered traditional roof framing, \u00bd\u2033 CDX plywood sheathing, architectural shingles, and appropriate underlayment.</div><div class=\"feature\"><strong>Roof Ventilation</strong>Ridge vent ventilation for the traditional roof assembly.</div><div class=\"feature\"><strong>Craftsman Details</strong>Cedar trim and fascia, weather-sealed openings, and distinctive farmhouse-style architectural details.</div></div><p class=\"small muted\" style=\"margin-top:22px\">Featured farmhouse doors, windows, porch details, and cupola are subject to the selected written configuration. Final specifications are confirmed in your proposal.</p></div><figure class=\"asi-feature-showcase\" data-approved-model=\"appalachian-farmhouse\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"The Appalachian Farmhouse \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/appalachian-farmhouse.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"light\"><div class=\"wrap\"><div class=\"eyebrow\">Craftsmanship and character</div><h2>Exterior Gallery</h2><div class=\"gallery\"><img alt=\"Appalachian Farmhouse front and side exterior with covered timber porch and cupola.\" src=\"/standard-features/appalachian-farmhouse.png\"/><div><h3>Traditional Farmhouse Character</h3><p>Board-and-batten-inspired vertical lines, deep-green accents, a substantial covered porch, and a classic roofline create an inviting backyard landmark.</p><p class=\"muted small\">Shown: exterior architectural presentation. Final materials and features are established in the written proposal.</p></div></div></div></section>\n<section class=\"light\"><div class=\"wrap\"><div class=\"eyebrow\">Good to know</div><h2>Frequently Asked Questions</h2><details class=\"faq\"><summary>Is the Appalachian Farmhouse built on my property?</summary><p>Yes. All Appalachian Sheds buildings are constructed on site. Each building is constructed on site by our crew.</p></details><details class=\"faq\"><summary>Does the listed price include a finished interior?</summary><p>No. The standard product is an exterior weather-tight shell. Interior insulation, finish materials, electrical work, and other interior improvements are separate options when offered and specified.</p></details><details class=\"faq\"><summary>When does the exterior need to be painted or stained?</summary><p>Required exterior caulking/sealing and painting or staining must be completed within 30 days of construction, as appropriate for the specified siding and trim. We also offer an optional complete exterior painting service.</p></details><details class=\"faq\"><summary>What if my property needs additional leveling?</summary><p>Standard foundation leveling covers up to 6 inches of out-of-level conditions. Additional leveling or site preparation is quoted in writing.</p></details><details class=\"faq\"><summary>Can I select a size not featured in the quick comparison?</summary><p>Yes. The complete pricing schedule includes 21 sizes. We can also review larger or specialized dimensions in a written proposal.</p></details><details class=\"faq\"><summary>Does the listed price account for my property's requirements?</summary><p>Your written proposal confirms the final building configuration and addresses site access, support and anchorage requirements, requested options, and other applicable project costs.</p></details></div></section>\n<section class=\"dark\"><div class=\"wrap\"><div class=\"eyebrow\">A building made for your property</div><h2>Ready to Plan Your Appalachian Farmhouse?</h2><p>Tell us about your property and preferred size. We will review the site conditions and put the scope and price in writing.</p><div class=\"actions\"><a class=\"btn\" href=\"mailto:info@appalachiansheds.com?subject=Request%20an%20Appalachian%20Farmhouse%20Property%20Walk-Through\">Request a Property Walk-Through</a><a class=\"btn secondary\" href=\"mailto:info@appalachiansheds.com?subject=Appalachian%20Farmhouse%20Site%20and%20Pad%20Plan\">Review the Site &amp; Pad Plan</a></div></div></section><section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n<footer><div class=\"wrap\"><strong>Appalachian Sheds Inc.</strong><p class=\"small muted\">Veteran &amp; Family-Owned \u00b7 Premium Backyard Structures \u00b7 Built on Site</p></div></footer><section aria-labelledby=\"asi-construction-heading\" class=\"asi-construction-bridge\"><div class=\"asi-construction-bridge__inner\"><div><div class=\"asi-construction-bridge__eyebrow\">Our Craftsmanship</div><h2 id=\"asi-construction-heading\">Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. Our shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"asi-construction-bridge__button\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p class=\"asi-construction-bridge__note\">Standard buildings are weather-tight exterior shells; interior finishes are not included. Required exterior caulking and painting or staining must be completed within 30 days. Optional finishing services are available.</p></div><div class=\"asi-construction-bridge__features\"><div><strong>Foundation &amp; floor</strong><span>Pressure-treated framing and solid concrete support pads</span></div><div><strong>Walls &amp; roof</strong><span>Purpose-built structure suited to the model and site</span></div><div><strong>Weather protection</strong><span>Roofing, flashing, ventilation and exterior detailing</span></div></div></div></section>\n"} />
</Base>

<style is:global>

:root{--dark:#2B3030;--ink:#2B3030;--cream:#F8F7F4;--sand:#E1DED8;--cedar:#C9A06C;--green:#2E473A}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Montserrat,Arial,sans-serif;font-style:italic;line-height:1.58}h1{font-family:Merriweather,Georgia,serif;font-style:italic;font-size:clamp(2.4rem,5vw,4.7rem);line-height:1.12;margin:0 0 20px}h2,h3{font-weight:700;line-height:1.25}h2{font-size:clamp(1.7rem,3.1vw,2.6rem);margin:0 0 16px}h3{font-size:1.16rem}.wrap{width:94%;max-width:1440px;margin:auto}.muted{opacity:.78}.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:.75rem;font-weight:700}.hero{background:var(--dark);color:white}.nav{padding:18px 0;display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid #ffffff28}.brand{font-weight:800;letter-spacing:.09em;text-transform:uppercase}.nav small{opacity:.75}.hero-grid{display:grid;grid-template-columns:1fr 1.12fr;align-items:center;gap:5%;padding:45px 0 65px}.hero-image{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:7px;box-shadow:0 20px 55px #0006}.hero p{max-width:58ch}.btn{background:var(--green);color:#fff;padding:13px 22px;border:0;border-radius:4px;display:inline-block;text-decoration:none;font:inherit;font-weight:700;cursor:pointer}.btn.secondary{background:transparent;border:1px solid #ffffff8c}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}section{padding:72px 0}.light{background:var(--cream)}.alt{background:var(--sand)}.dark{background:var(--dark);color:white}.intro{max-width:800px;margin-bottom:30px}.calculator{display:grid;grid-template-columns:1fr .9fr;gap:28px}.panel{background:white;border-radius:7px;padding:28px;box-shadow:0 4px 18px #0000000d}.field{display:block;font-weight:700;margin:12px 0 8px}select{width:100%;padding:14px;background:#fff;border:1px solid #bbb;border-radius:4px;font:inherit;color:var(--ink)}.price-panel{background:var(--dark);color:white;border-radius:7px;padding:30px;display:flex;flex-direction:column;justify-content:center}.price{font-size:clamp(2.5rem,5vw,4rem);font-weight:800;line-height:1.2;margin:10px 0}.small{font-size:.88rem}.disclosure{padding:18px 20px;border-left:4px solid var(--cedar);background:#f0ede7;margin-top:25px;color:#343a37}.disclosure strong{display:block;margin-bottom:5px}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:24px}.feature{border:1px solid #ffffff25;padding:20px;border-radius:5px;background:#ffffff0b}.feature strong{display:block}.table-wrap{overflow-x:auto;border-radius:6px;border:1px solid #d6d1c8}table{width:100%;border-collapse:collapse;min-width:830px;font-size:.88rem}th{padding:14px 12px;background:var(--dark);color:#fff;text-align:right;vertical-align:bottom}th:first-child,td:first-child{text-align:left}th:nth-child(2){background:#375c47}th:nth-child(3){background:#496b63}th:nth-child(4){background:#786445}th:nth-child(5){background:#4a5669}th:nth-child(6){background:#65536b}td{padding:11px 12px;text-align:right}tr:nth-child(even){background:#ebe8e2}tr:nth-child(odd){background:#fff}td:first-child{font-weight:800}details{margin-top:20px}summary{cursor:pointer;font-weight:800;padding:15px 0}.height-list{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:28px}.height-list>div{border:1px solid #c8c4bc;border-radius:4px;padding:15px}.height-list b{display:block}.gallery{display:grid;grid-template-columns:1.5fr 1fr;gap:24px;align-items:center}.gallery img{width:100%;border-radius:6px;aspect-ratio:4/3;object-fit:cover}.empty{border:2px dashed #c6bfb6;border-radius:6px;min-height:220px;display:grid;place-items:center;padding:25px;text-align:center}details.faq{background:#fff;padding:12px 22px;border:1px solid #d6d1c8;margin:10px 0}details.faq p{margin:0 0 14px}footer{background:#202525;color:#fff;padding:36px 0}.note{font-size:.81rem;opacity:.78}@media(max-width:850px){.hero-grid,.calculator,.gallery{grid-template-columns:1fr}.feature-grid{grid-template-columns:repeat(2,1fr)}.height-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.feature-grid,.height-list{grid-template-columns:1fr}.nav{align-items:flex-start;flex-direction:column}section{padding:52px 0}.hero-grid{padding:35px 0 50px}}

</style>

<script is:inline>
const data=[{"size":"8x8","dura":8257,"smart":8918,"board":9165,"lap":10115,"vinyl":10239},{"size":"8x10","dura":9074,"smart":9800,"board":10072,"lap":11116,"vinyl":11252},{"size":"8x12","dura":9680,"smart":10454,"board":10745,"lap":11858,"vinyl":12003},{"size":"10x10","dura":10006,"smart":10806,"board":11107,"lap":12257,"vinyl":12407},{"size":"10x12","dura":10874,"smart":11744,"board":12070,"lap":13321,"vinyl":13484},{"size":"10x14","dura":11741,"smart":12680,"board":13033,"lap":14383,"vinyl":14559},{"size":"10x16","dura":12533,"smart":13536,"board":13912,"lap":15353,"vinyl":15541},{"size":"10x18","dura":13719,"smart":14817,"board":15228,"lap":16806,"vinyl":17012},{"size":"10x20","dura":14829,"smart":16015,"board":16460,"lap":18166,"vinyl":18388},{"size":"12x12","dura":11661,"smart":12594,"board":12944,"lap":14285,"vinyl":14460},{"size":"12x14","dura":12457,"smart":13454,"board":13827,"lap":15260,"vinyl":15447},{"size":"12x16","dura":13621,"smart":14711,"board":15119,"lap":16686,"vinyl":16890},{"size":"12x18","dura":14930,"smart":16124,"board":16572,"lap":18289,"vinyl":18513},{"size":"12x20","dura":16393,"smart":17704,"board":18196,"lap":20081,"vinyl":20327},{"size":"12x24","dura":18337,"smart":19804,"board":20354,"lap":22463,"vinyl":22738},{"size":"14x20","dura":18481,"smart":19959,"board":20514,"lap":22639,"vinyl":22916},{"size":"14x24","dura":20698,"smart":22354,"board":22975,"lap":25355,"vinyl":25666},{"size":"16x20","dura":19457,"smart":21014,"board":21597,"lap":23835,"vinyl":24127},{"size":"16x24","dura":21936,"smart":23691,"board":24349,"lap":26872,"vinyl":27201},{"size":"16x30","dura":26862,"smart":29011,"board":29817,"lap":32906,"vinyl":33309},{"size":"16x32","dura":27998,"smart":30238,"board":31078,"lap":34298,"vinyl":34718}];const preferred=["8x10", "10x12", "10x16", "12x16", "12x20", "16x20"];const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);const sizeEl=document.getElementById('size');const sideEl=document.getElementById('siding');const sizes=data.map(x=>x.size);sizeEl.innerHTML=sizes.map(s=>`<option value="${s}" ${s==='10x16'?'selected':''}>${s.replace('x','′ × ')}′${preferred.includes(s)?' · Featured':''}</option>`).join('');function update(){let r=data.find(x=>x.size===sizeEl.value);let key=sideEl.value;document.getElementById('price').textContent=money(r[key]);document.getElementById('dimension').textContent=r.size.replace('x','′ × ')+'′';document.getElementById('height').textContent={"8": "10\u2032 7\u2033", "10": "11\u2032 0\u2033", "12": "11\u2032 5\u2033", "14": "11\u2032 11\u2033", "16": "12\u2032 5\u2033"}[r.size.split('x')[0]];document.getElementById('sidingName').textContent=sideEl.options[sideEl.selectedIndex].text;}sizeEl.addEventListener('change',update);sideEl.addEventListener('change',update);update();let table=document.getElementById('all-rows');table.innerHTML=data.map(r=>`<tr><td>${r.size.replace('x','′ × ')}′</td><td>${money(r.dura)}</td><td>${money(r.smart)}</td><td>${money(r.board)}</td><td>${money(r.lap)}</td><td>${money(r.vinyl)}</td></tr>`).join('');let featuredRows=document.getElementById('featured-rows');featuredRows.innerHTML=data.filter(r=>preferred.includes(r.size)).map(r=>`<tr><td>${r.size.replace('x','′ × ')}′</td><td>${money(r.dura)}</td><td>${money(r.smart)}</td><td>${money(r.board)}</td><td>${money(r.lap)}</td><td>${money(r.vinyl)}</td></tr>`).join('');
</script>
