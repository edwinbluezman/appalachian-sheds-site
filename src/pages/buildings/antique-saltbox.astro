---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Antique Saltbox Pricing | Appalachian Sheds Inc.";
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is interior finishing included in the standard Antique Saltbox?", "acceptedAnswer": {"@type": "Answer", "text": "No. Our crew builds your weather-tight exterior shell on your property. Interior wall and ceiling finishes are not included unless separately quoted."}}, {"@type": "Question", "name": "Is my Antique Saltbox built on my property?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Every Appalachian Sheds building is constructed on site by our crew. We do not bring a completed shed to your property."}}, {"@type": "Question", "name": "Is the cupola included in the quoted prices?", "acceptedAnswer": {"@type": "Answer", "text": "The cupola shown is a decorative option. Ask to include it in your written proposal."}}, {"@type": "Question", "name": "Do I have to paint or stain the building?", "acceptedAnswer": {"@type": "Answer", "text": "Exterior caulking/sealing and painting or staining must be completed within 30 days of construction as applicable to the selected materials. ASI can quote its complete painting service."}}, {"@type": "Question", "name": "How is my final price determined?", "acceptedAnswer": {"@type": "Answer", "text": "Choose your size and siding to see the starting building price. Your written proposal will include selected options, site conditions, required preparation, finishing services, and any applicable taxes."}}, {"@type": "Question", "name": "Can I choose different doors and windows?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. We will review your preferred door style, window arrangement and decorative features as part of your written proposal. The photograph may show optional design elements."}}]};

---
<Base title={pageTitle}>
<Fragment set:html={"\n<div class=\"dark topline\"><div class=\"shell\">Appalachian Sheds Inc. \u00a0 / \u00a0 Model 11 of 12 \u00a0 / \u00a0 Antique Saltbox \u00b7 Sizes &amp; Pricing</div></div>\n<section class=\"dark pad\"><div class=\"shell hero asi-standard-hero-grid\"><div><span class=\"eyebrow\">Antique architecture \u00b7 Built on Site \u2014 Always \u00b7 Cincinnati &amp; Tri-State</span><h1>The Antique Saltbox Pricing.</h1><p>Historic saltbox character, timeless cedar detailing, and a backyard building constructed entirely on your property by our crew. Every Appalachian Sheds building is built on site \u2014 without exception.</p><p>Explore 23 available sizes and compare pricing across five exterior siding choices. Find the Antique Saltbox that fits your property, then request a detailed written proposal tailored to your site and selections.</p><div class=\"buttons\"><a class=\"btn\" href=\"#calculator\">See Your Price</a><a class=\"btn outline\" href=\"#features\">Review Standard Features</a></div><p class=\"photo-note\">Veteran- and family-owned \u00b7 Every Building Built on Site</p></div><div class=\"asi-hero-media-group\"><figure class=\"asi-standard-hero-media\"><img alt=\"Antique Saltbox garden building with sage-green vertical siding, cedar French doors, wood-framed windows, and an optional cupola\" src=\"/models/antique-saltbox.jpg\"/></figure><div class=\"asi-hero-caption\">The Antique Saltbox shown with distinctive divided-light doors, natural cedar detailing, and a decorative cupola. Pictured options may affect pricing.</div></div></div></section>\n<section class=\"pad\" id=\"calculator\"><div class=\"shell\"><span class=\"eyebrow\">Explore Your Price</span><h2>See Your Antique Saltbox Price.</h2><p>Choose a building size and one of five siding options. Explore six popular sizes below, or expand the complete 23-size comparison table for more options.</p>\n<div class=\"asi-pricing-layout\"><div class=\"asi-pricing-inputs\"><label for=\"asi-size\">Choose Your Size</label><select aria-label=\"Choose Antique Saltbox building size\" id=\"asi-size\"></select><label for=\"asi-siding\">Choose Your Siding</label><select aria-label=\"Choose siding option\" id=\"asi-siding\"></select><p class=\"asi-muted\">All buildings are constructed on your property as weather-tight exterior shells. Final site conditions and optional finishes are addressed in your written proposal.</p></div>\n<div aria-live=\"polite\" class=\"asi-price-result\"><div class=\"asi-result-kicker\">YOUR ANTIQUE SALTBOX PRICE</div><div class=\"asi-big-price\" id=\"asi-price\">\u2014</div><div class=\"asi-result-selection\" id=\"asi-selected-label\"></div><p>Pricing reflects the selected building size and siding. Optional services are quoted separately.</p><a class=\"asi-result-cta\" href=\"#proposal\">Request a Written Proposal</a></div></div>\n<h3 class=\"asi-featured-title\">Popular Building Sizes</h3><div class=\"asi-featured\" id=\"asi-featured\"></div><div class=\"asi-center\"><a class=\"btn outline asi-see-all\" href=\"#sheet\">Compare All 23 Sizes and Five Sidings</a></div></div></section>\n<section class=\"dark pad\" id=\"sheet\"><div class=\"shell\"><span class=\"eyebrow\">Transparent Model Pricing</span><h2>Complete 23-Size Pricing Comparison</h2><p>Compare sizes and siding selections at a glance. Your final written proposal will identify all selected options and any necessary site work.</p><details><summary>Open the full pricing table \u2014 23 sizes \u00d7 5 siding types</summary><div class=\"tablewrap\"><table><thead><tr><th>Size</th><th>DuraTemp</th><th>LP Vertical</th><th>LP Board &amp; Batten</th><th>LP Lap</th><th>GP Vinyl Lap</th></tr></thead><tbody id=\"allrows\"></tbody></table></div></details><div class=\"notice dark-note\">Prices shown are for the standard exterior building shell in the selected size and siding. Painting, staining, site work beyond included leveling, custom features, and applicable taxes are priced separately where required.</div></div></section>\n<section class=\"sand pad\" id=\"features\"><div class=\"shell\"><span class=\"eyebrow\">Model-Specific Construction</span><h2>Superior Standard Features</h2><div class=\"cols\"><article class=\"tile\"><h3>Foundation &amp; Floor</h3><p>4\u00d76 pressure-treated foundation beams; 16\u00d716\u00d74-inch solid concrete pads; 2\u00d76 pressure-treated joists at 16 inches on center; \u00be-inch pressure-treated exterior-rated plywood floor.</p></article><article class=\"tile\"><h3>Walls &amp; Exterior</h3><p>2\u00d74 kiln-dried wall studs at 16 inches on center; Roseburg DuraTemp standard siding; natural unfinished cedar trim, with available siding and finish upgrades.</p></article><article class=\"tile\"><h3>Roof &amp; Weather Protection</h3><p>\u00bd-inch CDX plywood roof decking, architectural asphalt shingles and synthetic underlayment. Roof framing and ventilation are designed for the Antique Saltbox roof profile.</p></article><article class=\"tile\"><h3>Doors &amp; Windows</h3><p>Traditional Craftsman-style doors and functional windows are available. Door and window styles, quantities, locations and pricing are specified in your written proposal.</p></article><article class=\"tile\"><h3>Built on Site \u2014 Always</h3><p>Every building is constructed on your property, never transported as a completed structure. Engineered pad spacing and anchors. Up to 6 inches of foundation leveling included; additional grading and preparation quoted in writing.</p></article><article class=\"tile\"><h3>Workmanship</h3><p>10-year workmanship warranty, subject to written terms. Applicable manufacturer product warranties are identified separately rather than replaced with an unsupported structural guarantee.</p></article></div><p class=\"photo-note\" style=\"margin-top:20px\">The photograph illustrates the Antique Saltbox design. Decorative accents, specialty doors and windows, and the cupola may be optional and will be identified in your written proposal.</p></div><figure class=\"asi-feature-showcase\" data-approved-model=\"antique-saltbox\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"Antique Saltbox \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/antique-saltbox.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"pad\"><div class=\"shell\"><span class=\"eyebrow\">Your Building, Your Finish</span><h2>Five Siding Choices</h2><div class=\"cols\"><article class=\"tile\"><h3>Roseburg DuraTemp</h3><p>Included standard siding.</p></article><article class=\"tile\"><h3>LP SmartSide Vertical Textured Panel</h3><p>Premium upgrade from standard DuraTemp.</p></article><article class=\"tile\"><h3>LP SmartSide Board &amp; Batten</h3><p>Optional board-and-batten siding upgrade.</p></article><article class=\"tile\"><h3>LP SmartSide Lap</h3><p>Optional horizontal lap siding upgrade.</p></article><article class=\"tile\"><h3>Georgia-Pacific Vinyl Lap</h3><p>Optional vinyl lap siding upgrade.</p></article></div><div class=\"notice\"><strong>Exterior shell and care requirements.</strong> Standard pricing is for a weather-tight exterior shell, not finished interior walls or ceilings. Required exterior caulking/sealing and painting or staining must be completed within 30 days following construction, as applicable to the siding and trim materials selected. Appalachian Sheds offers an optional complete exterior painting service.</div></div></section>\n<section class=\"dark pad\"><div class=\"shell\"><span class=\"eyebrow\">Model #11 Architecture</span><h2>What Makes the Antique Saltbox Different?</h2><div class=\"cols\"><article><h3>Historic Profile</h3><p>An asymmetrical saltbox roof silhouette with a prominent traditional gable.</p></article><article><h3>Cottage-Style Detailing</h3><p>Natural wood trim and divided-light glazing lend the building its antique character.</p></article><article><h3>Personalization</h3><p>Siding choices, finishes, upgraded doors, windows and optional cupola can be confirmed through a written proposal.</p></article></div></div></section>\n<section class=\"pad sand\"><div class=\"shell\"><span class=\"eyebrow\">Design Gallery</span><h2>Exterior Gallery</h2><div class=\"gallery\"><div><h3>Exterior Gallery</h3><img alt=\"Exterior Antique Saltbox reference with green siding and optional cupola\" src=\"/standard-features/antique-saltbox.png\"/><p class=\"photo-note\">See the Antique Saltbox exterior and its traditional detailing.</p></div></div></div></section>\n<section aria-labelledby=\"asi-construction-heading\" class=\"asi-construction-bridge\"><div class=\"asi-construction-bridge__inner\"><div><div class=\"asi-construction-bridge__eyebrow\">Our Craftsmanship</div><h2 id=\"asi-construction-heading\">Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. Our shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"asi-construction-bridge__button\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p class=\"asi-construction-bridge__note\">Standard buildings are weather-tight exterior shells; interior finishes are not included. Required exterior caulking and painting or staining must be completed within 30 days. Optional finishing services are available.</p></div><div class=\"asi-construction-bridge__features\"><div><strong>Foundation &amp; floor</strong><span>Pressure-treated framing and solid concrete support pads</span></div><div><strong>Walls &amp; roof</strong><span>Purpose-built structure suited to the model and site</span></div><div><strong>Weather protection</strong><span>Roofing, flashing, ventilation and exterior detailing</span></div></div></div></section><section class=\"pad\" id=\"faq\"><div class=\"shell faq\"><span class=\"eyebrow\">Frequently Asked Questions</span><h2>Questions Worth Answering Before You Build</h2><details><summary>Is interior finishing included in the standard Antique Saltbox?</summary><p>No. Our crew builds your weather-tight exterior shell on your property. Interior wall and ceiling finishes are not included unless separately quoted.</p></details><details><summary>Is my Antique Saltbox built on my property?</summary><p>Yes. Every Appalachian Sheds building is constructed on site by our crew. We do not bring a completed shed to your property.</p></details><details><summary>Is the cupola included in the quoted prices?</summary><p>The cupola shown is a decorative option. Ask to include it in your written proposal.</p></details><details><summary>Do I have to paint or stain the building?</summary><p>Exterior caulking/sealing and painting or staining must be completed within 30 days of construction as applicable to the selected materials. ASI can quote its complete painting service.</p></details><details><summary>How is my final price determined?</summary><p>Choose your size and siding to see the starting building price. Your written proposal will include selected options, site conditions, required preparation, finishing services, and any applicable taxes.</p></details><details><summary>Can I choose different doors and windows?</summary><p>Yes. We will review your preferred door style, window arrangement and decorative features as part of your written proposal. The photograph may show optional design elements.</p></details></div></section>\n<section class=\"dark pad\" id=\"proposal\"><div class=\"shell\"><span class=\"eyebrow\">Your Project Starts With a Site Plan</span><h2>Let's Make Sure the Design Fits Your Property.</h2><p>Review your preferred size, placement, site access, siding, doors and windows with our team. We will prepare a written proposal that reflects your property and selected features.</p><div class=\"buttons\"><a class=\"btn\" href=\"tel:15133792421\">Request a Property Walk-Through</a><a class=\"btn outline\" href=\"#calculator\">Choose Your Size</a></div></div></section><section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n\n\n"} />

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style is:global>

:root{--deep:#2B3030;--black:#2B3030;--light:#F8F7F4;--sand:#E1DED8;--bronze:#C9A06C;--muted:#b7c1bc}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--light);color:var(--deep);font:italic 500 15px/1.7 Montserrat,Arial,sans-serif}h1{font:italic 900 clamp(2.5rem,5vw,4.35rem)/1.14 Merriweather,Georgia,serif;letter-spacing:-.035em}h2{font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.25}h3{font-size:1.15rem}.shell{width:94%;max-width:1440px;margin:auto}.pad{padding:75px 0}p{max-width:72ch}a{color:inherit}.dark{background:var(--deep);color:var(--light)}.sand{background:var(--sand)}.eyebrow{font-size:.7rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--bronze)}.hero{display:grid;grid-template-columns:1fr 1.05fr;gap:5%;align-items:center}.hero h1{margin:12px 0 20px}.hero p{color:#e5e5e0}.hero img{width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid #8f897f}.photo-note{font-size:.73rem;line-height:1.5;opacity:.75}.buttons{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0}.btn{display:inline-block;background:var(--bronze);color:#222a26;padding:13px 22px;text-decoration:none;font-weight:800;font-size:.77rem;letter-spacing:.04em;border:1px solid var(--bronze)}.btn.outline{background:transparent;color:inherit;border-color:currentColor}.topline{border-bottom:1px solid #777a7544;padding:12px 0;font-size:.73rem;letter-spacing:.1em;text-transform:uppercase}.notice{border-left:4px solid #aa8c61;padding:16px 20px;background:#f0eae0;color:#363128;margin:24px 0}.notice.dark-note{background:#3b4140;color:#f7f3eb}.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tile{background:#fff;padding:25px;border-top:3px solid var(--bronze)}.tile p{margin-bottom:0}.pick{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 26px}.pick button{font:inherit;cursor:pointer;border:1px solid #999;padding:12px 18px;background:white;color:#232828;font-weight:700}.pick button[aria-pressed=true]{background:var(--deep);color:white;border-color:var(--deep)}.price-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.price-card{border:1px solid #c3c0b9;padding:18px 14px;background:white;cursor:pointer;text-align:left;font:inherit;min-height:145px}.price-card.active{border:2px solid #9b815f;background:#303634;color:white}.price-card strong{display:block;font-size:1.55rem;line-height:1.2;margin:12px 0}.price-card small{font-size:.7rem}.selected{margin:24px 0 0;padding:25px;background:#303634;color:white;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}.selected strong{font-size:2.35rem}.tablewrap{overflow-x:auto;margin-top:25px;border:1px solid #80796d}table{width:100%;border-collapse:collapse;min-width:800px;text-align:right;font-size:.82rem}th,td{padding:11px 14px;border-bottom:1px solid #ffffff22}thead th{text-align:right;background:#202524;color:#e2c5a2}th:first-child{text-align:left}tbody tr:nth-child(2n){background:#ffffff12}details>summary{cursor:pointer;font-weight:800;padding:20px 0}ul{padding-left:24px}li{margin:9px 0}figure{margin:0}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:22px}.placeholder{min-height:255px;display:grid;place-content:center;text-align:center;border:1px dashed #777;line-height:1.6;padding:25px}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover}.faq details{border-bottom:1px solid #8886;padding:5px 0}.footer{padding:40px 0;font-size:.8rem;color:#e0ded8}.warning{font-weight:800;color:#8e5528}@media(max-width:1000px){.hero{grid-template-columns:1fr}.price-grid{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr 1fr}}@media(max-width:650px){.cols,.gallery{grid-template-columns:1fr}.price-grid{grid-template-columns:1fr}.selected{display:block}.pad{padding:48px 0}}

/* ASI approved pricing control: isolated contrasts, no inheritance from dark sections */
#calculator .asi-pricing-layout{display:grid;grid-template-columns:1.12fr 1fr;gap:22px;margin:28px 0 32px;align-items:stretch}
#calculator .asi-pricing-inputs{padding:32px;background:#fff;color:#2B3030;border:1px solid #d9d5cd;display:flex;flex-direction:column;gap:13px}
#calculator .asi-pricing-inputs label{font-size:.88rem;font-weight:800;color:#2B3030}
#calculator select{appearance:auto;display:block;min-height:56px;width:100%;padding:12px 16px;background:#fff!important;color:#222b28!important;border:1px solid #929995;border-radius:3px;font:italic 600 1rem Montserrat,Arial,sans-serif;opacity:1!important;-webkit-text-fill-color:#222b28!important}
#calculator select option{background:#fff!important;color:#202927!important}
#calculator select:focus-visible,#calculator a:focus-visible,#calculator button:focus-visible{outline:3px solid #bd9c6b;outline-offset:3px}
#calculator .asi-muted{background:#f1eee8;color:#35433b;font-size:.85rem;max-width:none;padding:16px 19px;margin:10px 0 0}
#calculator .asi-price-result{background:#293330;color:#f9f7f1;padding:35px 34px;display:flex;flex-direction:column;justify-content:center;min-height:340px}
#calculator .asi-price-result .asi-result-kicker{font-size:.77rem;letter-spacing:.14em;color:#e2d6c5;font-weight:800}
#calculator .asi-price-result .asi-big-price{font-size:clamp(2.9rem,5vw,4.5rem);font-weight:800;letter-spacing:-.045em;line-height:1.15;color:#fff;margin:16px 0}
#calculator .asi-price-result .asi-result-selection{color:#fff;font-weight:700;line-height:1.5}
#calculator .asi-price-result p{color:#ecede7;font-size:.84rem;margin:14px 0 22px}
#calculator .asi-price-result .asi-result-cta{display:inline-block;align-self:flex-start;background:#e5c49d!important;color:#212b26!important;-webkit-text-fill-color:#212b26!important;font-weight:800;text-decoration:none;padding:14px 22px;border:2px solid #e5c49d}
#calculator .asi-price-result .asi-result-cta:hover{background:#fff!important;color:#182820!important;-webkit-text-fill-color:#182820!important}
#calculator .asi-featured-title{margin:32px 0 14px;color:#27322d}
#calculator .asi-featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
#calculator .asi-featured-card{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:5px;padding:19px;background:#fff;color:#2B3030;border:1px solid #c7c5bd;cursor:pointer;font:italic 600 .95rem Montserrat,Arial,sans-serif;min-height:115px}
#calculator .asi-featured-card strong{font-size:1.3rem;color:#2B3030}
#calculator .asi-featured-card small{color:#526057}
#calculator .asi-featured-card.is-active{border:2px solid #ae8e61;background:#edf0eb}
#calculator .asi-center{margin-top:25px}
#calculator .asi-see-all{color:#27332f!important;border-color:#27332f!important}
.hero img,.gallery img{object-fit:contain!important;background:#eae8e2}
@media(max-width:800px){#calculator .asi-pricing-layout{grid-template-columns:1fr}#calculator .asi-featured{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){#calculator .asi-featured{grid-template-columns:1fr}#calculator .asi-pricing-inputs,#calculator .asi-price-result{padding:24px 18px}}

</style>

<script is:inline>
const data={"8x10":{"duratemp":9265,"vertical":10006,"board":10284,"lap":11350,"vinyl":11489},"8x12":{"duratemp":10635,"vertical":11486,"board":11805,"lap":13028,"vinyl":13187},"8x14":{"duratemp":11665,"vertical":12598,"board":12948,"lap":14290,"vinyl":14465},"8x16":{"duratemp":12905,"vertical":13937,"board":14325,"lap":15809,"vinyl":16002},"10x10":{"duratemp":10605,"vertical":11453,"board":11772,"lap":12991,"vinyl":13150},"10x12":{"duratemp":11850,"vertical":12798,"board":13154,"lap":14516,"vinyl":14694},"10x14":{"duratemp":13125,"vertical":14175,"board":14569,"lap":16078,"vinyl":16275},"10x16":{"duratemp":14880,"vertical":16070,"board":16517,"lap":18228,"vinyl":18451},"10x18":{"duratemp":16060,"vertical":17345,"board":17827,"lap":19674,"vinyl":19914},"10x20":{"duratemp":17535,"vertical":18938,"board":19464,"lap":21480,"vinyl":21743},"12x12":{"duratemp":13280,"vertical":14342,"board":14741,"lap":16268,"vinyl":16467},"12x14":{"duratemp":14920,"vertical":16114,"board":16561,"lap":18277,"vinyl":18501},"12x16":{"duratemp":16965,"vertical":18322,"board":18831,"lap":20782,"vinyl":21037},"12x18":{"duratemp":18395,"vertical":19867,"board":20418,"lap":22534,"vinyl":22810},"12x20":{"duratemp":19735,"vertical":21314,"board":21906,"lap":24175,"vinyl":24471},"12x22":{"duratemp":21465,"vertical":23182,"board":23826,"lap":26295,"vinyl":26617},"12x24":{"duratemp":23450,"vertical":25326,"board":26030,"lap":28726,"vinyl":29078},"14x14":{"duratemp":16705,"vertical":18041,"board":18543,"lap":20464,"vinyl":20714},"14x16":{"duratemp":19030,"vertical":20552,"board":21123,"lap":23312,"vinyl":23597},"14x18":{"duratemp":20740,"vertical":22399,"board":23021,"lap":25407,"vinyl":25718},"14x20":{"duratemp":22420,"vertical":24214,"board":24886,"lap":27465,"vinyl":27801},"14x22":{"duratemp":24170,"vertical":26104,"board":26829,"lap":29608,"vinyl":29971},"14x24":{"duratemp":25870,"vertical":27940,"board":28716,"lap":31691,"vinyl":32079}};
const sidingOptions=[['duratemp','Roseburg DuraTemp — Standard'],['vertical','LP SmartSide Vertical Textured Panel'],['board','LP SmartSide Board & Batten'],['lap','LP SmartSide Lap'],['vinyl','GP Vinyl Lap']];
const sizes=Object.keys(data);
const recommended=['8x10','8x12','10x12','10x16','12x16','12x20'];
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const sizeSelect=document.getElementById('asi-size');const sidingSelect=document.getElementById('asi-siding');
sizeSelect.innerHTML=sizes.map(sz=>`<option value="${sz}">${sz.replace('x',' × ')} — ${sz.split('x').reduce((a,b)=>a*+b,1)} sq ft</option>`).join('');
sidingSelect.innerHTML=sidingOptions.map(([key,name])=>`<option value="${key}">${name}</option>`).join('');
sizeSelect.value='10x12';sidingSelect.value='duratemp';
const featured=document.getElementById('asi-featured');
function update(){const size=sizeSelect.value;const siding=sidingSelect.value;const row=data[size];document.getElementById('asi-price').textContent=money(row[siding]);document.getElementById('asi-selected-label').textContent=size.replace('x',' × ')+' · '+sidingOptions.find(x=>x[0]===siding)[1];featured.innerHTML=recommended.map(sz=>`<button type="button" class="asi-featured-card ${sz===size?'is-active':''}" data-size="${sz}" aria-pressed="${sz===size}"><span>${sz.replace('x',' × ')}</span><strong>${money(data[sz][siding])}</strong><small>${sz.split('x').reduce((a,b)=>a*+b,1)} sq ft</small></button>`).join('');}
sizeSelect.addEventListener('change',update);sidingSelect.addEventListener('change',update);
featured.addEventListener('click',event=>{const b=event.target.closest('button[data-size]');if(!b)return;sizeSelect.value=b.dataset.size;update();});
document.getElementById('allrows').innerHTML=sizes.map(sz=>`<tr><th scope="row">${sz.replace('x','′ × ')}′</th>${sidingOptions.map(([key])=>`<td>${money(data[sz][key])}</td>`).join('')}</tr>`).join('');update();
</script>
