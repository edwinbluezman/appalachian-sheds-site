---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Appalachian Firewood Shed Pricing | Appalachian Sheds Inc.";
---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div>\n<header class=\"site-header\"><div class=\"shell head-inner\"><a class=\"brand\" href=\"../index.html\">Appalachian Sheds Inc.<small>VETERAN &amp; FAMILY OWNED \u00b7 CINCINNATI</small></a><nav aria-label=\"Page sections\" class=\"nav\"><a href=\"#pricing\">Pricing</a><a href=\"#features\">Standard Features</a><a href=\"#gallery\">Gallery</a><a href=\"#questions\">Questions</a><a class=\"btn btn-gold\" href=\"#proposal\">Request a Proposal</a></nav></div></header>\n<section class=\"hero\"><div class=\"shell hero-grid\"><div><div class=\"eyebrow\">Appalachian Sheds \u00b7 Firewood Storage \u00b7 Built on Site</div><h1>The Appalachian Firewood Shed Pricing.</h1><p class=\"intro\">A traditional 5/12 gable roof and practical sheltered storage for your stacked firewood.</p><p>Choose the size and exterior siding that fits your property. Every structure is constructed on site by Appalachian Sheds.</p><div class=\"hero-price\">Starting at <span id=\"hero-start\">$4,239</span></div><p>6\u00d78 \u00b7 Roseburg DuraTemp siding included</p><div class=\"hero-actions\"><a class=\"btn btn-gold\" href=\"#pricing\">See Your Price</a><a class=\"btn btn-outline\" href=\"#features\">Explore Standard Features</a></div></div><figure class=\"hero-photo\"><img alt=\"The Appalachian Firewood Shed with gable roof, natural cedar siding, stacked firewood and autumn landscape in a backyard\" loading=\"eager\" src=\"/models/appalachian-firewood-shed.jpg\"/></figure></div></section>\n<section class=\"section\" id=\"pricing\"><div class=\"shell\"><div class=\"eyebrow\">Firewood Shed \u00b7 Sizes &amp; Siding</div><h2>See Your Firewood Shed Price</h2><p class=\"lead\">Choose one of six featured sizes, then select your exterior siding. The complete size guide remains available below.</p><div class=\"featured\" id=\"featured\"></div><div class=\"calculator\"><div class=\"calc-form\"><div class=\"field\"><label for=\"size\">Choose Your Size</label><select aria-label=\"Overall and enclosed building size\" id=\"size\"></select></div><div class=\"field\"><label for=\"siding\">Choose Your Siding</label><select id=\"siding\"><option value=\"0\">Roseburg DuraTemp \u2014 Standard</option><option value=\"1\">LP SmartSide Vertical Textured Panel</option><option value=\"2\">LP SmartSide Board &amp; Batten</option><option value=\"3\">LP SmartSide Lap</option><option value=\"4\">GP Vinyl Lap</option></select></div><div class=\"selection-note\">Pricing is for the standard exterior structure built on your property, with the open firewood-storage opening shown in the model photograph. Exterior caulking and painting or staining must be completed within 30 days where required. Optional finishing is quoted separately.</div></div><div aria-live=\"polite\" class=\"price-card\"><div class=\"eyebrow\">Your Appalachian Firewood Shed Price</div><div class=\"price-number\" id=\"calc-price\">$4,239</div><div class=\"calc-details\" id=\"calc-details\">6\u00d78 \u00b7 48 sq ft</div><div class=\"calc-details\" id=\"calc-siding\">Roseburg DuraTemp \u2014 Standard</div><button class=\"btn btn-light\" id=\"copy\" type=\"button\">Copy My Building Selections</button><span id=\"price-status\" role=\"status\"></span></div></div><div class=\"pricing-tools\"><button aria-controls=\"table-panel\" aria-expanded=\"false\" class=\"btn btn-green\" id=\"toggle-table\" type=\"button\">View All 23 Sizes &amp; Prices</button><span class=\"subtle\">Five exterior siding options \u00b7 All 23 listed sizes</span></div><div hidden=\"\" id=\"table-panel\"><div class=\"full-table\"><table class=\"price-table\"><thead><tr><th>Building Size</th><th>DuraTemp<br/>Included</th><th>LP Vertical<br/>Textured Panel</th><th>LP Board<br/>&amp; Batten</th><th>LP Lap</th><th>GP Vinyl Lap</th></tr></thead><tbody id=\"price-rows\"></tbody></table></div><p class=\"subtle\" style=\"margin-top:14px;font-size:.87rem\">Prices are based on the listed building configuration and siding. Site-specific conditions, customization and optional services are addressed in a written proposal.</p></div></div></section>\n<section class=\"section section-soft\" id=\"features\"><div class=\"shell\"><div class=\"eyebrow\">Practical firewood storage \u00b7 Built on Site</div><h2>Superior Standard Features</h2><p class=\"lead\">A purposeful firewood-storage structure with dependable framing, weather protection and traditional Appalachian character.</p><div class=\"features\"><div class=\"feature\"><h3>Foundation &amp; Floor</h3><p>4\u00d76 pressure-treated foundation beams on 16\u00d716\u00d74-inch solid concrete support pads; final spacing and anchorage matched to the site and structure.</p></div><div class=\"feature\"><h3>Framing &amp; Roof</h3><p>2\u00d74 kiln-dried framing and model-specific engineered roof construction with a traditional 5/12 gable profile.</p></div><div class=\"feature\"><h3>Accessible Firewood Storage</h3><p>A practical open-front firewood-storage opening with a protective roof. The design shown is not a sealed, fully enclosed shed.</p></div><div class=\"feature\"><h3>Exterior Siding</h3><p>Roseburg DuraTemp standard siding, with LP SmartSide Vertical, Board &amp; Batten, LP Lap and GP Vinyl Lap upgrade selections.</p></div><div class=\"feature\"><h3>Roof &amp; Weather Protection</h3><p>\u00bd-inch CDX roof sheathing, architectural asphalt shingles, synthetic underlayment and appropriate roof flashing and ventilation details.</p></div><div class=\"feature\"><h3>Built on Site</h3><p>Constructed on your property. Additional site preparation beyond the included 6-inch leveling allowance is quoted in writing.</p></div></div></div><figure class=\"asi-feature-showcase\" data-approved-model=\"appalachian-firewood-shed\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"Appalachian Firewood Shed \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1086\" loading=\"lazy\" src=\"/assets/standard-features/appalachian-firewood-shed.png\" width=\"1448\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"section\" id=\"gallery\"><div class=\"shell\"><div class=\"eyebrow\">Authentic Appalachian practicality</div><h2>Exterior Gallery</h2><p class=\"lead\">See the traditional gable roof, protected firewood opening, natural cedar character and backyard proportions. Siding colors and finishing selections can be discussed in your proposal.</p><div class=\"gallery\"><figure><img alt=\"The Appalachian Firewood Shed with gable roof, natural cedar siding, stacked firewood and autumn landscape in a backyard\" loading=\"lazy\" src=\"/standard-features/appalachian-firewood-shed.png\"/><figcaption>Appalachian Firewood Shed \u00b7 Exterior view (illustrative wood finish)</figcaption></figure></div></div></section>\n<section class=\"bridge\"><div class=\"shell bridge-grid\"><div><div class=\"eyebrow\">Our Craftsmanship</div><h2>Built Better \u2014 From the Inside Out</h2><p>See our shared construction showcase for foundation systems, floor and wall framing, roof details and exterior weather protection. Specialized firewood-storage openings vary by model.</p><a class=\"btn btn-green\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p style=\"margin-top:17px;font-size:.82rem\">Standard pricing covers the specified exterior structure. Interior finishing is not included. Required exterior caulking and painting or staining must be completed within 30 days, with optional ASI finishing quoted separately.</p></div><div class=\"bridge-aside\"><div><strong>Foundation &amp; floor</strong><small>Pressure-treated framing and concrete support pads</small></div><div><strong>Walls &amp; roof</strong><small>Construction designed for the selected model and site</small></div><div><strong>Weather protection</strong><small>Flashing, roofing and exterior detailing</small></div></div></div></section>\n<section class=\"section faq\" id=\"questions\"><div class=\"shell\"><div class=\"eyebrow\">Helpful details</div><h2>Frequently Asked Questions</h2><details><summary>Is the Appalachian Firewood Shed built on my property?</summary><p>Yes. Every Appalachian Sheds structure is constructed on site. We review site access, placement and ground conditions before issuing a final written proposal.</p></details><details><summary>What exterior siding is included?</summary><p>Roseburg DuraTemp is included. Four siding upgrades are offered: LP SmartSide Vertical, LP SmartSide Board &amp; Batten, LP SmartSide Lap and GP Vinyl Lap.</p></details><details><summary>Is this an enclosed shed with doors?</summary><p>The Firewood Shed design shown includes a large open-front firewood-storage opening. A fully enclosed shed or a different door design requires its own written proposal.</p></details><details><summary>What if my desired size is not priced online?</summary><p>All listed sizes are available for inquiry. Where an instant price is not displayed, we provide a written proposal based on the requested size and site.</p></details><details><summary>Is painting or staining included?</summary><p>Standard pricing does not include final painting or staining. Required exterior caulking and painting or staining must be completed within 30 days. ASI finishing services can be quoted separately.</p></details></div></section>\n<section class=\"section section-dark final\" id=\"proposal\"><div class=\"shell\"><div class=\"eyebrow\">Plan with confidence</div><h2>Ready to Plan Your Appalachian Firewood Shed?</h2><p>Choose your preferred size and exterior siding, then bring your selections to a written proposal or property walk-through. We review building details and site conditions before finalizing scope.</p><button class=\"btn btn-light\" id=\"copy-bottom\" type=\"button\">Copy My Building Selections</button><p style=\"font-size:.83rem;color:#d7e2d9;margin-top:17px\">Use your copied selections when contacting Appalachian Sheds for a written proposal.</p></div></section>\n<footer class=\"footer\"><div class=\"shell footer-inner\"><span>Appalachian Sheds Inc. \u00b7 Veteran &amp; Family Owned \u00b7 Built on Site</span><a href=\"../index.html\">View Models &amp; Pricing</a></div></footer>\n\n"} />
</Base>

<style is:global>

:root{--dark:#2B3030;--ink:#2B3030;--deep:#2B3030;--cream:#F8F7F4;--paper:#fff;--sand:#E1DED8;--gold:#C9A06C;--border:#E1DED8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--cream);font-family:Montserrat,Arial,sans-serif;font-style:italic;line-height:1.6}h1{font-family:Merriweather,Georgia,serif;font-style:italic;font-size:clamp(2rem,3.5vw,3.6rem);line-height:1.17;margin:16px 0 22px}h2,h3{font-weight:800;line-height:1.3}h2{font-size:clamp(1.65rem,2.7vw,2.55rem);margin:12px 0 16px}h3{font-size:1.13rem}p{margin:0 0 16px}a{color:inherit}.shell{width:94%;max-width:1440px;margin:auto}.eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#ad8965}.subtle{color:#59625c}.site-header{background:#1f2d26;color:white;border-bottom:1px solid #506354}.head-inner{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.25;font-weight:500;text-decoration:none;white-space:nowrap}.brand small{display:block;font-size:.61rem;letter-spacing:.16em;color:#d2ac84;margin-top:7px}.nav{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.nav a{text-decoration:none;font-size:.85rem}.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;text-align:center;padding:14px 19px;font-size:.9rem;font-weight:800;line-height:1.3;text-decoration:none;border-radius:2px;border:2px solid transparent;cursor:pointer;font-family:inherit;font-style:inherit}.btn-gold{background:#c2a07c;color:#1e2925}.btn-green{background:#244b39;color:#fff}.btn-outline{border-color:#b8c5bc;background:transparent;color:inherit}.btn-light{background:#F8F7F4;color:#203129}.btn:hover{filter:brightness(.94)}a:focus-visible,button:focus-visible,select:focus-visible{outline:3px solid #c28e4f;outline-offset:3px}.hero{background:var(--dark);color:#f8f5ed;padding:clamp(36px,5vw,78px) 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(26px,4vw,65px);align-items:center}.hero p{max-width:62ch}.hero .intro{font-size:1.04rem}.hero-price{font-family:Merriweather,Georgia,serif;font-size:clamp(1.65rem,2.7vw,2.6rem);margin:16px 0 0;color:#e0c09e}.hero-photo{margin:0;max-width:100%;min-width:0}.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:#293831;border-radius:3px}.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:21px}.section{padding:clamp(55px,6.5vw,94px) 0}.section-dark{background:#2B3030;color:#fff}.section-soft{background:#eae8e2}.lead{font-size:1.04rem;max-width:78ch;color:#54615a}.section-dark .lead{color:#dde3de}.calculator{margin-top:28px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:24px;align-items:stretch}.calc-form{padding:clamp(23px,3vw,35px);background:#fff;border:1px solid var(--border);border-radius:4px}.field{margin-bottom:22px}.field label{display:block;font-weight:800;margin-bottom:9px;font-size:.92rem}.field select{appearance:auto;width:100%;min-height:54px;padding:13px 15px;border:1px solid #9ba89e;background:#fff!important;color:#1f3028!important;-webkit-text-fill-color:#1f3028!important;font:inherit;font-size:.98rem;border-radius:3px;opacity:1!important;color-scheme:light}.field select option{background:#fff!important;color:#1f3028!important}.selection-note{font-size:.87rem;color:#48544c;background:#f2f0ea;border-left:3px solid #b69a77;padding:16px;margin-top:5px}.price-card{padding:clamp(25px,3.2vw,40px);background:#28312e;color:#fff;border-radius:4px;display:flex;flex-direction:column;justify-content:center;min-height:295px}.price-card .eyebrow{color:#e2c5a8}.price-number{font-weight:800;font-size:clamp(2.6rem,5vw,4.5rem);line-height:1.2;margin:12px 0 16px;color:#fff}.price-card .calc-details{color:#f2f3ef;font-weight:600}.price-card .btn{align-self:flex-start;margin-top:15px}.featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:25px 0 32px}.size-card{background:#fff;border:1px solid #E1DED8;color:#28342c;text-align:left;padding:20px;cursor:pointer;font:inherit;border-radius:3px;min-height:126px}.size-card:hover,.size-card.active{border-color:#37614b;box-shadow:inset 0 0 0 2px #37614b}.size-card strong{font-size:1.05rem;display:block}.size-card span{font-size:.85rem;color:#505c55;display:block}.size-card b{font-size:1.15rem;display:block;margin-top:8px}.full-table{overflow-x:auto;border-radius:4px;border:1px solid #d8d9d4;background:#fff}.price-table{border-collapse:collapse;min-width:840px;width:100%;color:#26332b;font-size:.85rem;font-variant-numeric:tabular-nums}.price-table th{padding:17px 12px;line-height:1.45;color:#fff;text-align:center;font-size:.77rem}.price-table th:first-child{background:#263332;text-align:left}.price-table th:nth-child(2){background:#315244}.price-table th:nth-child(3){background:#2f6272}.price-table th:nth-child(4){background:#79634c}.price-table th:nth-child(5){background:#655d7a}.price-table th:nth-child(6){background:#725948}.price-table td{padding:13px 11px;text-align:right;border-bottom:1px solid #e2e2db}.price-table td:first-child{text-align:left;font-weight:800}.price-table tr:nth-child(even){background:#e9ece8}.price-table tr:hover{background:#dce8df}.pricing-tools{margin:25px 0 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}.pricing-tools .btn{margin:0}.features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:25px}.feature{background:#fff;border:1px solid #e1dfd8;padding:26px}.feature h3{margin:0 0 10px}.feature p{margin:0;color:#56615a;font-size:.89rem}.gallery{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin-top:25px}.gallery figure{margin:0;background:#fff;padding:13px;border:1px solid var(--border);max-width:850px}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:contain;background:#dfded7}.gallery figcaption{margin-top:10px;color:#3d4a41;font-size:.82rem}.bridge{background:#ece9e3;padding:clamp(55px,6vw,85px) 0}.bridge-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}.bridge-aside{display:grid;gap:11px}.bridge-aside>div{background:#fafaf8;border-left:3px solid #a98d70;padding:15px 19px}.bridge-aside strong{display:block}.bridge-aside small{display:block;color:#536058}.faq details{border-bottom:1px solid #bec6bf;padding:19px 0}.faq summary{cursor:pointer;font-weight:800}.faq details p{margin:14px 0 3px;color:#536058}.final{text-align:center}.final p{max-width:70ch;margin:15px auto 24px}.footer{background:#1e2c25;color:#d7dcd6;padding:25px 0;font-size:.8rem}.footer a{color:#fff}.footer-inner{display:flex;gap:20px;justify-content:space-between;flex-wrap:wrap}#price-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:900px){.hero-grid,.calculator,.bridge-grid{grid-template-columns:1fr}.hero-photo{max-width:720px}.featured,.features{grid-template-columns:repeat(2,minmax(0,1fr))}.nav{gap:12px}}
@media(max-width:620px){.head-inner{align-items:flex-start;flex-direction:column;padding:15px 0}.nav{gap:12px}.hero-actions .btn{width:100%}.featured,.features{grid-template-columns:1fr}.price-card .btn{align-self:stretch}.section{padding:48px 0}.hero{padding:34px 0}.price-card{min-height:230px}.hero h1{font-size:2rem}}

.price-card .price-number.proposal-price{font-size:clamp(1.5rem,3.2vw,2.4rem);line-height:1.32} .price-card .btn-light,.section-dark .btn-light{background:#F8F7F4!important;color:#203129!important;-webkit-text-fill-color:#203129!important} .price-card .calc-details{color:#f2f3ef!important;-webkit-text-fill-color:#f2f3ef!important} .price-card .eyebrow{color:#e2c5a8!important} .price-table td{white-space:nowrap} .hero-photo figcaption{position:static;background:transparent;color:#fff;padding:8px 0} .hero-photo img{object-fit:contain} #table-panel[hidden]{display:none!important} 

</style>

<script is:inline>

const rows=[{"size":"6×8","area":48,"prices":[4239,4578,4705,5193,5256]},{"size":"6×10","area":60,"prices":[5309,5734,5893,6504,6583]},{"size":"6×12","area":72,"prices":[5547,5991,6157,6795,6878]},{"size":"6×14","area":84,"prices":[6325,6831,7021,7748,7843]},{"size":"6×16","area":96,"prices":[7126,7696,7910,8729,8836]},{"size":"8×8","area":64,"prices":[4898,5290,5437,6000,6074]},{"size":"8×10","area":80,"prices":[6098,6586,6769,7470,7562]},{"size":"8×12","area":96,"prices":[6986,7545,7754,8558,8663]},{"size":"8×14","area":112,"prices":[7753,8373,8606,9497,9614]},{"size":"8×16","area":128,"prices":[8618,9307,9566,10557,10686]},{"size":"8×18","area":144,"prices":[9343,10090,10371,11445,11585]},{"size":"8×20","area":160,"prices":[10198,11014,11320,12493,12646]},{"size":"10×10","area":100,"prices":[6986,7545,7754,8558,8663]},{"size":"10×12","area":120,"prices":[7829,8455,8690,9591,9708]},{"size":"10×14","area":140,"prices":[8727,9425,9687,10691,10821]},{"size":"10×16","area":160,"prices":[10079,10885,11188,12347,12498]},{"size":"10×18","area":180,"prices":[10824,11690,12015,13259,13422]},{"size":"10×20","area":200,"prices":[11733,12672,13024,14373,14549]},{"size":"12×8","area":96,"prices":null},{"size":"12×10","area":120,"prices":null},{"size":"12×12","area":144,"prices":[8975,9693,9962,10994,11129]},{"size":"12×16","area":192,"prices":[11430,12344,12687,14002,14173]},{"size":"12×20","area":240,"prices":[13193,14248,14644,16161,16359]}];
const names=['Roseburg DuraTemp — Standard','LP SmartSide Vertical Textured Panel','LP SmartSide Board & Batten','LP SmartSide Lap','GP Vinyl Lap'];
const featuredSizes=['6×8','8×10','8×12','10×12','10×16','12×16'];
const money=n=>n===null?'Written proposal':'$'+n.toLocaleString('en-US');
const size=document.getElementById('size'),siding=document.getElementById('siding');
rows.forEach((r,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=`${r.size} · ${r.area} sq ft`;size.appendChild(o)});
const featured=document.getElementById('featured');
featuredSizes.forEach(v=>{let i=rows.findIndex(r=>r.size===v);if(i<0)return;let r=rows[i];const b=document.createElement('button');b.type='button';b.className='size-card';b.dataset.size=v;b.innerHTML=`<strong>${r.size}</strong><span>${r.area} sq ft</span><b>${r.prices?'From '+money(r.prices[0]):'Written proposal'}</b>`;b.addEventListener('click',()=>{size.value=String(i);update();document.getElementById('calc-price').scrollIntoView({behavior:'smooth',block:'center'})});featured.appendChild(b)});
const body=document.getElementById('price-rows');rows.forEach(r=>{const tr=document.createElement('tr');const td=document.createElement('td');td.innerHTML=`<strong>${r.size}</strong><br><small>${r.area} sq ft</small>`;tr.appendChild(td);for(const p of r.prices??[null,null,null,null,null]){const cell=document.createElement('td');cell.textContent=money(p);tr.appendChild(cell)}body.appendChild(tr)});
function update(){const r=rows[Number(size.value)||0],type=Number(siding.value)||0;
const amount=r.prices?r.prices[type]:null;document.getElementById('calc-price').textContent=money(amount);document.getElementById('calc-price').classList.toggle('proposal-price',amount===null);document.getElementById('calc-details').textContent=`${r.size} · ${r.area} sq ft`;
document.getElementById('calc-siding').textContent=names[type];document.querySelectorAll('.size-card').forEach(b=>b.classList.toggle('active',b.dataset.size===r.size));}
size.addEventListener('change',update);siding.addEventListener('change',update);
document.getElementById('toggle-table').addEventListener('click',()=>{const area=document.getElementById('table-panel'),b=document.getElementById('toggle-table');area.hidden=!area.hidden;b.setAttribute('aria-expanded',String(!area.hidden));b.textContent=area.hidden?'View All 23 Sizes & Prices':'Hide Full Price Comparison'});
async function copySelection(){const r=rows[Number(size.value)||0],v=Number(siding.value)||0;const message=`Appalachian Sheds — Appalachian Firewood Shed\nBuilding size: ${r.size}\nSiding: ${names[v]}\nListed exterior structure price: ${money(r.prices?r.prices[v]:null)}\nBuilt on site; optional services and site conditions are quoted separately.`;let ok=false;try{await navigator.clipboard.writeText(message);ok=true}catch(e){const input=document.createElement('textarea');input.value=message;document.body.appendChild(input);input.select();ok=document.execCommand('copy');input.remove()}document.getElementById('copy').textContent=ok?'Selections Copied':'Copy Not Available';document.getElementById('price-status').textContent=ok?'Your selected Firewood Shed details have been copied.':'Please copy your selections manually.';setTimeout(()=>document.getElementById('copy').textContent='Copy My Building Selections',2500)};
document.getElementById('copy').addEventListener('click',copySelection);document.getElementById('copy-bottom').addEventListener('click',copySelection);update();

</script>
