:root{--dark:#2B3030;--dark2:#202827;--cream:#F8F7F4;--paper:#FFFFFF;--bronze:#C9A06C;--wood:#4b3427;--ink:#242b26;--muted:#59635a;--line:#E1DED8;--pine:#2E473A;--pale:#E1DED8;--font:Montserrat,Arial,Helvetica,sans-serif;--serif:Merriweather,Georgia,'Times New Roman',serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--font);font-style:italic;line-height:1.6}a{color:inherit}button,select,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #d6a35e;outline-offset:3px}img{max-width:100%;display:block}h1{font:italic 500 clamp(2.65rem,5vw,5.5rem)/1.12 var(--serif);letter-spacing:-.035em;margin:0}h2{font:italic 500 clamp(1.9rem,3.2vw,3.15rem)/1.15 var(--serif);letter-spacing:-.025em;margin:0 0 20px}h3{font:italic 600 1.35rem/1.3 var(--serif);margin:0 0 10px}p{margin:0 0 15px}strong{font-weight:800}.shell{width:94%;max-width:1440px;margin:auto}.section{padding:clamp(55px,7vw,104px) 0}.eyebrow{color:#99734b;letter-spacing:.17em;text-transform:uppercase;font-size:.76rem;font-weight:800;margin-bottom:17px}.dark .eyebrow{color:#dbc09d}.muted{color:var(--muted)}.dark .muted{color:#ccd2cd}.dark{background:var(--dark);color:#f9f4e9}.soft{background:#eae8e1}.white{background:var(--paper)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--bronze);color:#111c15;border:1px solid var(--bronze);min-height:49px;padding:12px 23px;text-decoration:none;font-weight:800;font-size:.9rem;transition:.2s}.btn:hover{background:#c8a77f;border-color:#c8a77f}.btn.alt{background:transparent;color:inherit;border-color:currentColor}.btn.alt:hover{background:#ffffff13}.btn.pine{background:var(--pine);color:white;border-color:var(--pine)}.btn.pine:hover{background:#476351}.buttons{display:flex;flex-wrap:wrap;gap:12px}.mini{font-size:.84rem}.rule{height:1px;background:var(--line);margin:22px 0}.nav{background:#1d2922;color:#f3eee6;position:sticky;top:0;z-index:50;border-bottom:1px solid #ffffff30}.nav-inner{min-height:75px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{font-family:var(--se