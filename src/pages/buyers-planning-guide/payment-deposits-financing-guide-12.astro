        ['Upgrades', 'Discussed casually without final pricing', 'Documented with scope, price and timing impact', 'The fastest way for a budget to drift'],
        ['Site preparation', 'Assumed included until construction nears', 'Discussed early with responsibilities assigned', 'A common source of unexpected cost'],
        ['Change orders', 'Handled by conversation or text', 'Written, approved and priced before work', 'Protects homeowner and builder'],
      ],
    },
    {
      type: 'cards', id: 'financing', title: 'Financing Helps With Planning but Never Replaces Scope', nav: 'Financing',
      lead: 'This is general buyer education, not financial advice. Availability, approval, rates, terms and fees depend on the lender and borrower.',
      items: [
        { title: 'Common payment paths', list: ['Cash or check, with receipts and clear timing', 'Credit card where accepted, minding fees and interest', 'Personal or credit-union loan: compare rate, term and total cost', 'Home-equity loan or HELOC: uses your home as collateral; review carefully', 'Phased planning: a strong shell first, interior systems later when sequenced correctly'] },
