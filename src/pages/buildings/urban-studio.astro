---
import Base from '../../layouts/Base.astro';
const pageTitle = "The Urban Studio Pricing. | Appalachian Sheds Inc.";
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is the Urban Studio built on my property?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Every Appalachian Sheds building is built on site. We review property access, building location, foundation support and site conditions before construction."}}, {"@type": "Question", "name": "What is included in the Standard Urban Studio price?", "acceptedAnswer": {"@type": "Answer", "text": "Standard pricing covers the exterior weather-tight shell with the selected siding, the approved structural framing and roof assembly, Craftsman double doors, two standard single-hung windows, and standard exterior trim. Interior wall and ceiling finishes, electrical systems, insulation, workbenches and storage shelving are not included."}}, {"@type": "Question", "name": "What is different about the Architectural Package?", "acceptedAnswer": {"@type": "Answer", "text": "The Architectural Package adds divided-light French doors, larger front windows, a secondary side double-door entrance, and enhanced exterior detailing. The availability and arrangement of openings vary by size and require a written proposal."}}, {"@type": "Question", "name": "Can I choose other sizes or change the layout?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The featured table presents six popular sizes for easy comparison. Additional dimensions, door placements and other enhancements can be discussed during property planning and priced in a written proposal."}}, {"@type": "Question", "name": "Is the interior finished?", "acceptedAnswer": {"@type": "Answer", "text": "No. Standard Urban Studios are exterior weather-tight shells with unfinished exposed framing. Interior finishing can be discussed as a separate optional scope."}}, {"@type": "Question", "name": "Does the exterior need to be painted or stained?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, where required by the selected exterior materials. Required caulking, sealing and painting or staining must be completed within 30 days after construction. Appalachian Sheds offers optional complete exterior painting services. Vinyl and other selected materials have different finish requirements that will be described in your proposal."}}, {"@type": "Question", "name": "Can architectural asphalt shingles be used on the 2/12 roof?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, where the selected shingle manufacturer allows installation at 2/12. Our roofing specification uses a manufacturer-approved low-slope underlayment and roof assembly, subject to engineering and applicable local requirements."}}, {"@type": "Question", "name": "Are permits or unusual site preparation included?", "acceptedAnswer": {"@type": "Answer", "text": "Permit requirements and site conditions vary across the Greater Cincinnati Tri-State area. Foundation leveling up to six inches out of level is included in the standard approach; additional leveling or site preparation, when necessary, is quoted in writing."}}]};

---
<Base title={pageTitle}>
<Fragment set:html={"<div class=\"asi-global-header\" role=\"banner\"><div class=\"asi-nav-shell\"><a aria-label=\"Appalachian Sheds home\" class=\"asi-brand\" href=\"/\"><strong>APPALACHIAN SHEDS INC.</strong><span>VETERAN &amp; FAMILY-OWNED \u00b7 BUILT ON SITE</span></a><button aria-controls=\"asi-nav-primary\" aria-expanded=\"false\" class=\"asi-menu-toggle\" type=\"button\">\u2630 Menu</button><nav aria-label=\"Main navigation\" class=\"asi-nav-links\" id=\"asi-nav-primary\"><a href=\"/\">Home</a><a href=\"/buildings/\">Buildings &amp; Pricing</a><a href=\"/planning-guides/\">Building Guides</a><a href=\"/options-upgrades/\">Options &amp; Upgrades</a><a href=\"/craft/\">Built Better</a><a class=\"asi-nav-cta\" href=\"/buildings/#the-collection\">See Your Price</a></nav></div></div><a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header class=\"bar\"><div class=\"shell bar-inner\"><div class=\"wordmark\">APPALACHIAN SHEDS INC. <span style=\"opacity:.6\">/ CINCINNATI</span></div><a class=\"minor-link\" href=\"#pricing\">EXPLORE URBAN STUDIO PRICING</a></div></header>\n<main id=\"main\">\n<div class=\"shell hero asi-standard-hero-grid\"><div><div class=\"eyebrow\">Premium backyard buildings \u00b7 Built on site</div><h1>The Urban Studio Pricing.</h1><p>Big ideas deserve room to grow. Bring contemporary style and hardworking storage together in a distinctive backyard workshop built for your property.</p><p class=\"subtle\">Explore six practical sizes, five siding choices, and an optional Architectural Package\u2014all with our distinctive 2/12 single-slope roof.</p><div class=\"buttons\"><a class=\"btn\" href=\"#pricing\">See Your Price</a><a class=\"btn btn-outline\" href=\"#configurations\">Compare the Two Configurations</a></div><div class=\"trust\"><span>Built on Site</span><span>Veteran &amp; Family-Owned</span><span>Exterior Weather-Tight Shell</span></div></div><div class=\"asi-hero-media-group\"><div class=\"hero-visual asi-standard-hero-media\"><img alt=\"Standard Urban Studio in a residential backyard, with Craftsman double doors and two windows\" class=\"photo hero-photo\" src=\"/models/urban-studio.jpg\"/></div></div></div>\n<section class=\"dark\" id=\"configurations\"><div class=\"shell\"><div class=\"intro\"><div class=\"eyebrow\">Designed around the way you work</div><h2>Two ways to make it yours.</h2><p>Choose a practical, beautifully built workspace or enhance the exterior with additional daylight, access and architectural details. Both configurations are built on site.</p></div><div class=\"cards\"><article class=\"card\"><div class=\"card-top standard\">01 \u00b7 Standard Urban Studio</div><img alt=\"Standard Urban Studio with wood Craftsman double doors and two single-hung windows\" loading=\"lazy\" src=\"/standard-features/urban-studio.png\"/><div class=\"content\"><h3>Standard Urban Studio</h3><p>Our versatile workshop design with a 2/12 single-slope roof, site-built Craftsman double doors, two single-hung windows, cedar trim and Roseburg DuraTemp siding.</p><p class=\"caption\">Exterior paint shown is optional. Standard pricing is available below.</p><a class=\"btn\" href=\"#pricing\">See Your Price</a></div></article><article class=\"card\"><div class=\"card-top arch\">02 \u00b7 Optional Architectural Package</div><img alt=\"Urban Studio Architectural Package with divided-light French doors, larger windows and additional side double doors\" loading=\"lazy\" src=\"/gallery/model-photos/urban-studio/01-full-exterior-view.jpg\"/><div class=\"content\"><h3>Architectural Package</h3><p>An enhanced exterior with divided-light French doors, larger architectural windows, an additional side double-door entrance and refined exterior detailing.</p><p class=\"caption\">Optional configuration. Final package availability and cost depend on the selected size and building plan.</p><a class=\"btn btn-outline\" href=\"#proposal\">Request a Written Proposal</a></div></article></div><p class=\"config-note\">All Standard prices shown below are for exterior weather-tight shells. Architectural Package features and exterior finishing are additional options.</p></div></section>\n<section id=\"pricing\"><div class=\"shell\"><div class=\"intro\"><div class=\"eyebrow\">Simple size and siding choices</div><h2>See your Standard price.</h2><p>Select one of six featured sizes and choose from our five exterior siding options. Additional dimensions are available through a written proposal.</p></div><div class=\"calculator\"><div class=\"panel\"><div class=\"form-field\"><label for=\"size\">Choose Your Size</label><select id=\"size\"><option value=\"8\u00d710\">8\u00d710 \u2014 80 sq ft</option><option value=\"8\u00d712\">8\u00d712 \u2014 96 sq ft</option><option value=\"8\u00d716\">8\u00d716 \u2014 128 sq ft</option><option value=\"10\u00d712\">10\u00d712 \u2014 120 sq ft</option><option value=\"10\u00d716\">10\u00d716 \u2014 160 sq ft</option><option value=\"10\u00d720\">10\u00d720 \u2014 200 sq ft</option></select></div><div class=\"form-field\"><label for=\"siding\">Choose Your Siding</label><select id=\"siding\"><option value=\"0\">Roseburg DuraTemp</option><option value=\"1\">LP SmartSide Vertical Panel</option><option value=\"2\">LP SmartSide Board &amp; Batten</option><option value=\"3\">LP SmartSide Lap</option><option value=\"4\">GP Vinyl Lap</option></select></div><div class=\"large-note\">The displayed price applies to the <strong>Standard Urban Studio exterior weather-tight shell</strong>. Architectural Package doors, windows and other optional improvements are quoted separately.</div></div><div aria-atomic=\"true\" aria-live=\"polite\" class=\"readout\"><span class=\"small\">Your Standard Urban Studio price</span><div class=\"price\" id=\"live-price\">$5,850</div><div class=\"details\"><strong id=\"live-size\">8 \u00d7 10 \u00b7 80 sq ft</strong><br/><span id=\"live-siding\">Roseburg DuraTemp standard siding</span></div><a class=\"btn btn-light\" href=\"#proposal\">Request a Written Proposal</a></div></div><h3 style=\"margin-top:48px\">Compare all five siding selections</h3><p class=\"subtle\" style=\"font-size:12px\">Standard model pricing by size and siding. Every listed price is in $50 increments.</p><div class=\"table-wrap\"><table class=\"price-table\"><thead><tr><th scope=\"col\">Size</th><th scope=\"col\">DuraTemp<br/><small>Standard</small></th><th scope=\"col\">LP SmartSide<br/><small>Vertical Panel</small></th><th scope=\"col\">LP SmartSide<br/><small>Board &amp; Batten</small></th><th scope=\"col\">LP SmartSide<br/><small>Lap</small></th><th scope=\"col\">GP<br/><small>Vinyl Lap</small></th></tr></thead><tbody><tr><th scope=\"row\">8 \u00d7 10</th><td>$5,850</td><td>$6,350</td><td>$6,500</td><td>$7,150</td><td>$7,250</td></tr>\n<tr><th scope=\"row\">8 \u00d7 12</th><td>$6,700</td><td>$7,250</td><td>$7,450</td><td>$8,200</td><td>$8,300</td></tr>\n<tr><th scope=\"row\">8 \u00d7 16</th><td>$8,250</td><td>$8,900</td><td>$9,150</td><td>$10,100</td><td>$10,200</td></tr>\n<tr><th scope=\"row\">10 \u00d7 12</th><td>$7,550</td><td>$8,150</td><td>$8,350</td><td>$9,200</td><td>$9,350</td></tr>\n<tr><th scope=\"row\">10 \u00d7 16</th><td>$9,650</td><td>$10,400</td><td>$10,700</td><td>$11,800</td><td>$11,950</td></tr>\n<tr><th scope=\"row\">10 \u00d7 20</th><td>$11,350</td><td>$12,250</td><td>$12,550</td><td>$13,850</td><td>$14,050</td></tr></tbody></table></div><p class=\"caption\" style=\"margin-top:15px\">Shown for standard-size, standard-configuration buildings. Final project pricing is confirmed by written proposal based on the selected building, site conditions and options.</p><p class=\"caption\">Need a different size? Other widths and lengths are available by written proposal.</p></div></section>\n<section class=\"dark\" id=\"features\"><div class=\"shell\"><div class=\"intro\"><div class=\"eyebrow\">Model-Specific Construction</div><h2>Superior Standard Features</h2><p>Thoughtful structural details begin below the floor and continue through the roof. Each building is planned for its size, configuration and property conditions.</p></div><div class=\"features\"><article class=\"feature\"><div class=\"symbol\">\u25b0</div><h3>Foundation support</h3><p>Pressure-treated 4\u00d76 beams supported on solid 16\u00d716\u00d74-inch concrete pads, with size-specific support layout.</p></article><article class=\"feature\"><div class=\"symbol\">\u25a4</div><h3>Stronger floors</h3><p>2\u00d76 pressure-treated joists at 16 inches on center with \u00be-inch pressure-treated plywood floor decking.</p></article><article class=\"feature\"><div class=\"symbol\">\u25a5</div><h3>Quality wall framing</h3><p>2\u00d74 kiln-dried wall studs at 16 inches on center, with openings planned for your chosen doors and windows.</p></article><article class=\"feature\"><div class=\"symbol\">\u2302</div><h3>Low-profile roof</h3><p>Engineered 2/12 single-slope roof with \u00bd-inch CDX sheathing and manufacturer-approved low-slope shingle installation.</p></article><article class=\"feature\"><div class=\"symbol\">\u25a3</div><h3>Craftsman access</h3><p>Site-built 60\u00d780-inch double wood doors with black hardware and a keyed lock on the Standard model.</p></article><article class=\"feature\"><div class=\"symbol\">\u25a7</div><h3>Everyday daylight</h3><p>Two 24\u00d730-inch single-hung windows, with screens, locks and installation-compatible flashing.</p></article><article class=\"feature\"><div class=\"symbol\">\u25b1</div><h3>Real cedar details</h3><p>1\u00d74 cedar trim at doors and windows and 1\u00d76 cedar fascia, with finishing options to suit your exterior.</p></article><article class=\"feature\"><div class=\"symbol\">\u25c6</div><h3>Built on your site</h3><p>Every Urban Studio is constructed at your property; building dimensions, anchorage and site preparations are reviewed beforehand.</p></article></div></div><figure class=\"asi-feature-showcase\" data-approved-model=\"urban-studio\" data-asi-qa=\"centered-full-section-v2\"><img alt=\"The Urban Studio \u2014 approved Superior Standard Features graphic highlighting eight model-specific construction details\" decoding=\"async\" height=\"1220\" loading=\"lazy\" src=\"/assets/standard-features/urban-studio.png\" width=\"2000\"/><figcaption>Standard features and illustrated construction details vary by model. Actual scope is confirmed in the written proposal.</figcaption></figure></section>\n<section class=\"soft\" id=\"galleries\"><div class=\"shell\"><div class=\"intro\"><div class=\"eyebrow\">See the details</div><h2>Urban Studio Exterior Gallery</h2><p>Explore the Standard Urban Studio and the optional Architectural Package. Exterior color and finishing choices are selected separately.</p></div><div class=\"galleries asi-exterior-only-gallery\"><div class=\"gallery-panel\"><h3>Exterior Gallery</h3><p>Two distinct looks, one Urban Studio design.</p><div class=\"thumbs\"><figure><img alt=\"Standard Urban Studio exterior\" loading=\"lazy\" src=\"/gallery/model-photos/urban-studio/02-craftsman-double-doors.jpg\"/><figcaption>Standard Urban Studio \u00b7 Optional paint shown</figcaption></figure><figure><img alt=\"Architectural Package exterior\" loading=\"lazy\" src=\"/gallery/model-photos/urban-studio/03-windows-cedar-surrounds.jpg\"/><figcaption>Architectural Package \u00b7 Upgraded features</figcaption></figure></div></div></div></div></section>\n<section aria-labelledby=\"asi-construction-heading\" class=\"asi-construction-bridge\"><div class=\"asi-construction-bridge__inner\"><div><div class=\"asi-construction-bridge__eyebrow\">Our Craftsmanship</div><h2 id=\"asi-construction-heading\">Built Better \u2014 From the Inside Out</h2><p>Explore the foundation, floor framing, wall construction, roof structure and weather protection behind Appalachian Sheds buildings. Our shared construction showcase gives you a closer look at how we build on your property.</p><a class=\"asi-construction-bridge__button\" href=\"/craft/\">Explore Our Superior Construction \u2192</a><p class=\"asi-construction-bridge__note\">Standard buildings are weather-tight exterior shells; interior finishes are not included. Required exterior caulking and painting or staining must be completed within 30 days. Optional finishing services are available.</p></div><div class=\"asi-construction-bridge__features\"><div><strong>Foundation &amp; floor</strong><span>Pressure-treated framing and solid concrete support pads</span></div><div><strong>Walls &amp; roof</strong><span>Purpose-built structure suited to the model and site</span></div><div><strong>Weather protection</strong><span>Roofing, flashing, ventilation and exterior detailing</span></div></div></div></section><section id=\"faq\"><div class=\"shell faq\"><div class=\"eyebrow\">Helpful answers</div><h2>Urban Studio FAQs.</h2>\n<details><summary>Is the Urban Studio built on my property?</summary><p>Yes. Every Appalachian Sheds building is built on site. We review property access, building location, foundation support and site conditions before construction.</p></details>\n<details><summary>What is included in the Standard Urban Studio price?</summary><p>Standard pricing covers the exterior weather-tight shell with the selected siding, the approved structural framing and roof assembly, Craftsman double doors, two standard single-hung windows, and standard exterior trim. Interior wall and ceiling finishes, electrical systems, insulation, workbenches and storage shelving are not included.</p></details>\n<details><summary>What is different about the Architectural Package?</summary><p>The Architectural Package adds divided-light French doors, larger front windows, a secondary side double-door entrance, and enhanced exterior detailing. The availability and arrangement of openings vary by size and require a written proposal.</p></details>\n<details><summary>Can I choose other sizes or change the layout?</summary><p>Yes. The featured table presents six popular sizes for easy comparison. Additional dimensions, door placements and other enhancements can be discussed during property planning and priced in a written proposal.</p></details>\n<details><summary>Is the interior finished?</summary><p>No. Standard Urban Studios are exterior weather-tight shells with unfinished exposed framing. Interior finishing can be discussed as a separate optional scope.</p></details>\n<details><summary>Does the exterior need to be painted or stained?</summary><p>Yes, where required by the selected exterior materials. Required caulking, sealing and painting or staining must be completed within 30 days after construction. Appalachian Sheds offers optional complete exterior painting services. Vinyl and other selected materials have different finish requirements that will be described in your proposal.</p></details>\n<details><summary>Can architectural asphalt shingles be used on the 2/12 roof?</summary><p>Yes, where the selected shingle manufacturer allows installation at 2/12. Our roofing specification uses a manufacturer-approved low-slope underlayment and roof assembly, subject to engineering and applicable local requirements.</p></details>\n<details><summary>Are permits or unusual site preparation included?</summary><p>Permit requirements and site conditions vary across the Greater Cincinnati Tri-State area. Foundation leveling up to six inches out of level is included in the standard approach; additional leveling or site preparation, when necessary, is quoted in writing.</p></details>\n</div></section>\n<section class=\"soft\" id=\"finish\"><div class=\"shell\"><div class=\"intro\"><div class=\"eyebrow\">Before your build</div><h2>Know what's included.</h2><p>The Urban Studio is built as an exterior weather-tight shell\u2014not a completed interior room. Your proposal will identify the selected siding, doors, windows, optional architectural enhancements and any additional site requirements.</p><div class=\"large-note\"><strong>Exterior care:</strong> Required caulking, sealing, painting or staining must be completed within 30 days after construction for materials that require field finishing. Ask about our optional complete painting service.</div></div></div></section>\n<section class=\"dark\" id=\"proposal\"><div class=\"shell banner-cta\"><div><div class=\"eyebrow\">Plan the right building</div><h2>Let's make room for your next project.</h2><p>Tell us how you plan to use your Urban Studio. We can review your preferred size, siding, door configuration and property conditions, then prepare a written proposal.</p><div class=\"buttons\"><a class=\"btn btn-light\" href=\"https://appalachiansheds.com/contact\">Request a Written Proposal</a><a class=\"btn btn-darkoutline\" href=\"https://appalachiansheds.com/contact\">Request a Property Walk-Through</a></div></div><div class=\"large-note\"><strong>Built on Site. Built for Your Property.</strong><p style=\"margin:8px 0 0\">We serve homeowners across the Greater Cincinnati Tri-State area with premium, property-specific backyard structures.</p></div></div></section>\n</main><section class=\"sand pad\" id=\"utility-services\"><div class=\"shell\"><span class=\"eyebrow\">Complete Your Project</span><h2>Need Electrical, Plumbing, Insulation, or Site Prep?</h2><p>Appalachian Sheds’ own licensed crews can wire, plumb, insulate, and prepare your site — all priced transparently, with a bundle discount when combined.</p><div class=\"buttons\"><a class=\"btn\" href=\"/services/utility-and-site-readiness/\">See Utility &amp; Site Readiness Pricing →</a></div></div></section>\n<footer class=\"footer\"><div class=\"shell\"><div>APPALACHIAN SHEDS INC. \u00b7 VETERAN &amp; FAMILY-OWNED</div><div>Greater Cincinnati \u00b7 Ohio, Kentucky &amp; Indiana</div><div>Exterior shell pricing \u00b7 Final details confirmed in writing</div></div></footer>\n\n"} />

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

