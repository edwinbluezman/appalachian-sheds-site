---
// The "exterior shell only" statement, shown wherever prices appear. Wording lives in site.js (shellScope).
import { shellScope, link } from '../data/site.js';

const { dark = false, showLink = true } = Astro.props;
---
<aside class={'scope' + (dark ? ' scope--dark' : '')} aria-label="What every price includes">
  <p class="scope__title">{shellScope.title}</p>
  <p class="scope__text">{shellScope.text}</p>
  {showLink && <a class="scope__link" href={link('/options/#interior-ranges')}>See interior option price ranges →</a>}
</aside>

<style is:global>
  .scope { margin: 24px 0 0; max-width: 980px; background: #fff; border: 1px solid var(--stone); border-left: 6px solid var(--bronze); padding: 18px 22px; color: var(--steel); }
  .scope--dark { background: rgba(255, 255, 255, 0.04); border-color: rgba(200, 195, 186, 0.35); border-left-color: var(--bronze); color: var(--ivory); }
  .scope__title { margin: 0 0 6px; font-weight: 900; font-size: 1.05rem; }
  .scope__text { margin: 0 0 10px; font-weight: 700; font-size: 0.95rem; line-height: 1.65; }
  .scope--dark .scope__text { color: var(--cashmere); font-weight: 600; }
  .scope__link { color: var(--bronze-dark); font-weight: 900; text-decoration: none; }
  .scope--dark .scope__link { color: var(--bronze); }
</style>
