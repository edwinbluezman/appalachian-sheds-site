mode.addEventListener('change',draw);size.addEventListener('change',draw);siding.addEventListener('change',draw);document.querySelectorAll('.config-card').forEach(b=>b.addEventListener('click',()=>{mode.value=b.dataset.mode;draw();document.getElementById('calculator').scrollIntoView({behavior:'smooth'})}));document.querySelectorAll('.size-card').forEach(b=>b.addEventListener('click',()=>{mode.value='attached';size.value=b.dataset.size;draw();document.getElementById('calculator').scrollIntoView({behavior:'smooth'})}));
