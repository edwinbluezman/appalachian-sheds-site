/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width:1100px) {

  #asi-siding-master .sm-intro,
  #asi-siding-master .sm-trim-top {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-grid {
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }

  #asi-siding-master .sm-trim-benefits {
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }

  #asi-siding-master .sm-trim-benefit:nth-child(3) {
    border-left:0 !important;
    border-top:1px solid var(--sm-stone) !important;
  }

  #asi-siding-master .sm-trim-benefit:nth-child(4) {
    border-top:1px solid var(--sm-stone) !important;
  }

  #asi-siding-master .sm-guide-grid {
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  }

}

@media (max-width:782px) {

  #asi-siding-master .sm-shell {
    padding:50px 18px 58px !important;
  }

  #asi-siding-master .sm-head {
    margin-bottom:34px !important;
  }

  #asi-siding-master .sm-intro-copy,
  #asi-siding-master .sm-intro-side,
  #asi-siding-master .sm-wall-inner,
  #asi-siding-master .sm-trim-copy,
  #asi-siding-master .sm-trim-side,
  #asi-siding-master .sm-footer-copy,
  #asi-siding-master .sm-footer-side {
    padding:27px 22px !important;
  }

  #asi-siding-master .sm-grid {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-wall-grid {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-trim-benefits {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-trim-benefit + .sm-trim-benefit {
    border-left:0 !important;
    border-top:1px solid var(--sm-stone) !important;
  }

  #asi-siding-master .sm-guide-grid {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-footer {
    grid-template-columns:1fr !important;
  }

  #asi-siding-master .sm-footer-side {
    border-left:0 !important;
    border-top:1px solid rgba(166,138,106,.34) !important;
  }

}

@media (prefers-reduced-motion:reduce) {

  #asi-siding-master * {
    transition:none !important;
    scroll-behavior:auto !important;
