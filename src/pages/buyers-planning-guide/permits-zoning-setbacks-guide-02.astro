const page = {
  n: '02',
  subtitle: 'Know the Rules Before You Choose the Location',
  description: 'Permits, zoning, setbacks, easements and HOA rules for a backyard building: the three approval layers, common triggers, questions to ask and what to gather before contacting any office.',
  intro: 'A backyard building can be well designed and still be delayed when permits, zoning, setbacks, easements, utilities or private restrictions are considered too late. Approval planning starts with the exact property address, the intended use and the proposed location.',
  question: 'Do You Need a Permit, Zoning Approval or HOA Approval for a Backyard Building?',
  answer: [
    'Possibly. Requirements vary by exact property, jurisdiction, building size, height, placement, foundation, utilities, intended use, setbacks, easements, drainage, HOA rules, deed restrictions and subdivision standards. A rule that applies in one Ohio city may not apply in a Kentucky county, an Indiana township or a private HOA community.',
    'Building approval, zoning approval and private approval are separate questions, and satisfying one does not satisfy the others.',
    'Appalachian Sheds helps organize the planning conversation, but final public and private requirements are confirmed for your property with the local authority, HOA, architectural review body or governing documents.',
  ],
  sections: [
    {
      type: 'cards', id: 'layers', eyebrow: 'Three Approval Layers', title: 'Building, Zoning and Private Approval Are Not the Same Thing', nav: 'Approval Layers',
