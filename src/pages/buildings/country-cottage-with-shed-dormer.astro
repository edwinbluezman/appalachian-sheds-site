<script is:inline>

(()=>{'use strict';
const sizes=["8×8", "8×10", "8×12", "10×10", "10×12", "10×14", "10×16", "10×18", "10×20", "12×12", "12×14", "12×16", "12×18", "12×20", "12×24", "14×20", "14×24", "16×20", "16×24", "16×30", "16×32"], prices=[[8303, 8967, 9216, 10171, 10296], [8743, 9442, 9705, 10710, 10841], [9184, 9919, 10194, 11250, 11388], [9604, 10372, 10660, 11765, 11909], [10119, 10929, 11232, 12396, 12548], [10760, 11621, 11944, 13181, 13342], [11480, 12398, 12743, 14063, 14235], [12348, 13336, 13706, 15126, 15312], [12861, 13890, 14276, 15755, 15948], [10873, 11743, 12069, 13319, 13483], [11631, 12561, 12910, 14248, 14422], [12389, 13380, 13752, 15177, 15362], [13695, 14791, 15201, 16776, 16982], [14821, 16007, 16451, 18156, 18378], [16601, 17929, 18427, 20336, 20585], [16843, 18190, 18696, 20633, 20885], [18764, 20265, 20828, 22986, 23267], [18294, 19758, 20306, 22410, 22685], [20524, 22166, 22782, 25142, 25450], [23695, 25591, 26301, 29026, 29382], [25842, 27909, 28685, 31656, 32044]], sidings=["Roseburg DuraTemp wood siding", "LP SmartSide Vertical Textured Panel siding", "LP SmartSide Board & Batten siding", "LP SmartSide Textured Lap siding", "GP Forest Ridge Vinyl Lap siding"];
const sizeSelect=document.querySelector('#buildingSize'), sidingSelect=document.querySelector('#sidingChoice'), chosen=document.querySelector('#selectedName'), money=document.querySelector('#selectedPrice'), tbody=document.querySelector('#comparisonRows');
const fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const pretty=s=>s.split('×').map(x=>x+'′').join(' × ');
sizes.forEach((s,i)=>{let op=document.createElement('option');op.value=i;op.textContent=pretty(s);sizeSelect.append(op)});
sidings.forEach((s,i)=>{let op=document.createElement('option');op.value=i;op.textContent=s+(i===0?' · Included standard':'');sidingSelect.append(op)});
sizeSelect.value='5';sidingSelect.value='0';
function refresh(){const i=Number(sizeSelect.value),j=Number(sidingSelect.value);chosen.textContent=pretty(sizes[i])+' · '+sidings[j];money.textContent=fmt(prices[i][j]);document.querySelectorAll('#comparisonRows tr').forEach((tr,k)=>tr.classList.toggle('active-row',k===i));}
sizes.forEach((s,i)=>{let tr=document.createElement('tr');let th=document.createElement('td');th.textContent=pretty(s);tr.append(th);prices[i].forEach((p,j)=>{let td=document.createElement('td');td.textContent=fmt(p);if(j===0)td.classList.add('base-col');tr.append(td)});tbody.append(tr)});
sizeSelect.addEventListener('change',refresh);sidingSelect.addEventListener('change',refresh);refresh();
const toggle=document.getElementById('tableToggle'),comp=document.getElementById('fullComparison');toggle.addEventListener('click',()=>{const open=comp.hidden;comp.hidden=!open;toggle.setAttribute('aria-expanded',String(open));toggle.textContent=open?'− Hide full comparison table':'+ View all sizes and siding prices';});
let request='';const output=document.getElementById('requestOutput'),copy=document.getElementById('copyRequest'),save=document.getElementById('downloadRequest');
document.getElementById('prepareRequest').addEventListener('click',()=>{const get=id=>document.getElementById(id).value.trim();request=[get('requestType'),'Appalachian Sheds Inc. — The Country Cottage with Shed Dormer','Size: '+pretty(sizes[Number(sizeSelect.value)]),'Siding: '+sidings[Number(sidingSelect.value)],'Published model price: '+fmt(prices[Number(sizeSelect.value)][Number(sidingSelect.value)]),'Standard main roof: 9/12','Name: '+(get('customerName')||'Not provided'),'Contact: '+(get('customerContact')||'Not provided'),'Project city / ZIP: '+(get('customerCity')||'Not provided'),'Project notes: '+(get('customerNote')||'None provided'),'Please confirm site conditions, upgrades, final scope and applicable taxes in the written proposal.'].join('\n');output.hidden=false;output.textContent=request;copy.disabled=false;save.disabled=false;output.scrollIntoView({block:'nearest',behavior:'smooth'});});
copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(request);copy.textContent='Copied';setTimeout(()=>copy.textContent='Copy Summary',2200)}catch(err){const sel=window.getSelection(),r=document.createRange();r.selectNodeContents(output);sel.removeAllRanges();sel.addRange(r);copy.textContent='Select text and copy';}});
save.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([request],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='Country-Cottage-with-Shed-Dormer-Request-Summary.txt';document.body.append(a);a.click();a.remove();URL.revokeObjectURL(url)});
})();

</script>
